// wvc: Characters and text helpers.

;export fn isSpace(c) { c == " " || c == "\t" || c == "\n" || c == "\r" }
;export fn isDigit(c) { c >= "0" && c <= "9" }
;export fn isHexDigit(c) { c(isDigit) || c >= "a" && c <= "f" || c >= "A" && c <= "F" }
;export fn isIdStart(c) { c >= "a" && c <= "z" || c >= "A" && c <= "Z" || c == "_" }
;export fn isIdChar(c) { c(isIdStart) || c(isDigit) }

// JS's \s, used to find whitespace inside a bang token such as '! if'.
;export fn isJsSpace(c) {
    ;if (c == "") { ;return false }
    ;const k is c($code)
    k >= 9 && k <= 13 || k == 32 || k == 0xA0 || k == 0x1680
        || k >= 0x2000 && k <= 0x200A || k == 0x2028 || k == 0x2029
        || k == 0x202F || k == 0x205F || k == 0x3000 || k == 0xFEFF
}

// A signal's '!' must be followed by whitespace, ';', '}', ')' or the end (§2.5).
;export fn isSigTerm(c) { c == "" || c(isSpace) || c == ";" || c == "}}" || c == ")" }

