// wvc: The checker (forked from wahc's checker.wah; spec §5.1, §6, §7.2, §8.2, §12, §13).
//
// - names resolve; no shadowing; no use of a declaration before it in the same function
// - set only on var bindings (or fields/elements of them); functions are not values; call arity
// - enum members exist; enums are not values; matches over members are exhaustive
// - return / break / continue / fail only where they make sense
// - conditional chains used as values end in a plain `anyway { ... }`
// - the entry file ends with ;exit
// - operations that would always panic, by the types of their values (§4.2; "Types" below)
//
// Unlike the earlier phases, the checker reports every error it finds, not just the first.
// A scope is { parent, names }, where names is a mutable array of declarations:
// { kind, name, isVar, isRef, namePos, visibleAt, fnId, arity }. Functions are told
// apart by number (fnId), since records are compared by reference.

;import text from "text.wvt"
;import diag from "diag.wvt"

// The standard library: name -> arity, or "const" for constants.
;const stdlib is [
    { name: "print", arity: 1 }, { name: "write", arity: 1 }, { name: "eprint", arity: 1 },
    { name: "readLine", arity: 0 }, { name: "readKey", arity: 0 },
    { name: "waitKey", arity: 1 }, { name: "terminal", arity: 0 }, { name: "terminalSize", arity: 0 },
    { name: "readFile", arity: 1 }, { name: "writeFile", arity: 2 }, { name: "appendFile", arity: 2 },
    { name: "fileExists", arity: 1 }, { name: "listDir", arity: 1 }, { name: "deleteFile", arity: 1 },
    { name: "args", arity: "const" }, { name: "env", arity: 1 },
    { name: "programPath", arity: "const" }, { name: "run", arity: 2 },
    { name: "length", arity: 1 }, { name: "at", arity: 2 }, { name: "slice", arity: 3 },
    { name: "code", arity: 1 }, { name: "fromCode", arity: 1 }, { name: "split", arity: 2 },
    { name: "join", arity: 2 }, { name: "toString", arity: 1 },
    { name: "toInt", arity: 1 }, { name: "toFloat", arity: 1 },
    { name: "push", arity: 2 }, { name: "pop", arity: 1 }, { name: "same", arity: 2 },
    { name: "sort", arity: 1 }, { name: "sortBy", arity: 2 }, { name: "reverse", arity: 1 },
    { name: "get", arity: 2 }, { name: "has", arity: 2 }, { name: "remove", arity: 2 },
    { name: "keys", arity: 1 }, { name: "values", arity: 1 },
    { name: "typeOf", arity: 1 },
    { name: "fields", arity: 1 },
    { name: "floor", arity: 1 }, { name: "ceil", arity: 1 }, { name: "round", arity: 1 },
    { name: "trunc", arity: 1 }, { name: "toUint32", arity: 1 }, { name: "isNan", arity: 1 },
    { name: "time", arity: 0 }, { name: "elapsed", arity: 0 }, { name: "sleep", arity: 1 },
    { name: "newRandom", arity: 1 }, { name: "random", arity: 2 }, { name: "randomFloat", arity: 1 }
]

// The arity of a stdlib name, "const", or null if there is no such name.
;fn stdSig(name) {
    ;var k is 0
    ;while (k < stdlib($length)) {
        ;if (stdlib[k].name == name) { ;return stdlib[k].arity }
        ;set k += 1
    }
    null
}

// How a declaration or parameter binds its values (§10.4).
;fn modeOf(x) { x.isVar ? "var" : x.isRef ? "ref" : "" }

// A declaration kind as Wavert names it, after "a": " function", "n enum", " module".
;fn kindText(kind) { kind == "fn" ? " function" : kind == "enum" ? "n enum" : " {kind}" }

;fn plural(n) { "{n} argument" + (n == 1 ? "" : "s") }

// Statements after which a block never reaches its end (§7.2).
;const neverCompletes is ["return", "panic", "exit", "fail", "break", "continue"]
// Statements whose onfail handler's value is used (§7.2).
;const onfailValueUsed is ["decl", "set", "return", "panic", "exit"]

// An enum as written: Enum, or module.Enum for an imported one (§4.1, §13.1).
;fn enumText(x) { x.k == "name" ? x.name : "{x.rec.name}.{x.field}" }

// A case value's identity for duplicate detection, and its text in messages (§7.5).
;fn caseKey(v) {
    ;if (v.k == "str") { ;return "str:" + v.parts[0] }
    ;if (v.k == "mem") { ;return "mem:{v.field}.{v.rec(enumText)}" }
    ;if (v.k == "null") { ;return "null" }
    "{v.k}:{v.v}"
}
;fn caseText(v) {
    ;if (v.k == "str") { ;return v.parts[0](text.quote) }
    ;if (v.k == "mem") { ;return "{v.rec(enumText)}.{v.field}" }
    ;if (v.k == "null") { ;return "null" }
    "{v.v}"
}

// Does a function body contain a ;return with a value, outside nested functions?
;fn getsAwayWithValue(ref list) {
    ;var i is 0
    ;while (i < list($length)) {
        ;const s is list[i]
        ;if (s.handler != null && s.handler.body.stmts(getsAwayWithValue)) { ;return true }
        ;if (s.k == "return" && s.e != null) { ;return true }
        ;if ((s.k == "while" || s.k == "for") && s.body.stmts(getsAwayWithValue)) { ;return true }
        ;if (s.k == "expr" && s.e.k == "chain") {
            ;var b is 0
            ;while (b < s.e.branches($length)) {
                ;if (s.e.branches[b].body.stmts(getsAwayWithValue)) { ;return true }
                ;set b += 1
            }
            ;if (s.e.els != null && s.e.els.stmts(getsAwayWithValue)) { ;return true }
        }
        ;if (s.k == "expr" && s.e.k == "match") {
            ;var a is 0
            ;while (a < s.e.cases($length)) {
                ;if (s.e.cases[a].body.stmts(getsAwayWithValue)) { ;return true }
                ;set a += 1
            }
            ;if (s.e.els != null && s.e.els.stmts(getsAwayWithValue)) { ;return true }
        }
        ;set i += 1
    }
    false
}

// The line of pos in chars.
;fn lineIn(chars, pos) {
    ;var line is 1
    ;var k is 0
    ;while (k < pos) {
        ;if (chars[k] == "\n") { ;set line += 1 }
        ;set k += 1
    }
    line
}
;fn lineOf(pos) { (diag.srcChars, pos)(lineIn) }

// ---- Types: what the checker knows about a value ----
//
// Wavert has no static types, but the checker infers what it can, and reports
// what would certainly panic if it ran: "n=" + 1, a missing field of a record
// built in view, indexing a record with a position (§10.8). It only reports
// what it knows, so a program it accepts may still panic.
//
// A type is null when nothing is known. Otherwise it is { t }, where t is int,
// float, boolean, string, null or map; { t: "array", elem } for an array,
// where elem is the type of every element, or null when that is not known: a
// mutable array may have any value pushed into it, so only a frozen one's
// elements are known (§10.4); { t: "record", names, types } for a record
// with exactly the fields names, where types holds what is known of their
// values, or is null when the record may be mutable, since its fields may
// then be set to values of other types (§10.9); { t: "enum", name, id } for a
// member of an enum; or { t: "never" } for code that never completes, such as
// a block ending in ;return.
;const tInt is { t: "int" }
;const tFloat is { t: "float" }
;const tBool is { t: "boolean" }
;const tString is { t: "string" }
;const tNull is { t: "null" }
;const tArray is { t: "array", elem: null }
;const tMap is { t: "map" }
;const tNever is { t: "never" }

;fn recordType(names, types) { { t: "record", names: names, types: types } }

// A frozen array whose elements are all of type elem. The elements of an empty
// one are never anything, so they are not known.
;fn arrayOf(elem) { { t: "array", elem: elem != null && elem.t == "never" ? null : elem } }

// The type of an element of an array of type x, or null.
;fn elemOf(x) { x(known) && x.t == "array" ? x.elem : null }

// The array of type x, as a new frozen array of the same elements, as from $sort.
;fn sameElems(x) { x(known) && x.t == "array" ? x : tArray }

// What the last check found, for typesJson: the declarations of every module,
// and the types of bindings and of what functions return, by "module:position".
;var lastDecls is []
;var lastBindingTypes is [:]
;var lastFnTypes is [:]

// Whether x tells anything about a value.
;fn known(x) { x != null && x.t != "never" }

// A type as the runtime's messages name it: int, record { x, y }, Kind.
;fn typeText(x) {
    ;if (x.t == "enum") { ;return x.name }
    ;if (x.t != "record") { ;return x.t }
    ;if (x.names($length) == 0) { ;return "record {{}}" }
    ;const shown is x.names($length) > 12 ? (x.names, 0, 12)($slice) : x.names
    ;const more is x.names($length) > 12 ? ", ... {x.names($length) - 12} more" : ""
    "record {{ {(shown, ", ")($join)}{more} }}"
}

// What two values could have in common: the type of a value that is one or
// the other, as from the branches of an if.
;fn join(a, b) {
    ;if (a == null || b == null) { ;return null }
    ;if (a.t == "never") { ;return b }
    ;if (b.t == "never") { ;return a }
    ;if (a.t != b.t) { ;return null }
    ;if (a.t == "enum") { ;return a.id == b.id ? a : null }
    ;if (a.t == "array") { ;return (a.elem, b.elem)(join)(arrayOf) }
    ;if (a.t != "record") { ;return a }
    ;if (!(a.names, b.names)($same)) { ;return null }
    ;if (a.types == null || b.types == null) { ;return (a.names, null)(recordType) }
    ;var types is []
    ;for (i, ft in a.types) { ;(types, (ft, b.types[i])(join))($push) }
    (a.names, types)(recordType)
}

// The type of a mutable copy of a value of type x: a record's fields may be
// set, so only their names stay known, and anything may be put in an array.
;fn thaw(x) {
    ;if (!x(known)) { ;return x }
    ;if (x.t == "record") { ;return (x.names, null)(recordType) }
    x.t == "array" ? tArray : x
}

// Whether a value of type x converts to text, as interpolation, $print and
// $toString need (§9.3). If not, a hint for converting it.
;fn noTextHint(x) {
    ;if (!x(known)) { ;return null }
    ;if (x.t == "array") { ;return "join its elements with (xs, \", \")(\$join), or use arrays.toString from \$lib/arrays.wvt" }
    ;if (x.t == "record") { ;return "use records.toString from \$lib/records.wvt, or interpolate its fields" }
    ;if (x.t == "map") { ;return "use maps.toString from \$lib/maps.wvt" }
    null
}

// What the standard library's functions return, where it is always the same type.
;fn stdResult(name, args) {
    match (name) {
        case "length", "code", "floor", "ceil", "round", "trunc", "toUint32", "toInt", "time", "elapsed", "random", "run" { tInt }
        case "toFloat", "randomFloat" { tFloat }
        case "toString", "fromCode", "join", "readLine", "readKey", "readFile", "env" { tString }
        case "same", "has", "isNan", "fileExists" { tBool }
        // The arrays they return are frozen.
        case "split", "fields", "listDir" { tString(arrayOf) }
        case "keys", "values" { tArray }
        case "sort", "sortBy", "reverse" { args[0](sameElems) }
        case "slice" { args[0](known) && (args[0].t == "string" || args[0].t == "array") ? args[0] : null }
        case "at" { args[0](known) && args[0].t == "string" ? tString : args[0](elemOf) }
        case "terminal" { (["input", "output"], null)(recordType) }
        case "terminalSize" { (["width", "height"], null)(recordType) }
        else { null }
    }
}

// What the standard library's functions accept, where anything else panics:
// for each argument in turn, the types it may have, or null for any.
;const stdAccepts is [
    { name: "length", args: [["string", "array", "map"]] },
    { name: "at", args: [["string", "array"], ["int"]] },
    { name: "slice", args: [["string", "array"], ["int"], ["int"]] },
    { name: "code", args: [["string"]] }, { name: "fromCode", args: [["int"]] },
    { name: "split", args: [["string"], ["string"]] }, { name: "join", args: [["array"], ["string"]] },
    { name: "push", args: [["array"], null] }, { name: "pop", args: [["array"]] },
    { name: "sort", args: [["array"]] }, { name: "sortBy", args: [["array"], null] }, { name: "reverse", args: [["array"]] },
    { name: "get", args: [["map"], null] }, { name: "has", args: [["map"], null] }, { name: "remove", args: [["map"], null] },
    { name: "keys", args: [["map"]] }, { name: "values", args: [["map"]] },
    { name: "fields", args: [["record"]] },
    { name: "floor", args: [["int", "float"]] }, { name: "ceil", args: [["int", "float"]] },
    { name: "round", args: [["int", "float"]] }, { name: "trunc", args: [["int", "float"]] },
    { name: "toUint32", args: [["int"]] },
    { name: "readFile", args: [["string"]] }, { name: "fileExists", args: [["string"]] },
    { name: "listDir", args: [["string"]] }, { name: "deleteFile", args: [["string"]] },
    { name: "env", args: [["string"]] }, { name: "run", args: [["string"], ["array"]] },
    { name: "sleep", args: [["int"]] }, { name: "waitKey", args: [["int"]] },
    { name: "newRandom", args: [["int"]] }, { name: "random", args: [null, ["int"]] }
]

// The types that argument i of stdlib function name accepts, or null for any.
;fn stdAccepted(name, i) {
    ;for (entry in stdAccepts) {
        ;if (entry.name == name) { ;return entry.args[i] }
    }
    null
}

// Types as a list in a message: "a string, an array or a map".
;fn typesText(ts) {
    ;var words is []
    ;for (ty in ts) { ;(words, (ty == "int" || ty == "array" ? "an " : "a ") + ty)($push) }
    ;if (words($length) == 1) { ;return words[0] }
    "{((words, 0, -1)($slice), ", ")($join)} or {words[-1]}"
}

// The names that a ;set rebinds anywhere in node, as ;set name to x or
// ;set name += x, added to found. No name is shadowed (§5.1), so a binding
// whose name is not found is never rebound.
;fn rebinds(node, ref found) {
    ;const what is node($typeOf)
    ;if (what == "array") {
        ;for (item in node) { ;(item, found)(rebinds) }
        ;return
    }
    ;if (what != "record") { ;return }
    ;const fields is node($fields)
    ;if ((fields, "k")(text.contains) && node.k == "set" && node.target.k == "name") {
        ;set found[node.target.name] to true
    }
    ;for (f in fields) { ;(node[f], found)(rebinds) }
}

// ---- The types found, as JSON, for editors (wvc --types) ----

;const hexDigits is "0123456789abcdef"

// s as a JSON string.
;fn jsonString(s) {
    ;var parts is ["\""]
    ;for (c in (s, "")($split)) {
        ;const code is c($code)
        ;if (c == "\"" || c == "\\") {
            ;(parts, "\\" + c)($push)
        } else if (code < 32) {
            ;(parts, "\\u00" + (hexDigits, (code / 16)($floor))($at) + (hexDigits, code % 16)($at))($push)
        } else {
            ;(parts, c)($push)
        }
    }
    ;(parts, "\"")($push)
    (parts, "")($join)
}

// A type as an editor shows it: as the messages name it, but with what an
// array holds, when that is known: array of Hand.
;fn typeLabel(x) {
    ;if (x.t == "array" && x.elem != null) { ;return "array of {x.elem(typeLabel)}" }
    x(typeText)
}

// A type as JSON: null when nothing is known, else { text }, and for a record
// fields, each { name, type }, and for an array whose elements are known, elem.
;fn typeJson(x) {
    ;if (x == null) { ;return "null" }
    ;var out is "{{\"text\": {x(typeLabel)(jsonString)}"
    ;if (x.t == "array" && x.elem != null) { ;set out to out + ", \"elem\": {x.elem(typeJson)}" }
    ;if (x.t == "record") {
        ;var fields is []
        ;for (i, n in x.names) {
            ;const ft is x.types == null ? null : x.types[i]
            ;(fields, "{{\"name\": {n(jsonString)}, \"type\": {ft(typeJson)}}}")($push)
        }
        ;set out to out + ", \"fields\": [{(fields, ", ")($join)}]"
    }
    out + "}}"
}

// The types the last check found, as JSON for an editor:
// { files, names }, where files lists each module's file, and names each
// binding, parameter, loop variable and function whose type is known, as
// { file (an index into files), line, col, name, kind, type }. kind is const,
// var, ref, param, loop, onfail or fn; a function's type is what it returns.
;export fn typesJson(modules) {
    // Where each line of each module starts.
    ;var starts is []
    ;for (m in modules) {
        ;var lines is [0]
        ;for (i, c in m.chars) {
            ;if (c == "\n") { ;(lines, i + 1)($push) }
        }
        ;(starts, lines)($push)
    }
    ;var names is []
    ;for (d in lastDecls) {
        ;const key is "{d.mod}:{d.namePos}"
        ;const types is d.kind == "fn" ? lastFnTypes : lastBindingTypes
        ;if (!(types, key)($has)) { ;continue }
        ;const kind is d.kind == "decl" ? (d.isVar ? "var" : d.isRef ? "ref" : "const") : d.kind
        // The line holding the name: the last that starts at or before it.
        ;const ls is starts[d.mod]
        ;var lo is 0
        ;var hi is ls($length) - 1
        ;while (lo < hi) {
            ;const mid is ((lo + hi + 1) / 2)($floor)
            ;if (ls[mid] <= d.namePos) { ;set lo to mid } else { ;set hi to mid - 1 }
        }
        ;(names, "{{\"file\": {d.mod}, \"line\": {lo + 1}, \"col\": {d.namePos - ls[lo] + 1}, \"name\": {d.name(jsonString)}, \"kind\": \"{kind}\", \"type\": {types[key](typeJson)}}}")($push)
    }
    ;var files is []
    ;for (m in modules) { ;(files, m.file(jsonString))($push) }
    "{{\"files\": [{(files, ", ")($join)}],\n\"names\": [\n{(names, ",\n")($join)}\n]}}"
}

// The type of a block without a value: never if it never reaches its end
// (§7.2), else null.
;fn endType(b) {
    ;var last is null
    ;for (s in b.stmts) {
        ;if (s.k != "empty") { ;set last to s }
    }
    ;if (last != null && ((neverCompletes, last.k)(text.contains) || last.k == "expr" && last.e.k == "failWith")) {
        ;return tNever
    }
    null
}

// What a library's top level may contain (§13.1).
;const libraryTop is ["empty", "import", "fn", "decl", "enum", "end"]

// Checks the modules, in initialization order with the entry file last;
// returns the errors (an empty array if there are none), and fills in each
// module's exports and notLibrary. requireExit: the entry-file rule that the
// last statement is ;exit (§13). Without it, as for an editor, the entry file
// may be a program or a library.
;export fn check(modules, requireExit) {
    ;var errors is []
    ;var nextFn is 1
    // The index of the module being checked.
    ;var curMod is 0
    // For the explicit-value check (§7.2): function declarations in order, as
    // { mod, name, namePos, body }, and the first use of each one's value, as
    // { mod, namePos, pos, useMod }, where useMod is the module of the use.
    ;var functions is []
    ;var uses is []
    // Enum declarations, as { mod, name, members }.
    ;var enums is []
    // Types (above), by "module:position of the name": of bindings, parameters
    // and loop variables, and of what functions return. While a function's
    // body is checked, the types its ;return statements give, by function number.
    ;var bindingTypes is [:]
    ;var fnTypes is [:]
    ;var returnTypes is [:]
    // The names that some ;set rebinds in the module being checked.
    ;var rebound is [:]
    // Every declaration, in the order they were declared.
    ;var allDecls is []

    ;fn error(pos, message, hint) { ;(errors, (pos, message, hint)(diag.err))($push) }

    // The type of the binding, parameter or loop variable d, or null.
    ;fn typeOfDecl(d) {
        ;const key is "{d.mod}:{d.namePos}"
        ;if ((bindingTypes, key)($has)) { ;return bindingTypes[key] }
        null
    }
    // Records the type of the binding whose name is at pos in the current module.
    ;fn bindType(pos, ty) {
        ;if (ty != null) { ;set bindingTypes["{curMod}:{pos}"] to ty }
    }

    // The type of a member of the enum d.
    ;fn enumType(d) { { t: "enum", name: d.name, id: "{d.mod}:{d.namePos}" } }

    // A value of type ty, from x, used where text is needed.
    ;fn noText(x, ty) {
        ;const hint is ty(noTextHint)
        ;if (hint != null) { ;(x.pos, "cannot convert {ty(typeText)} to text; convert it explicitly", hint)(error) }
    }

    // A value of type ty, from x, used as a condition.
    ;fn condition(x, ty) {
        ;if (ty(known) && ty.t != "boolean") { ;(x.pos, "a condition must be true or false, got {ty(typeText)}", null)(error) }
    }
    ;fn needBool(op, x, ty) {
        ;if (ty(known) && ty.t != "boolean") { ;(x.pos, "'{op}' requires true or false, got {ty(typeText)}", null)(error) }
    }
    ;fn needInt(op, x, ty) {
        ;if (ty(known) && ty.t != "int") { ;(x.pos, "'{op}' requires integers, got {ty(typeText)}", null)(error) }
    }

    // The type of field name of a value of type rt, reporting a field it
    // cannot have. verb: what is done with the field, "reading" or "setting".
    ;fn fieldOf(rt, name, pos, verb) {
        ;if (!rt(known)) { ;return null }
        ;if (rt.t != "record") {
            ;(pos, "{verb} field '{name}' needs a record, got {rt(typeText)}", null)(error)
            ;return null
        }
        ;for (i, n in rt.names) {
            ;if (n == name) { ;return rt.types == null ? null : rt.types[i] }
        }
        ;(pos, "no field '{name}' in {rt(typeText)}", null)(error)
        null
    }

    // The type of an element of a value of type at, indexed by the expression
    // index of type it (§10.2, §10.8, §10.11).
    ;fn indexed(at, index, it, pos, verb) {
        ;if (!at(known)) { ;return null }
        ;if (at.t == "array") {
            ;if (it(known) && it.t != "int") {
                ;(index.pos, "an index must be an int, got {it(typeText)}", null)(error)
                ;return null
            }
            ;return at.elem
        }
        ;if (at.t == "map") {
            ;if (it(known) && (["float", "null", "array", "map"], it.t)(text.contains)) {
                ;(index.pos, "a map key must be an int, a string, a boolean, an enum member or a record, got {it(typeText)}", null)(error)
            }
            ;return null
        }
        ;if (at.t == "record") {
            ;if (index.k == "str" && index.parts($length) == 1) { ;return (at, index.parts[0], pos, verb)(fieldOf) }
            ;if (it(known) && it.t != "string") {
                ;(index.pos, "a record's field name must be a string, got {it(typeText)}, indexing {at(typeText)}",
                    "a record is indexed by the name of a field; for other keys, such as positions, use a map")(error)
            }
            ;return null
        }
        ;const hint is at.t == "string" ? "use \$at for a string: (s, i)(\$at)" : null
        ;(pos, "indexing needs an array, a map or a record, got {at(typeText)}", hint)(error)
        null
    }

    // The type of a binary operation, reporting operands it cannot be applied to (§11).
