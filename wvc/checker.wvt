// wvc: The checker (forked from wahc's checker.wah; spec §5.1, §6, §7.2, §8.2, §12, §13).
//
// - names resolve; no shadowing; no use of a declaration before it in the same function
// - set only on var bindings (or fields/elements of them); functions are not values; call arity
// - enum members exist; enums are not values; matches over members are exhaustive
// - return / break / continue / fail only where they make sense
// - conditional chains used as values end in a plain `anyway { ... }`
// - the entry file ends with ;exit
//
// Unlike the earlier phases, the checker reports every error it finds, not just the first.
// A scope is { parent, names }, where names is a mutable array of declarations:
// { kind, name, isVar, isRef, namePos, visibleAt, fnId, arity }. Functions are told
// apart by number (fnId), since records are compared by reference.

;import text from "text.wvt"
;import diag from "diag.wvt"

// The standard library: name -> arity, or "const" for constants.
;const stdlib is [
    { name: "print", arity: 1 }, { name: "write", arity: 1 }, { name: "eprint", arity: 1 },
    { name: "readLine", arity: 0 }, { name: "readKey", arity: 0 },
    { name: "readFile", arity: 1 }, { name: "writeFile", arity: 2 }, { name: "appendFile", arity: 2 },
    { name: "fileExists", arity: 1 }, { name: "listDir", arity: 1 }, { name: "deleteFile", arity: 1 },
    { name: "args", arity: "const" }, { name: "env", arity: 1 },
    { name: "programPath", arity: "const" }, { name: "run", arity: 2 },
    { name: "length", arity: 1 }, { name: "at", arity: 2 }, { name: "slice", arity: 3 },
    { name: "code", arity: 1 }, { name: "fromCode", arity: 1 }, { name: "split", arity: 2 },
    { name: "join", arity: 2 }, { name: "toString", arity: 1 },
    { name: "toInt", arity: 1 }, { name: "toFloat", arity: 1 },
    { name: "push", arity: 2 }, { name: "pop", arity: 1 }, { name: "same", arity: 2 },
    { name: "typeOf", arity: 1 },
    { name: "fields", arity: 1 },
    { name: "floor", arity: 1 }, { name: "ceil", arity: 1 }, { name: "round", arity: 1 },
    { name: "trunc", arity: 1 }, { name: "toUint32", arity: 1 }, { name: "isNan", arity: 1 },
    { name: "time", arity: 0 },
    { name: "newRandom", arity: 1 }, { name: "random", arity: 2 }, { name: "randomFloat", arity: 1 }
]

// The arity of a stdlib name, "const", or null if there is no such name.
;fn stdSig(name) {
    ;var k is 0
    ;while (k < stdlib($length)) {
        ;if (stdlib[k].name == name) { ;return stdlib[k].arity }
        ;set k += 1
    }
    null
}

// How a declaration or parameter binds its values (§10.4).
;fn modeOf(x) { x.isVar ? "var" : x.isRef ? "ref" : "" }

// A declaration kind as Wavert names it, after "a": " function", "n enum", " module".
;fn kindText(kind) { kind == "fn" ? " function" : kind == "enum" ? "n enum" : " {kind}" }

;fn plural(n) { "{n} argument" + (n == 1 ? "" : "s") }

// Statements after which a block never reaches its end (§7.2).
;const neverCompletes is ["return", "panic", "exit", "fail", "break", "continue"]
// Statements whose onfail handler's value is used (§7.2).
;const onfailValueUsed is ["decl", "set", "return", "panic", "exit"]

// An enum as written: Enum, or module.Enum for an imported one (§4.1, §13.1).
;fn enumText(x) { x.k == "name" ? x.name : "{x.rec.name}.{x.field}" }

// A case value's identity for duplicate detection, and its text in messages (§7.5).
;fn caseKey(v) {
    ;if (v.k == "str") { ;return "str:" + v.parts[0] }
    ;if (v.k == "mem") { ;return "mem:{v.field}.{v.rec(enumText)}" }
    ;if (v.k == "null") { ;return "null" }
    "{v.k}:{v.v}"
}
;fn caseText(v) {
    ;if (v.k == "str") { ;return v.parts[0](text.quote) }
    ;if (v.k == "mem") { ;return "{v.rec(enumText)}.{v.field}" }
    ;if (v.k == "null") { ;return "null" }
    "{v.v}"
}

// Does a function body contain a ;return with a value, outside nested functions?
;fn getsAwayWithValue(ref list) {
    ;var i is 0
    ;while (i < list($length)) {
        ;const s is list[i]
        ;if (s.handler != null && s.handler.body.stmts(getsAwayWithValue)) { ;return true }
        ;if (s.k == "return" && s.e != null) { ;return true }
        ;if (s.k == "while" && s.body.stmts(getsAwayWithValue)) { ;return true }
        ;if (s.k == "expr" && s.e.k == "chain") {
            ;var b is 0
            ;while (b < s.e.branches($length)) {
                ;if (s.e.branches[b].body.stmts(getsAwayWithValue)) { ;return true }
                ;set b += 1
            }
            ;if (s.e.els != null && s.e.els.stmts(getsAwayWithValue)) { ;return true }
        }
        ;if (s.k == "expr" && s.e.k == "match") {
            ;var a is 0
            ;while (a < s.e.cases($length)) {
                ;if (s.e.cases[a].body.stmts(getsAwayWithValue)) { ;return true }
                ;set a += 1
            }
            ;if (s.e.els != null && s.e.els.stmts(getsAwayWithValue)) { ;return true }
        }
        ;set i += 1
    }
    false
}

// The line of pos in chars.
;fn lineIn(chars, pos) {
    ;var line is 1
    ;var k is 0
    ;while (k < pos) {
        ;if (chars[k] == "\n") { ;set line += 1 }
        ;set k += 1
    }
    line
}
;fn lineOf(pos) { (diag.srcChars, pos)(lineIn) }

// What a library's top level may contain (§13.1).
;const libraryTop is ["empty", "import", "fn", "decl", "enum", "end"]

// Checks the modules, in initialization order with the entry file last;
// returns the errors (an empty array if there are none), and fills in each
// module's exports and notLibrary. requireExit: the entry-file rule that the
// last statement is ;exit (§13).
;export fn check(modules, requireExit) {
    ;var errors is []
    ;var nextFn is 1
    // The index of the module being checked.
    ;var curMod is 0
    // For the explicit-value check (§7.2): function declarations in order, as
    // { mod, name, namePos, body }, and the first use of each one's value, as
    // { mod, namePos, pos, useMod }, where useMod is the module of the use.
    ;var functions is []
    ;var uses is []
    // Enum declarations, as { mod, name, members }.
    ;var enums is []

    ;fn error(pos, message, hint) { ;(errors, (pos, message, hint)(diag.err))($push) }

    // Makes module m the current one, for positions in errors.
    ;fn enter(m) {
        ;set curMod to m
        ;(modules[m].file, modules[m].chars)(diag.setSource)
    }

    // The members of the enum that d declares, as { name, pos }.
    ;fn enumMembers(d) {
        ;var k is 0
        ;while (k < enums($length)) {
            ;if (enums[k].mod == d.mod && enums[k].name == d.name) { ;return enums[k].members }
            ;set k += 1
        }
        null
    }

    // The first use of the value of the function declared at declPos in module mod, or null.
    ;fn firstUse(mod, declPos) {
        ;var k is 0
        ;while (k < uses($length)) {
            ;if (uses[k].mod == mod && uses[k].namePos == declPos) { ;return uses[k] }
            ;set k += 1
        }
        null
    }

    // A block whose value is used must end with one, unless it never completes (§7.2).
    ;fn requireValue(b) {
        ;if (b.value != null) { ;return }
        ;var last is null
        ;var k is 0
        ;while (k < b.stmts($length)) {
            ;if (b.stmts[k].k != "empty") { ;set last to b.stmts[k] }
            ;set k += 1
        }
        ;if (last != null && ((neverCompletes, last.k)(text.contains) || last.k == "expr" && last.e.k == "failWith")) {
            ;return
        }
        ;(b.close, "this block's value is used, but it does not produce one",
            "end the block with its value, or with null if that is intended")(error)
    }

    ;fn newScope(parent) {
        ;var names is []
        { parent: parent, names: names }
    }

    // A declaration in the current module, mod. A module name's declaration
    // (kind "module") has lib, the imported module's index; lib is null
    // otherwise, and for a module whose import was in error, so that its uses
    // are not reported again.
    // mode: "var", "ref" or "", how a binding binds its values (§10.4).
    ;fn decl(kind, name, mode, namePos, visibleAt, fnId, arity) {
        {
            kind: kind, name: name, isVar: mode == "var", isRef: mode == "ref", namePos: namePos, visibleAt: visibleAt, fnId: fnId, arity: arity,
            mod: curMod, lib: null
        }
    }

    // The declaration of name in scope itself, or null.
    ;fn own(ref scope, name) {
        ;var k is 0
        ;while (k < scope.names($length)) {
            ;if (scope.names[k].name == name) { ;return scope.names[k] }
            ;set k += 1
        }
        null
    }

    // Declarations become visible at their position; functions, parameters and onfail
    // codes are visible throughout their scope. A declaration may not reuse a
    // name that is visible from an enclosing scope (§5.1).
    ;fn declare(ref scope, name, d) {
        ;const dup is (scope, name)(own)
        ;if (dup != null) {
            ;(d.namePos, "'{name}' is already declared in this scope (line {dup.namePos(lineOf)})", null)(error)
            ;return
        }
        ;ref s is scope.parent
        ;while (s != null) {
            ;const outer is (s, name)(own)
            ;if (outer != null && (outer.kind != "decl" || outer.namePos < d.namePos)) {
                ;(d.namePos, "'{name}' shadows '{name}' from an enclosing scope (line {outer.namePos(lineOf)})",
                    "Wavert forbids shadowing; choose another name")(error)
                ;break
            }
            ;set s to s.parent
        }
        ;(scope.names, d)($push)
    }

    ;fn lookup(ref scope, name) {
        ;ref s is scope
        ;while (s != null) {
            ;const d is (s, name)(own)
            ;if (d != null) { ;return d }
            ;set s to s.parent
        }
        null
    }

    ;fn resolve(name, pos, scope, ctx) {
        ;const d is (scope, name)(lookup)
        ;if (d == null) {
            ;(pos, "unknown name '{name}'", null)(error)
            ;return null
        }
        // Inside a nested function an outer declaration may be read before it runs; that is
        // checked at runtime (temporal dead zone).
        ;if (d.kind == "decl" && d.fnId == ctx.func.id && pos < d.visibleAt) {
            ;(pos, "'{name}' is used before its declaration (line {d.namePos(lineOf)})", null)(error)
        }
        d
    }

    ;fn block(ref b, scope, ctx) {
        ;var k is 0
        ;while (k < b.stmts($length)) {
            ;const s is b.stmts[k]
            ;if (s.k == "fn") {
                ;const d is ("fn", s.name, "", s.namePos, null, ctx.func.id, s.params($length))(decl)
                ;(scope, s.name, d)(declare)
                ;if ((scope, s.name)(own) == d) {
                    ;(functions, { mod: curMod, name: s.name, namePos: s.namePos, body: s.body })($push)
                }
            } else if (s.k == "enum") {
                ;const d is ("enum", s.name, "", s.namePos, null, ctx.func.id, null)(decl)
                ;(scope, s.name, d)(declare)
                ;if ((scope, s.name)(own) == d) { ;(enums, { mod: curMod, name: s.name, members: s.members })($push) }
            } else if (s.k == "decl") {
                ;(scope, s.name, ("decl", s.name, s(modeOf), s.namePos, s.end, ctx.func.id, null)(decl))(declare)
            }
            ;set k += 1
        }
        ;set k to 0
        ;while (k < b.stmts($length)) {
            ;(b.stmts[k], scope, ctx)(stmt)
            ;set k += 1
        }
        ;if (b.value != null) { ;(b.value, scope, ctx)(expr) }
    }

    ;fn stmt(ref s, scope, ctx) {
        ;const kind is s.k
        ;if (kind == "empty" || kind == "enum" || kind == "import" || kind == "end") { ;return }
        ;if (kind == "fn") {
            ;const func is { id: nextFn, top: false }
            ;set nextFn += 1
            ;const ps is scope(newScope)
            ;var k is 0
            ;while (k < s.params($length)) {
                ;const p is s.params[k]
                ;(ps, p.name, ("param", p.name, p(modeOf), p.pos, null, func.id, null)(decl))(declare)
                ;set k += 1
            }
            ;(s.body, ps(newScope), { func: func, loops: 0 })(block)
            ;return
        }
        ;if (kind == "return") {
            ;if (ctx.func.top) { ;(s.pos, "'return' outside a function", null)(error) }
            ;if (s.e != null) { ;(s.e, scope, ctx)(expr) }
        } else if (kind == "panic") {
            ;(s.e, scope, ctx)(expr)
        } else if (kind == "break" || kind == "continue") {
            ;if (ctx.loops == 0) { ;(s.pos, "'{kind == "break" ? "break" : "continue"}' outside a loop", null)(error) }
            ;return
        } else if (kind == "while") {
            ;(s.cond, scope, ctx)(expr)
            ;(s.body, scope(newScope), { func: ctx.func, loops: ctx.loops + 1 })(block)
            ;return
        } else if (kind == "fail") {
            ;if (ctx.func.top) { ;(s.pos, "'fail' outside a function: there is no caller to fail to", null)(error) }
            ;return
        } else if (kind == "exit") {
            ;if (s.e != null) { ;(s.e, scope, ctx)(expr) }
        } else if (kind == "expr") {
            ;if (s.e.k == "failWith") {
                ;if (ctx.func.top) { ;(s.e.pos, "'fail' outside a function: there is no caller to fail to", null)(error) }
                ;(s.e.arg, scope, ctx)(expr)
            } else if (s.e.k == "chain") {
                ;(s.e, scope, ctx, true)(chain)
            } else if (s.e.k == "match") {
                ;(s.e, scope, ctx, true)(checkMatch)
            } else if (s.e.k == "call") {
                // The whole statement is a call, so its value is discarded.
                ;var k is 0
                ;while (k < s.e.args($length)) {
                    ;(s.e.args[k], scope, ctx)(expr)
                    ;set k += 1
                }
                ;(s.e, scope, false)(callee)
            } else {
                ;(s.e, scope, ctx)(expr)
            }
        } else if (kind == "decl") {
            ;(s.e, scope, ctx)(expr)
        } else if (kind == "set") {
            ;(s.e, scope, ctx)(expr)
            ;(s.target, scope, ctx)(lvalue)
        }
        ;if (s.handler != null) { ;(s, scope, ctx)(onfailHandler) }
    }

    // `onfail` handles the outermost call of its statement (§8.2).
    ;fn onfailHandler(s, scope, ctx) {
        ;const h is s.handler
        ;if (s.e == null || s.e.k != "call") {
            ;(h.pos, "'onfail' handles a call, but this statement's value is not a call",
                "the call must be the outermost expression, e.g. ;const n is s(parse) onfail (c) {{ ... }}")(error)
        }
        ;const hs is scope(newScope)
        ;if (h.param != null) {
            ;(hs, h.param, ("onfail", h.param, "", h.paramPos, null, ctx.func.id, null)(decl))(declare)
        }
        ;(h.body, hs(newScope), ctx)(block)
        ;if ((onfailValueUsed, s.k)(text.contains)) { ;h.body(requireValue) }
    }

    // A multi-way branch (§7.5). The parser has checked that each value is a
    // literal or has the shape Enum.member or module.Enum.member; members
    // are resolved here.
    ;fn checkMatch(e, scope, ctx, stmtLevel) {
        ;(e.subject, scope, ctx)(expr)
        // Alibi values seen so far, as { key, pos }.
        ;var seen is []
        // The sort of the values: "" for literals, else the enum as written
        // (Kind, or module.Kind); null until one is known.
        ;var sort is null
        // The sort's declaration, for an enum.
        ;var sortEnum is null
        ;var a is 0
        ;while (a < e.cases($length)) {
            ;const al is e.cases[a]
            ;var j is 0
            ;while (j < al.values($length)) {
                ;const v is al.values[j]
                ;var vs is ""
                ;if (v.k == "mem") {
                    ;const d is (v, scope)(caseEnum)
                    ;set vs to d != null ? v.rec(enumText) : null
                    ;if (sort == null) { ;set sortEnum to d }
                }
                ;if (sort == null) {
                    ;set sort to vs
                } else if (vs != null && vs != sort) {
                    ;const message is sort == "" || vs == "" ? "a match cannot mix literals and enum members"
                        : "a match cannot mix members of '{sort}' and '{vs}'"
                    ;(v.pos, message, null)(error)
                }
                ;const key is v(caseKey)
                ;var first is null
                ;var q is 0
                ;while (q < seen($length)) {
                    ;if (seen[q].key == key) { ;set first to seen[q].pos }
                    ;set q += 1
                }
                ;if (first != null) {
                    ;(v.pos, "duplicate case value {v(caseText)} (line {first(lineOf)})", null)(error)
                } else {
                    ;(seen, { key: key, pos: v.pos })($push)
                }
                ;set j += 1
            }
            ;(al.body, scope(newScope), ctx)(block)
            ;if (!stmtLevel) { ;al.body(requireValue) }
            ;set a += 1
        }
        ;if (e.els != null) {
            ;(e.els, scope(newScope), ctx)(block)
            ;if (!stmtLevel) { ;e.els(requireValue) }
        } else if (sort != null && sort != "") {
            // Without else, a match over an enum must handle every member.
            ;const ms is sortEnum(enumMembers)
            ;var missing is []
            ;var m is 0
            ;while (m < ms($length)) {
                ;const key is "mem:{ms[m].name}.{sort}"
                ;var handled is false
                ;var q is 0
                ;while (q < seen($length)) {
                    ;if (seen[q].key == key) { ;set handled to true }
                    ;set q += 1
                }
                ;if (!handled) { ;(missing, "'{sort}.{ms[m].name}'")($push) }
                ;set m += 1
            }
            ;if (missing($length) > 0) {
                ;(e.pos, "match does not handle {(missing, ", ")($join)}",
                    "add a case for each, or end the match with 'else {{ ... }}'")(error)
            }
        } else if (!stmtLevel) {
            ;(e.pos, "a match used as a value must end with 'else {{ ... }}'", null)(error)
        }
    }

    // The module declaration that x names, or null.
    ;fn moduleNamed(ref x, scope) {
        ;if (x.k != "name") { ;return null }
        ;const d is (scope, x.name)(lookup)
        d != null && d.kind == "module" ? d : null
    }

    // The declaration that module lib exports as name, or null.
    ;fn exported(lib, name) {
        ;const xs is modules[lib].exports
        ;var k is 0
        ;while (k < xs($length)) {
            ;if (xs[k].name == name) { ;return xs[k] }
            ;set k += 1
        }
        null
    }

    // The enum that x names, written Enum or module.Enum, or null. Reports nothing.
    ;fn enumNamed(ref x, scope) {
        ;if (x.k == "name") {
            ;const d is (scope, x.name)(lookup)
            ;return d != null && d.kind == "enum" ? d : null
        }
        ;if (x.k != "mem") { ;return null }
        ;const m is (x.rec, scope)(moduleNamed)
        ;if (m == null || m.lib == null) { ;return null }
        ;const d is (m.lib, x.field)(exported)
        d != null && d.kind == "enum" ? d : null
    }

    // The declaration that module.name refers to, or null after an error
    // (or when the module's import was already reported).
    ;fn exportOf(e, m) {
        ;if (m.lib == null) { ;return null }
        ;const d is (m.lib, e.field)(exported)
        ;if (d == null) { ;(e.pos, "'{modules[m.lib].path}' does not export '{e.field}'", null)(error) }
        d
    }

    ;fn unknownModule(x, scope) {
        ;const message is (scope, x.name)(lookup) != null ? "'{x.name}' is not a module" : "unknown module '{x.name}'"
        ;(x.pos, message, null)(error)
    }

    // module.name used as a value: an exported declaration (§13.1).
    ;fn qualified(e, m) {
        ;const d is (e, m)(exportOf)
        ;const label is "{e.rec.name}.{e.field}"
        ;if (d != null && d.kind == "fn") {
            ;(e.pos, "'{label}' is a function; functions are not values", "to call it, write x({label}), or ({label}) with no arguments")(error)
        } else if (d != null && d.kind == "enum") {
            ;(e.pos, "'{label}' is an enum, not a value", "its members are written {label}.member")(error)
        }
    }

    // The enum that a case value Enum.member or module.Enum.member
    // belongs to, or null after an error.
    ;fn caseEnum(v, scope) {
        ;const x is v.rec
        ;const d is (x, scope)(enumNamed)
        ;if (d != null) {
            ;(v, d)(member)
            ;return d
        }
        ;const hint is "case values are literals or enum members (Enum.member)"
        ;if (x.k == "name") {
            ;const message is (scope, x.name)(lookup) != null ? "'{x.name}' is not an enum" : "unknown enum '{x.name}'"
            ;(x.pos, message, hint)(error)
            ;return null
        }
        ;const m is (x.rec, scope)(moduleNamed)
        ;if (m == null) {
            ;(x.rec, scope)(unknownModule)
        } else if ((x, m)(exportOf) != null) {
            ;(x.pos, "'{x(enumText)}' is not an enum", hint)(error)
        }
        null
    }

    // Name.member, where Name is an enum (§4.1).
    ;fn member(e, d) {
        ;const ms is d(enumMembers)
        ;var names is []
        ;var found is false
        ;var k is 0
        ;while (k < ms($length)) {
            ;(names, ms[k].name)($push)
            ;if (ms[k].name == e.field) { ;set found to true }
            ;set k += 1
        }
        ;if (!found) {
            ;(e.pos, "no member '{e.field}' in enum '{d.name}'", "its members are {(names, ", ")($join)}")(error)
        }
    }

    ;fn chain(e, scope, ctx, stmtLevel) {
        ;var k is 0
        ;while (k < e.branches($length)) {
            ;const b is e.branches[k]
            ;(b.cond, scope, ctx)(expr)
            ;(b.body, scope(newScope), ctx)(block)
            ;if (!stmtLevel) { ;b.body(requireValue) }
            ;set k += 1
        }
        ;if (e.els != null) {
            ;(e.els, scope(newScope), ctx)(block)
            ;if (!stmtLevel) { ;e.els(requireValue) }
        } else if (!stmtLevel) {
            ;(e.pos, "a conditional used as a value must end with a plain 'else {{ ... }}'", null)(error)
        }
    }

    ;fn lvalue(ref t, scope, ctx) {
        ;if (t.k == "name") {
            ;const d is (t.name, t.pos, scope, ctx)(resolve)
            ;if (d != null) {
                ;(d, t.name, t.pos, "cannot set '{t.name}': it is not a var or ref", true)(mustBeMutable)
                // The code generator binds the new value by the target's column of the copy table (§10.4).
                ;if (d.isRef) { ;(modules[curMod].refTargets, t.pos)($push) }
            }
            ;return
        }
        // The container that directly holds the target must be mutable (§10.9);
        // nested containers are checked at runtime.
        ;const isMem is t.k == "mem"
        ;const box is isMem ? t.rec : t.arr
        ;const what is isMem ? "a field" : "an element"
        ;if (t.k == "idx") { ;(t.index, scope, ctx)(expr) }
        ;if (isMem) {
            ;if ((box, scope)(enumNamed) != null) {
                ;(t.pos, "cannot set '{box(enumText)}.{t.field}': enum members are constants", null)(error)
                ;return
            }
