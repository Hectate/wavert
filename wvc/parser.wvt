                ;set k += 1
            }
            ;(members, { name: m.v, pos: m.pos })($push)
            ;if (","(accept) == null) { ;break }
        }
        ;(")", "expected ',' or ')' in the member list", null)(expect)
        {
            k: "lineup", name: name.v, namePos: name.pos, members: members,
            pos: null, end: null, handler: null
        }
    }

    ;fn cond(kw) {
        ;("(", "expected '(' after '{kw}'", "conditions are parenthesized: {kw} (x) {{ ... }}")(expect)
        ;const e is (expr)
