        }
        ;var members is []
        ;while (true) {
            ;const m is (peek)
            ;if (m.t != "id") {
                ;const message is (lexer.keywords, m.t)(text.contains) ? "'{m.t}' is a keyword and cannot be a member name"
                    : "expected a member name, found {m(describe)}"
                ;(m, message)(failAt)
            }
            ;(next)
            ;var k is 0
            ;while (k < members($length)) {
