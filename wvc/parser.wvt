            ;(next)
            ;return {
                k: "lurk", neg: kind == "!while", cond: kind(cond), body: (block),
                pos: null, end: null, handler: null
            }
        }
        ;if (kind == "fail") { ;return (failStatement) }
        ;if (kind == "exit") {
