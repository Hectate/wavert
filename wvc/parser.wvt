        }
        ;if (kind == "onfail") { ;(tk, "'onfail' must follow a statement whose value comes from a call")(failAt) }
        ;if (kind == "else") { ;(tk, "'else' without a preceding if or !if")(failAt) }
        ;if (kind == "case") { ;(tk, "'case' outside a match")(failAt) }
        ;const e is (expr)
        ;if ("opset"(at) || "to"(atWord) && (e.k == "name" || e.k == "idx" || e.k == "mem")) {
            ;(tk, "an assignment starts with 'set'", ";set x to value")(failAtHint)
        }
        ;if (!e(hasEffect)) {
            ;const hint is depth > 0 ? "to make it the block's value, remove the ';' before it" : null
            ;(diag.warnings, (tk.pos, "this statement has no effect", hint)(diag.warn))($push)
        }
        ("expr", e)(simpleStatement)
    }

    // ;const name is value, ;var name is value, ;ref name is value (§5).
    ;fn declaration() {
        ;const kw is (next)
        ;const name is ("id", "expected a name after '{kw.t}'", ";{kw.t} name is value")(expect)
        ;("is", ";{kw.t} {name.v} is value")(expectWord)
        ;const e is (expr)
        {
            k: "claim", e: e, isShifty: kw.t == "var", isFickle: kw.t == "ref", name: name.v, namePos: name.pos,
            pos: null, end: null, handler: null
        }
    }

    // ;set target to value, or ;set target op= value.
    ;fn setStatement() {
        ;(next)
        ;const target is (lvalue)
        ;if ("to"(atWord)) {
            ;(next)
            ;return { k: "cheat", e: (expr), op: null, target: target, pos: null, end: null, handler: null }
        }
        ;if ("opset"(at)) {
            ;const op is (next)
            ;return { k: "cheat", e: (expr), op: op.v, target: target, pos: null, end: null, handler: null }
        }
        ;const found is (peek)
        ;(found, "expected 'to' or a compound assignment such as '+=' after the target, found {found(describe)}",
            ";set x to value")(failAtHint)
    }

    // ;fail, ;fail 3 (a code), or ;fail c (a computed code) (§8.2).
    ;fn failStatement() {
        ;const kw is (next)
        ;if (!(exprStart, (peek).t)(text.contains)) {
            ;return { k: "signal", code: 1, pos: null, end: null, handler: null }
        }
        ;const first is (peek)
        ;const e is (expr)
        ;if (e.k == "float" || e.k == "int" && e.v < 1) {
            ;(first, "a fail code must be an integer >= 1")(failAt)
        }
        ;if (e.k == "int") {
            ;return { k: "signal", code: e.v, pos: null, end: null, handler: null }
        }
        ("expr", { k: "sigcall", arg: e, pos: kw.pos, paren: false })(simpleStatement)
    }

    // ;import name from "path.wvt" (§13.1). The path is a plain string literal.
    ;fn importStatement() {
        ;const kw is (next)
        ;if (depth > 0) { ;(kw, "'import' is only allowed at the top level of a file")(failAt) }
        ;const name is ("id", "expected a name for the module after 'import'", ";import lib from \"lib.wvt\"")(expect)
        ;("from", ";import {name.v} from \"{name.v}.wvt\"")(expectWord)
        ;const e is (peek)
        ;if (e.t != "str" || e.parts($length) != 1) {
            ;(e, "an import path must be a plain string literal", ";import lib from \"lib.wvt\"")(failAtHint)
        }
        ;(next)
        ;const path is e.parts[0]
        ;if (((path, "")($split), "\\")(text.contains)) { ;(e, "import paths use '/' as the separator")(failAt) }
        ;if (!(path($length) >= 4 && (path, -4, path($length))($slice) == ".wvt")) {
            ;(e, "an import path includes the .wvt extension")(failAt)
        }
        { k: "steal", path: path, pathPos: e.pos, name: name.v, namePos: name.pos, pos: null, end: null, handler: null }
    }

    // ;export before a top-level declaration (§13.1).
    ;fn exportStatement() {
        ;const kw is (next)
        ;if (depth > 0) { ;(kw, "only top-level declarations can be exported")(failAt) }
        ;const tk is (peek)
        ;if (!(exportable, tk.t)(text.contains)) {
            ;(tk, "only fn, const, var, ref and enum declarations can be exported, found {tk(describe)}")(failAt)
        }
        ;const s is tk(statementBody)
        ;if (firstExport == null) { ;set firstExport to kw }
        ;(exports, { name: s.name, pos: s.namePos })($push)
        s
    }

    // ;end, the last statement of a library: a bribe of what it exports.
    ;fn endStatement() {
        ;const kw is (next)
        ;if (depth > 0) { ;(kw, "';end' is only allowed at the top level of a library")(failAt) }
        ;if (exports($length) == 0) {
            ;(kw, "a library must export at least one declaration", "mark one with 'export', e.g. ;export fn name(x) {{ ... }}")(failAtHint)
        }
        { k: "bribe", names: exports, pos: null, end: null, handler: null }
    }

    // ;fn name(a, var b, ref c) { ... } (§6.1).
    ;fn fnStatement() {
        ;(next)
        ;if ("("(at)) {
            ;((peek), "the name comes before the parameters", ";fn name(a, b) {{ ... }}")(failAtHint)
        }
        ;const name is ("id", "expected the function name after 'fn'", ";fn name(a, b) {{ ... }}")(expect)
        ;("(", "expected '(' to open the parameter list", ";fn {name.v}(a, b) {{ ... }}")(expect)
        ;var params is []
        ;if (!")"(at)) {
            ;while (true) {
                ;const isShifty is "var"(accept) != null
                ;const isFickle is !isShifty && ("ref"(accept) != null)
                ;const pname is ("id", "expected a parameter name", "a parameter is a name, var name or ref name")(expect)
                ;(params, { name: pname.v, isShifty: isShifty, isFickle: isFickle, pos: pname.pos })($push)
                ;if (","(accept) == null) { ;break }
            }
        }
        ;(")", "expected ')' to close the parameter list", null)(expect)
        {
            k: "scheme", name: name.v, namePos: name.pos, params: params, body: (block),
            pos: null, end: null, handler: null
        }
    }

    // ;enum Name (member, ...) (§4.1), only at the top level.
    ;fn enumStatement() {
        ;const kw is (next)
        ;if (depth > 0) { ;(kw, "an enum can only be declared at the top level")(failAt) }
        ;if ("("(at)) {
