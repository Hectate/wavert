// wvc: The Wavert parser (docs/hybrid-syntax.md; rewritten from wahc's parser.wah).
//
// Statements begin with ';'. Expressions use precedence climbing. Postfix
// calls `x(f)`, indexing `xs[i]` and member access `rec.field` bind tightest.
// Several arguments are grouped before the call, `(a, b)(f)`, and `(f)` or
// `(module.f)` where an expression starts is a call with no arguments.
//
// The syntax tree is wahc's, so the checker and the code generators are
// shared with it, and its node kinds keep wahc's Γ-- names:
// Expression nodes (k): int float str bool null nan inf name std arr rec idx mem
//   un bin tern call sigcall chain suspect. Each has pos and paren (true when parenthesized).
// Statement nodes (k): empty scheme lineup steal bribe getaway tantrum bail loiter
//   lurk signal exit expr claim cheat. Each has pos, end and handler: null, or the statement's
//   onfail handler as { pos, param, paramPos, body }.
// Wavert words map onto them: fn is a scheme, enum a lineup, import a steal,
// const/var/ref a claim (isShifty for var, isFickle for ref), set a cheat,
// return a getaway, panic a tantrum, break and continue are bail and loiter,
// while is lurk, if and !if are a chain, match/case a suspect with alibis,
// fail a signal (or a sigcall statement), and exit is exit. The export
// modifiers are collected into the bribe statement that ;end becomes.

;import text from "text.wvt"
;import diag from "diag.wvt"
;import lexer from "lexer.wvt"

;const exprStart is ["int", "float", "str", "true", "false", "null", "nan", "inf", "id", "std",
  "(", "[", "{{", "if", "!if", "match", "-", "!", "~"]
;const whineOk is ["expr", "claim", "cheat", "getaway", "tantrum", "exit"]
;const callees is ["id", "std"]
;const exportable is ["fn", "const", "var", "ref", "enum"]

// Binding power of a binary operator, or wh if t is not one.
;fn precedence(t) {
    ;if (t == "||") { ;return 1 }
    ;if (t == "&&") { ;return 2 }
    ;if (t == "==" || t == "!=") { ;return 3 }
    ;if (t == "<" || t == ">" || t == "<=" || t == ">=") { ;return 4 }
    ;if (t == "|") { ;return 5 }
    ;if (t == "^") { ;return 6 }
    ;if (t == "&") { ;return 7 }
    ;if (t == "<<" || t == ">>") { ;return 8 }
    ;if (t == "+" || t == "-") { ;return 9 }
    ;if (t == "*" || t == "/" || t == "%") { ;return 10 }
    0
}

;fn isIdent(s) {
    ;const cs is (s, "")($split)
    ;if (cs($length) == 0 || !cs[0](text.isIdStart)) { ;return false }
    ;var k is 1
    ;while (k < cs($length)) {
        ;if (!cs[k](text.isIdChar)) { ;return false }
        ;set k += 1
    }
    true
}

;fn describe(tk) {
    ;if (tk.t == "eof") { ;return "end of input" }
    ;if (tk.t == "id") { ;return "'{tk.v}'" }
    ;if (tk.t == "std") { ;return "'\${tk.v}'" }
    ;if (tk.t == "int" || tk.t == "float") { ;return "'{tk.text}'" }
    ;if (tk.t == "str") { ;return "a string" }
    ;if (tk.t == "opset") { ;return "'{tk.v}='" }
    "'{tk.t}'"
}

;fn failAtHint(tk, message, hint) { ;(tk.pos, message, hint)(diag.failHint) }
;fn failAt(tk, message) { ;(tk.pos, message, null)(diag.failHint) }

;fn simpleStatement(k, e) { { k: k, e: e, pos: null, end: null, handler: null } }

;export fn parse(ref toks) { (toks, false)(parser) }

// Does evaluating e call anything? An expression statement that does not has no effect (§2.8).
// Conditional chains count as having an effect.
;fn hasEffect(e) {
    ;const kind is e.k
    ;if (kind == "call" || kind == "sigcall" || kind == "chain" || kind == "suspect") { ;return true }
    ;if (kind == "str") {
        ;var i is 0
        ;while (i < e.parts($length)) {
            ;if (e.parts[i]($typeOf) != "string" && e.parts[i](hasEffect)) { ;return true }
            ;set i += 1
        }
        ;return false
    }
    ;if (kind == "arr") {
        ;var i is 0
        ;while (i < e.items($length)) {
            ;if (e.items[i](hasEffect)) { ;return true }
            ;set i += 1
        }
        ;return false
    }
    ;if (kind == "rec") {
        ;var i is 0
        ;while (i < e.fields($length)) {
            ;if (e.fields[i].e(hasEffect)) { ;return true }
            ;set i += 1
        }
        ;return false
    }
    ;if (kind == "idx") { ;return e.index(hasEffect) || e.arr(hasEffect) }
    ;if (kind == "mem") { ;return e.rec(hasEffect) }
    ;if (kind == "un") { ;return e.e(hasEffect) }
    ;if (kind == "bin") { ;return e.l(hasEffect) || e.r(hasEffect) }
    ;if (kind == "tern") { ;return e.c(hasEffect) || e.a(hasEffect) || e.b(hasEffect) }
    false
}

// Parses toks as a program, or as the expression of a string interpolation when inner is real.
;fn parser(ref toks, inner) {
    ;var p is 0
    // Blocks entered; hints about block values apply only inside one.
    ;var depth is 0
    // The declarations marked export, as { name, pos }, for the bribe that ;end becomes.
    ;var exports is []
    ;var firstExport is null

    ;fn peek() { toks[p] }
    ;fn at(type) { toks[p].t == type }
    // Is the token at p the contextual keyword word (is, to, from, end)?
    ;fn atWord(word) { toks[p].t == "id" && toks[p].v == word }
    // A call is exactly `(name)`, `($name)` or `(module.name)`. After an
    // expression it calls the function with that expression; where an
    // expression starts, it calls it with no arguments. Any other '(' after an
    // expression ends the expression.
    ;fn atCall() {
        ;if (p + 2 >= toks($length) || toks[p].t != "(") { ;return false }
        ;if (toks[p + 2].t == ")" && (callees, toks[p + 1].t)(text.contains)) { ;return true }
        // (module.name): a function a module exports (§13.1)
        p + 4 < toks($length) && toks[p + 1].t == "id" && toks[p + 2].t == "."
            && toks[p + 3].t == "id" && toks[p + 4].t == ")"
    }
    ;fn next() {
        ;const tk is toks[p]
        ;if (tk.t != "eof") { ;set p += 1 }
        tk
    }
    ;fn accept(type) { type(at) ? (next) : null }
    // msg null means "expected '<type>'".
    ;fn expect(type, msg, hint) {
        ;if (type(at)) { ;return (next) }
        ;const found is (peek)
        ;const m is msg == null ? "expected '{type}'" : msg
        ;(found, "{m}, found {found(describe)}", hint)(failAtHint)
    }
    // Expects the contextual keyword word.
    ;fn expectWord(word, hint) {
        ;if (word(atWord)) { ;return (next) }
        ;const found is (peek)
        ;(found, "expected '{word}', found {found(describe)}", hint)(failAtHint)
    }
    ;fn lintSpace(op) {
        ;if (!op.sp || !(peek).sp) {
            ;(diag.warnings, (op.pos, "missing whitespace around '{op.t}'", null)(diag.warn))($push)
        }
    }

    // ---- statements ----

    ;fn program() {
        ;var stmts is []
        // Has a statement other than import or empty been seen?
        ;var started is false
        // The ;end statement, once seen.
        ;var ended is null
        ;while (!"eof"(at)) {
            ;if (!";"(at)) {
                ;const tk is (peek)
                ;const hint is "("(at) ? "calls are postfix: write the arguments first, then the function, e.g. (a, b)(f)"
                    : "every Wavert statement begins with ;"
                ;(tk, "expected ';' to start a statement, found {tk(describe)}", hint)(failAtHint)
            }
            ;const s is (statement)
            ;if (ended != null && s.k != "empty") {
                ;(ended, "';end' must be the last statement of a library")(failAt)
            }
            ;if (s.k == "steal" && started) { ;(s.pos, "'import' must come before every other statement")(diag.abort) }
            ;if (s.k != "steal" && s.k != "empty") { ;set started to true }
            ;if (s.k == "bribe") { ;set ended to { pos: s.pos } }
            ;(stmts, s)($push)
        }
        ;if (firstExport != null && ended == null) {
            ;(firstExport, "'export' is only allowed in a library, which ends with ;end")(failAt)
        }
        { stmts: stmts, end: (peek).pos }
    }

    ;fn statement() {
        ;const semi is (next)
        ;const tk is (peek)
        ;if (tk.t == ";" || tk.t == "}}" || tk.t == "eof") {
            ;return { k: "empty", pos: semi.pos, end: tk.pos, handler: null }
        }
        ;var s is tk(statementBody)
        ;set s.pos to tk.pos
        ;if ("onfail"(at)) {
            ;const w is (next)
            ;if (!(whineOk, s.k)(text.contains)) {
                ;(w, "'onfail' must follow a statement whose value comes from a call")(failAt)
            }
            ;var param is null
            ;if ("("(accept) != null) {
                ;set param to ("id", "expected a name for the fail code", null)(expect)
                ;(")", null, null)(expect)
            }
            ;const noParam is param == null
            ;set s.handler to {
                pos: w.pos,
                param: noParam ? null : param.v,
                paramPos: noParam ? null : param.pos,
                body: (block)
            }
        }
        ;set s.end to (peek).pos
        s
    }

    // The statement starting at tk, without its pos, end and handler.
    ;fn statementBody(tk) {
        ;const kind is tk.t
        ;if (kind == "fn") { ;return (fnStatement) }
        ;if (kind == "enum") { ;return (enumStatement) }
        ;if (kind == "import") { ;return (importStatement) }
        ;if (kind == "export") { ;return (exportStatement) }
        ;if (kind == "const" || kind == "var" || kind == "ref") { ;return (declaration) }
        ;if (kind == "set") { ;return (setStatement) }
        ;if (kind == "return") {
            ;(next)
            ;const e is (exprStart, (peek).t)(text.contains) ? (expr) : null
            ;return ("getaway", e)(simpleStatement)
        }
        ;if (kind == "panic") {
            ;(next)
            ;return ("tantrum", (expr))(simpleStatement)
        }
        ;if (kind == "break" || kind == "continue") {
            ;(next)
            ;return { k: kind == "break" ? "bail" : "loiter", pos: null, end: null, handler: null }
        }
