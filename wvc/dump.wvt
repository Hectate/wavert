        ;const tk is toks[k]
        ;var line is "{indent}{tk.t} {tk.pos} {tk.end} {tk.sp}"
        ;if (tk.t == "id" || tk.t == "std" || tk.t == "opset") {
            ;set line to line + " {tk.v}"
        } else if (tk.t == "int" || tk.t == "float") {
            ;set line to line + " {tk.text} {tk.v}"
        }
        ;line($print)
        ;if (tk.t == "str") {
            ;var p is 0
            ;while (p < tk.parts($length)) {
                ;const part is tk.parts[p]
