// wvc: The JavaScript code generator, for --target js (forked from wahc's codegen.wah).
//
// User names are emitted as w_<name>; stdlib names as $std.<name>; record
// fields as f_<name>; every operator goes through a $rt helper that enforces
// the typing rules. Library k (in initialization order) uses w<k>_<name>, so
// private names in different modules never collide (§13.1).

;import text from "text.wvt"
;import diag from "diag.wvt"

;const binOps is ["+", "-", "*", "/", "%", "**", "==", "!=", "<", ">", "<=", ">=", "&", "|", "^", "<<", ">>"]
;const binFns is ["add", "sub", "mul", "div", "mod", "pow", "eq", "ne", "lt", "gt", "le", "ge", "band", "bor", "bxor", "shl", "shr"]
// Node kinds whose value can never be an array (so binding needs no copy check).
;const scalarKinds is ["int", "float", "str", "bool", "null", "nan", "inf", "bin", "un"]
// Node kinds that evaluate without calling anything.
;const plainKinds is ["int", "float", "bool", "null", "nan", "inf", "name", "std"]

;fn binFn(op) {
    ;var k is 0
    ;while (binOps[k] != op) { ;set k += 1 }
    binFns[k]
}
// How a declaration or parameter binds its values (§10.4): "var", "ref" or "const".
;fn modeOf(x) { x.isVar ? "var" : x.isRef ? "ref" : "const" }

;fn unFn(op) { op == "-" ? "neg" : op == "!" ? "not" : "bnot" }
;fn jsBool(b) { b ? "true" : "false" }

;fn repeat(s, count) {
    ;var out is ""
    ;var k is 0
    ;while (k < count) {
        ;set out to out + s
        ;set k += 1
    }
    out
}

// A float literal as JS prints it: float text without the ".0" Wavert adds (1.0 -> 1, 1.0e+21 -> 1e+21).
;fn jsFloat(x) {
    ;const cs is (x($toString), "")($split)
    ;const len is cs($length)
    ;var out is ""
    ;var k is 0
    ;while (k < len) {
        ;if (cs[k] == "." && cs[k + 1] == "0" && (k + 2 == len || cs[k + 2] == "e")) {
            ;set k += 2
            ;continue
        }
        ;set out to out + cs[k]
        ;set k += 1
    }
    out
}

// modules: checked, in initialization order, the entry file last. Libraries
// run first, in that order, then the entry file's body (§13.1).
;export fn generate(modules, runtime) {
    ;var out is []
    ;var indent is 1
    ;var n is 0
    // loops: enclosing loops reachable by break/continue; iife: inside an expression-valued conditional
    ;var loops is 0
    ;var iife is false

    // The current module's id, its module names as { name, lib } (lib is the
    // imported module's index), the names of its own enums, and the positions
    // of its set targets that are ref bindings.
    ;var mod is ""
    ;var stolen is []
    ;var enums is []
    ;var refPositions is []

    // The id of module m: its place in initialization order for a library, "" for the entry file.
    ;fn modId(m) { m == modules($length) - 1 ? "" : "{m + 1}" }

    // Starts module m: its own names get its id; module.name, the imported module's (§13.1).
    ;fn enter(m) {
        ;(modules[m].file, modules[m].chars)(diag.setSource)
        ;set mod to m(modId)
        ;set stolen to []
        ;set enums to []
        ;set refPositions to modules[m].refTargets
        ;const list is modules[m].program.stmts
        ;var k is 0
        ;while (k < list($length)) {
            ;if (list[k].k == "enum") { ;(enums, list[k].name)($push) }
            ;set k += 1
        }
        ;const imports is modules[m].imports
        ;set k to 0
        ;while (k < imports($length)) {
            ;(stolen, { name: imports[k].node.name, lib: imports[k].lib })($push)
            ;set k += 1
        }
    }

    // The JS name of a user name in the current module.
    ;fn id(name) { "w{mod}_{name}" }

    // The index of the module that x names, or null. The checker forbids shadowing a module name.
    ;fn stolenFrom(x) {
        ;if (x.k != "name") { ;return null }
        ;var k is 0
        ;while (k < stolen($length)) {
            ;if (stolen[k].name == x.name) { ;return stolen[k].lib }
            ;set k += 1
        }
        null
    }

    // The kind of what module lib exports as name.
    ;fn exportKind(lib, name) {
        ;const xs is modules[lib].exports
        ;var k is 0
        ;while (xs[k].name != name) { ;set k += 1 }
        xs[k].kind
    }

    // The JS name of the enum x names (Enum or module.Enum), or null.
    ;fn enumJs(x) {
        ;if (x.k == "name") { ;return (enums, x.name)(text.contains) ? "l{mod}_{x.name}" : null }
        ;if (x.k != "mem") { ;return null }
        ;const lib is x.rec(stolenFrom)
        lib != null && (lib, x.field)(exportKind) == "enum" ? "l{lib(modId)}_{x.field}" : null
    }

    ;fn emit(line) { ;(out, ("  ", indent)(repeat) + line)($push) }
    ;fn tmp() {
        ;const name is "\$t{n}"
        ;set n += 1
        name
    }

    ;fn stmts(list) {
        ;var k is 0
        ;while (k < list($length)) {
            ;list[k](stmt)
            ;set k += 1
        }
    }

    // A block whose value is discarded.
    ;fn blockBody(b) {
        ;b.stmts(stmts)
        ;if (b.value != null) { ;"{b.value(expr)};"(emit) }
    }

    ;fn valueOf(b) { b.value == null ? "null" : b.value(expr) }

    ;fn stmt(s) {
        ;if (s.handler != null) { ;s(onfailStmt) ;return }
        ;const kind is s.k
        ;if (kind == "empty" || kind == "enum" || kind == "import" || kind == "end") { ;return }
        ;if (kind == "fn") { ;s(fnDef) ;return }
        ;if (kind == "return") {
            ;if (iife) { ;(s.pos, "'return' inside a conditional used as a value is not supported yet")(diag.abort) }
            ;"return {s.e == null ? "null" : s.e(expr)};"(emit)
            ;return
        }
        ;if (kind == "panic") { ;"throw \$rt.panic({s.e(expr)});"(emit) ;return }
        ;if (kind == "break" || kind == "continue") {
            ;if (loops == 0) { ;(s.pos, "'{kind == "break" ? "break" : "continue"}' cannot leave a conditional used as a value yet")(diag.abort) }
            ;(kind == "break" ? "break;" : "continue;")(emit)
            ;return
        }
        ;if (kind == "while") {
            ;"while ({s.neg ? "!" : ""}\$rt.cond({s.cond(expr)})) {{"(emit)
            ;set indent += 1
            ;set loops += 1
            ;s.body(blockBody)
            ;set loops -= 1
            ;set indent -= 1
            ;"}}"(emit)
            ;return
        }
        ;if (kind == "fail") { ;"throw \$rt.failWith({s.code});"(emit) ;return }
        ;if (kind == "exit") { ;"\$rt.exit({s.e == null ? "0" : s.e(expr)});"(emit) ;return }
        ;if (kind == "expr") {
            ;if (s.e.k == "chain") { ;s.e(chainStmt) ;return }
            ;if (s.e.k == "match") { ;s.e(matchStmt) ;return }
            ;if (s.e.k == "failWith") { ;"throw \$rt.failWith({s.e.arg(expr)});"(emit) ;return }
            ;"{s.e(expr)};"(emit)
            ;return
        }
        ;if (kind == "decl") {
            ;"{s.isVar || s.isRef ? "let" : "const"} {s.name(id)} = {(s.e, s(modeOf))(bindRhs)};"(emit)
            ;return
        }
        ;if (kind == "set") { ;s(setStmt) ;return }
        ;panic "codegen: unhandled statement {kind}"
    }

    ;fn fnDef(s) {
        ;var names is []
        ;var k is 0
        ;while (k < s.params($length)) {
            ;(names, s.params[k].name(id))($push)
            ;set k += 1
        }
        ;"function {s.name(id)}({(names, ", ")($join)}) {{"(emit)
        ;set indent += 1
        ;set k to 0
        ;while (k < s.params($length)) {
            ;const param is s.params[k]
            // A ref parameter takes the argument as it is (§6.1).
            ;if (!param.isRef) { ;"{param.name(id)} = \$rt.bind({param.name(id)}, {param.isVar(jsBool)});"(emit) }
            ;set k += 1
        }
        ;"try {{"(emit)
        ;set indent += 1
        ;const savedLoops is loops
        ;const savedIife is iife
        ;set loops to 0
        ;set iife to false
        ;s.body.stmts(stmts)
        ;"return {s.body(valueOf)};"(emit)
        ;set loops to savedLoops
        ;set iife to savedIife
        ;set indent -= 1
        ;"}} catch (\$e) {{"(emit)
        ;"  throw \$rt.leave(\$e, {s.name(text.quote)});"(emit)
        ;"}}"(emit)
        ;set indent -= 1
        ;"}}"(emit)
    }

    // An enum is l_<name>, a frozen object whose m_<member> properties are its members.
    ;fn enumDef(s, m) {
        ;var names is []
        ;var k is 0
        ;while (k < s.members($length)) {
            ;(names, s.members[k].name(text.quote))($push)
            ;set k += 1
        }
        ;"const l{m}_{s.name} = \$rt.makeEnum({s.name(text.quote)}, [{(names, ", ")($join)}]);"(emit)
    }

    // The value bound by a declaration or set, applying the copy table (§10.4, §10.9).
    // mode: the column of the copy table, "const", "var" or "ref". A
    // literal is frozen unless bound var; ref keeps any other value as it is.
    ;fn bindRhs(e, mode) {
        ;const mutable is mode == "var"
        ;if (e.k == "arr") {
            ;const items is e.items(exprList)
            ;return mutable ? "[{items}]" : "\$rt.frozen([{items}])"
        }
        ;if (e.k == "map") { ;return "\$rt.map([{e.items(exprList)}], {mutable(jsBool)})" }
        ;if (e.k == "rec") { ;return (e, mutable)(record) }
        ;if ((scalarKinds, e.k)(text.contains) || mode == "ref") { ;return e(expr) }
        "\$rt.bind({e(expr)}, {mutable(jsBool)})"
    }

    ;fn setStmt(s) {
        ;const t is s.target
        ;if (t.k == "name") {
            ;const mode is (refPositions, t.pos)(text.contains) ? "ref" : "var"
            ;if (s.op == null) { ;"{t.name(id)} = {(s.e, mode)(bindRhs)};"(emit) ;return }
            // The value is evaluated before the target is read (source order).
            ;var v is s.e(expr)
            ;if (s.e.k != "int" && s.e.k != "name") {
                ;const temp is (tmp)
                ;"const {temp} = {v};"(emit)
                ;set v to temp
            }
            ;"{t.name(id)} = \$rt.{s.op(binFn)}({t.name(id)}, {v});"(emit)
            ;return
        }
        ;if (t.k == "mem") {
            ;const args is "{s.e(expr)}, \"f_{t.field}\", {t.rec(expr)}"
            ;if (s.op == null) { ;"\$rt.setMem({args});"(emit) ;return }
            ;"\$rt.updMem({args}, \$rt.{s.op(binFn)});"(emit)
            ;return
        }
        ;const args is "{s.e(expr)}, {t.index(expr)}, {t.arr(expr)}"
        ;if (s.op == null) { ;"\$rt.setIdx({args});"(emit) ;return }
        ;"\$rt.updIdx({args}, \$rt.{s.op(binFn)});"(emit)
    }

    // A null-prototype object with mangled keys; values evaluate in source order.
    ;fn record(e, mutable) {
        ;var fields is ""
        ;var k is 0
        ;while (k < e.fields($length)) {
            ;const field is e.fields[k]
            ;set fields to fields + ", f_{field.name}: {field.e(expr)}"
            ;set k += 1
        }
        "\$rt.rec({{ __proto__: null{fields} }}, {mutable(jsBool)})"
    }

    // `whine` catches a signal from the statement's outermost call only, so the
    // call's arguments are evaluated before the try.
    ;fn onfailStmt(s) {
        ;const call is s.e
        ;var args is []
        ;var k is 0
        ;while (k < call.args($length)) {
            ;const a is call.args[k]
            ;if ((plainKinds, a.k)(text.contains)) {
                ;(args, a(expr))($push)
            } else {
                ;const temp is (tmp)
                ;"const {temp} = {a(expr)};"(emit)
                ;(args, temp)($push)
            }
            ;set k += 1
        }
        ;const r is (tmp)
        ;const ev is "\$e{n}"
        ;set n += 1
        ;"let {r};"(emit)
        ;"try {{"(emit)
        ;"  {r} = {(call.callee, args)(callJs)};"(emit)
        ;"}} catch ({ev}) {{"(emit)
        ;set indent += 1
        ;"if (!({ev} instanceof \$rt.Fail)) throw {ev};"(emit)
        ;if (s.handler.param != null) { ;"const {s.handler.param(id)} = {ev}.code;"(emit) }
        ;"{{"(emit)
        ;set indent += 1
        ;s.handler.body.stmts(stmts)
        ;"{r} = {s.handler.body(valueOf)};"(emit)
        ;set indent -= 1
        ;"}}"(emit)
        ;set indent -= 1
        ;"}}"(emit)
        ;var rest is s
        ;set rest.handler to null
        ;set rest.e to { k: "raw", js: r, pos: s.pos, paren: false }
        ;rest(stmt)
    }

    ;fn chainStmt(e) {
        ;var k is 0
        ;while (k < e.branches($length)) {
            ;const b is e.branches[k]
            ;"{k > 0 ? "}} else " : ""}if ({b(test)}) {{"(emit)
            ;set indent += 1
            ;b.body(blockBody)
            ;set indent -= 1
            ;set k += 1
        }
        ;if (e.els != null) {
            ;"}} else {{"(emit)
            ;set indent += 1
            ;e.els(blockBody)
            ;set indent -= 1
        }
        ;"}}"(emit)
    }

    ;fn test(b) { "{b.neg ? "!" : ""}\$rt.cond({b.cond(expr)})" }

    // Branches used as values, shared by conditional chains and matches. For a
    // chain, branch i is its i-th branch; for a match, its i-th case, tested
    // against the temporary t that holds the subject.
    ;fn branchCount(e) { e.k == "chain" ? e.branches($length) : e.cases($length) }
    ;fn branchBody(e, i) { e.k == "chain" ? e.branches[i].body : e.cases[i].body }
    ;fn branchTest(e, t, i) { e.k == "chain" ? e.branches[i](test) : (t, e.cases[i])(caseTest) }

    // Is every block, the else included, just a value?
    ;fn isPlain(e) {
        ;var k is 0
        ;while (k <= e(branchCount)) {
            ;const b is k < e(branchCount) ? (e, k)(branchBody) : e.els
            ;var j is 0
            ;while (j < b.stmts($length)) {
                ;if (b.stmts[j].k != "empty") { ;return false }
                ;set j += 1
            }
            ;set k += 1
        }
        true
    }

    // A ternary chain over the branches, ending in the else block's value.
    ;fn ternaryChain(e, t) {
        ;var js is e.els(valueOf)
        ;var k is e(branchCount) - 1
        ;while (k >= 0) {
            ;set js to "({(e, t, k)(branchTest)} ? {(e, k)(branchBody)(valueOf)} : {js})"
            ;set k -= 1
        }
        js
    }

    // The body of an arrow function that runs the first block whose test holds
    // and returns its value. Its lines are emitted into out, then taken back off.
    ;fn branchFunction(e, t) {
        ;const start is out($length)
        ;const savedIndent is indent
        ;const savedLoops is loops
        ;const savedIife is iife
        ;set indent to savedIndent + 1
        ;set loops to 0
        ;set iife to true
        ;var k is 0
        ;while (k < e(branchCount)) {
            ;const b is (e, k)(branchBody)
            ;"{k > 0 ? "}} else " : ""}if ({(e, t, k)(branchTest)}) {{"(emit)
            ;set indent += 1
            ;b.stmts(stmts)
            ;"return {b(valueOf)};"(emit)
            ;set indent -= 1
            ;set k += 1
        }
        ;"}} else {{"(emit)
        ;set indent += 1
        ;e.els.stmts(stmts)
        ;"return {e.els(valueOf)};"(emit)
        ;set indent -= 1
        ;"}}"(emit)
        ;const body is ((out, start, out($length))($slice), "\n")($join)
        ;while (out($length) > start) { ;out($pop) }
        ;set indent to savedIndent
        ;set loops to savedLoops
        ;set iife to savedIife
        body
    }

    // A conditional used as a value: a ternary chain when every branch is just a
    // value, otherwise an immediately-invoked arrow function.
    ;fn chainExpr(e) {
        ;if (e(isPlain)) { ;return (e, null)(ternaryChain) }
        ;const body is (e, null)(branchFunction)
        "(() => {{\n{body}\n{("  ", indent)(repeat)}}})()"
    }

    // match (§7.5): the subject is evaluated once into a temporary, then
    // compared with each case value by ==.
    ;fn caseTest(t, a) {
        ;var tests is []
        ;var k is 0
        ;while (k < a.values($length)) {
            ;(tests, "\$rt.eq({t}, {a.values[k](expr)})")($push)
            ;set k += 1
        }
        (tests, " || ")($join)
    }

    // The else block, or for an exhaustive enum match (which has none), a
    // block that raises a panic for a subject that is not one of the members.
    ;fn matchElse(e, t) {
        ;if (e.els != null || e.cases[0].values[0].k != "mem") { ;return e.els }
        { stmts: [], value: { k: "raw", js: "\$rt.noCase({t})", pos: null, paren: false }, close: null }
    }

    ;fn matchStmt(e) {
        ;const t is (tmp)
        ;"const {t} = {e.subject(expr)};"(emit)
        ;var k is 0
        ;while (k < e.cases($length)) {
            ;"{k > 0 ? "}} else " : ""}if ({(t, e.cases[k])(caseTest)}) {{"(emit)
            ;set indent += 1
            ;e.cases[k].body(blockBody)
            ;set indent -= 1
            ;set k += 1
        }
        ;const els is (e, t)(matchElse)
        ;if (els != null) {
            ;"}} else {{"(emit)
            ;set indent += 1
            ;els(blockBody)
            ;set indent -= 1
        }
        ;"}}"(emit)
    }

    // A match used as a value: an arrow function taking the subject, whose body
    // is a ternary chain when every block is just a value.
    ;fn matchExpr(e) {
        ;const t is (tmp)
        ;const subject is e.subject(expr)
        ;var withElse is e
        ;set withElse.els to (e, t)(matchElse)
        ;if (withElse(isPlain)) { ;return "(({t}) => {(withElse, t)(ternaryChain)})({subject})" }
        ;const body is (withElse, t)(branchFunction)
        "(({t}) => {{\n{body}\n{("  ", indent)(repeat)}}})({subject})"
    }

    ;fn callJs(callee, args) {
        ;const func is callee.k == "std" ? "\$std.{callee.name}"
            : callee.k == "mem" ? "w{callee.rec(stolenFrom)(modId)}_{callee.field}" : callee.name(id)
        "{func}({(args, ", ")($join)})"
    }

    ;fn exprList(list) {
        ;var js is []
        ;var k is 0
        ;while (k < list($length)) {
            ;(js, list[k](expr))($push)
            ;set k += 1
        }
        (js, ", ")($join)
    }

    ;fn expr(e) {
        ;const kind is e.k
        ;if (kind == "int") { ;return e.v < 0 ? "({e.v})" : "{e.v}" }
        ;if (kind == "float") { ;return "\$rt.f({e.v(jsFloat)})" }
        ;if (kind == "str") {
            ;var parts is []
            ;var k is 0
            ;while (k < e.parts($length)) {
                ;const part is e.parts[k]
                ;if (part($typeOf) == "string") {
                    ;if (part != "") { ;(parts, part(text.quote))($push) }
                } else {
                    ;(parts, "\$rt.text({part(expr)})")($push)
                }
                ;set k += 1
            }
            ;if (parts($length) == 0) { ;return "\"\"" }
            ;if (parts($length) == 1) { ;return parts[0] }
            ;return "({(parts, " + ")($join)})"
        }
        ;if (kind == "bool") { ;return e.v(jsBool) }
        ;if (kind == "null") { ;return "null" }
        ;if (kind == "nan") { ;return "\$rt.NAN" }
        ;if (kind == "inf") { ;return "\$rt.INF" }
        ;if (kind == "name") { ;return e.name(id) }
        ;if (kind == "std") { ;return "\$std.{e.name}" }
        ;if (kind == "arr") { ;return "\$rt.frozen([{e.items(exprList)}])" }
        ;if (kind == "map") { ;return "\$rt.map([{e.items(exprList)}], false)" }
        ;if (kind == "rec") { ;return (e, false)(record) }
        ;if (kind == "idx") { ;return "\$rt.idx({e.index(expr)}, {e.arr(expr)})" }
        ;if (kind == "mem") {
            // An enum member, a declaration imported from a module, or a record field. The
            // checker forbids shadowing enum and module names, so these are exact.
            ;const lin is e.rec(enumJs)
            ;if (lin != null) { ;return "{lin}.m_{e.field}" }
            ;const lib is e.rec(stolenFrom)
            ;if (lib != null) { ;return "w{lib(modId)}_{e.field}" }
            ;return "\$rt.get(\"f_{e.field}\", {e.rec(expr)})"
        }
        ;if (kind == "un") { ;return "\$rt.{e.op(unFn)}({e.e(expr)})" }
        ;if (kind == "bin") {
            ;if (e.op == "&&" || e.op == "||") {
                ;return "(\$rt.bool({e.l(expr)}, \"{e.op}\") {e.op} \$rt.bool({e.r(expr)}, \"{e.op}\"))"
            }
            ;return "\$rt.{e.op(binFn)}({e.l(expr)}, {e.r(expr)})"
        }
        ;if (kind == "tern") { ;return "(\$rt.cond({e.c(expr)}) ? {e.a(expr)} : {e.b(expr)})" }
        ;if (kind == "call") {
            ;var args is []
            ;var k is 0
            ;while (k < e.args($length)) {
                ;(args, e.args[k](expr))($push)
                ;set k += 1
            }
            ;return (e.callee, args)(callJs)
        }
        ;if (kind == "chain") { ;return e(chainExpr) }
        ;if (kind == "match") { ;return e(matchExpr) }
        ;if (kind == "raw") { ;return e.js }
        ;panic "codegen: unhandled expression {kind}"
    }

    // Enums are visible throughout their file, so they are all created first (§4.1).
    ;var mi is 0
    ;while (mi < modules($length)) {
        ;const list is modules[mi].program.stmts
        ;var li is 0
        ;while (li < list($length)) {
            ;if (list[li].k == "enum") { ;(list[li], mi(modId))(enumDef) }
            ;set li += 1
        }
        ;set mi += 1
    }
    ;set mi to 0
    ;while (mi < modules($length)) {
        ;mi(enter)
        ;modules[mi].program.stmts(stmts)
        ;set mi += 1
    }
    "\"use strict\";\n{runtime}\n\$rt.main(function () {{\n{(out, "\n")($join)}\n}});\n"
}

;end
