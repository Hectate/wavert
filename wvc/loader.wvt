// wvc: Loading the modules of the program being compiled (spec §13.1).
// A module is { file, chars, path, program, imports, exports, notLibrary, refTargets },
// where imports is [{ node, lib }] (its imports) and lib is the imported module's index in the
// module list. The checker fills in exports (the declarations it exports),
// notLibrary, and refTargets (the positions of set targets that are
// ref bindings, which the code generator binds without copying, §10.4).

;import diag from "diag.wvt"
;import lexer from "lexer.wvt"
;import parser from "parser.wvt"

// The directory part of a path, with its trailing '/'.
;fn dirOf(path) {
    ;const cs is (path, "")($split)
    ;var k is cs($length) - 1
    ;while (k >= 0 && cs[k] != "/") { ;set k -= 1 }
    ((cs, 0, k + 1)($slice), "")($join)
}

// Removes '.' segments, empty segments and 'dir/..' pairs.
;fn normalize(path) {
    ;const segs is (path, "/")($split)
    ;var out is []
    ;var k is 0
    ;while (k < segs($length)) {
        ;const seg is segs[k]
        ;set k += 1
        ;if (seg == "." || seg == "" && out($length) > 0) { ;continue }
        ;if (seg == ".." && out($length) > 0 && out[-1] != ".." && out[-1] != "") {
            ;out($pop)
        } else {
            ;(out, seg)($push)
        }
    }
    (out, "/")($join)
}

// A copy of xs with x added.
;fn with(xs, x) {
    ;var out is []
    ;var k is 0
    ;while (k < xs($length)) {
        ;(out, xs[k])($push)
        ;set k += 1
    }
    ;(out, x)($push)
    out
}

// Fails with an error in another file than the current one.
;fn failIn(file, chars, pos, message) {
    ;(file, chars)(diag.setSource)
    ;(pos, message)(diag.abort)
}

// Loads the entry file and every library it imports, directly or indirectly.
