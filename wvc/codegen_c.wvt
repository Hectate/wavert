            ;set indent += 1
            ;els(blockBody)
            ;set indent -= 1
        }
        ;"}}"(emit)
    }

    // A match used as a value: a statement expression that sets the subject,
    // then a ternary chain when every block is just a value.
    ;fn suspectExpr(e) {
        ;const t is (tmp)
        ;const subject is e.subject(expr).c
