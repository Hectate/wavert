            }
            // A nested function gets its parent's frame: ours, or one up the chain.
            ;var all is []
            ;if (parent != null) {
                ;(all, parent == cur ? "&fr" : "up{("->up", fns[cur].depth - fns[parent].depth - 1)(repeat)}")($push)
            }
            ;var k is 0
            ;while (k < args($length)) { ;(all, args[k])($push) ;set k += 1 }
            ;set code to "{f}({(all, ", ")($join)})"
        }
        checked ? "rt_chk({code}, {fns[cur].top ? "NULL" : fns[cur].name(text.quote)})" : code
    }

