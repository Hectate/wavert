            ;const b is (e, k)(branchBody)
            ;"{k > 0 ? "}} else " : ""}if ({(e, t, k)(branchTest)}) {{"(emit)
            ;set indent += 1
            ;b(resets)
            ;b.stmts(stmts)
            ;"{r} = {b(valueOf)};"(emit)
            ;set indent -= 1
            ;set k += 1
        }
        ;"}} else {{"(emit)
        ;set indent += 1
        ;e.els(resets)
        ;e.els.stmts(stmts)
        ;"{r} = {e.els(valueOf)};"(emit)
        ;set indent -= 1
        ;"}}"(emit)
        ;"{r};"(emit)
        ;const body is ((out, start, out($length))($slice), "\n")($join)
        ;while (out($length) > start) { ;out($pop) }
        ;set indent to savedIndent
        ;set loops to savedLoops
        ;set iife to savedIife
        "({{\n{body}\n{("  ", indent)(repeat)}}})"
    }

    // A conditional used as a value: a ternary chain when every branch is just a
    // value, otherwise a statement expression.
    ;fn chainExpr(e) {
        ;if (e(isPlain)) { ;return (e, null)(ternaryChain) }
        (e, null, null)(branchValue)
    }

    // match (§7.5): the subject is evaluated once into a temporary, then
    // compared with each case value by ==.
    ;fn alibiTest(t, a) {
        ;var tests is []
        ;var k is 0
        ;while (k < a.values($length)) {
            ;(tests, "eq({t}, {a.values[k](expr).c})")($push)
            ;set k += 1
        }
        (tests, " || ")($join)
    }

    // The else block, or for an exhaustive enum match (which has none), a
    // block that raises a panic for a subject that is not one of the members.
    ;fn suspectElse(e, t) {
        ;if (e.els != null || e.alibis[0].values[0].k != "mem") { ;return e.els }
        { stmts: [], value: { k: "raw", js: "(rt_no_alibi({t}), RT_NULL)", pos: null, paren: false }, close: null }
    }

    ;fn suspectStmt(e) {
