        }
    }

    ;fn emit(line) { ;(out, ("  ", indent)(repeat) + line)($push) }
    ;fn tmp() {
        ;const name is "t{tmps}"
        ;set tmps += 1
        name
    }

    ;fn str(s) {
        ;var k is 0
        ;while (k < strings($length) && strings[k] != s) { ;set k += 1 }
        ;if (k == strings($length)) { ;(strings, s)($push) }
        "&S{k}"
    }
    ;fn fieldRef(name) {
        ;if (!(fields, name)(text.contains)) { ;(fields, name)($push) }
        "&F_{name}"
    }

    // An enum is a static array of its members (§4.1).
    ;fn lineupDef(s, m) {
        ;const nm is s.name(str)
        ;var members is []
        ;var k is 0
