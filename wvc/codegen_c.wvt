        }
        null
    }

    // The enum statement named name in a list of statements, or null.
    ;fn lineupIn(ref list, name) {
        ;var k is 0
        ;while (k < list($length)) {
            ;if (list[k].k == "lineup" && list[k].name == name) { ;return list[k] }
            ;set k += 1
        }
        null
    }

    // The C name and statement of the enum x names (Enum or module.Enum), as { c, node }, or null.
    ;fn lineupOf(ref x) {
        ;if (x.k == "name") {
            ;const s is (ownLineups, x.name)(lineupIn)
            ;return s == null ? null : { c: "l{mod}_{x.name}", node: s }
        }
        ;if (x.k != "mem") { ;return null }
        ;const lib is x.rec(stolenFrom)
        ;if (lib == null) { ;return null }
        ;const xs is modules[lib].exports
        ;var k is 0
        ;while (k < xs($length) && xs[k].name != x.field) { ;set k += 1 }
        ;if (k == xs($length) || xs[k].kind != "lineup") { ;return null }
        { c: "l{lib(modId)}_{x.field}", node: (modules[lib].program.stmts, x.field)(lineupIn) }
    }

    // Where binding d lives, seen from the current function.
    ;fn place(d) {
        ;const owner is decls[d].func
        ;if (fns[owner].top) { ;return decls[d].cname }
        ;if (owner == cur) { ;return decls[d].captured ? "fr.{decls[d].cname}" : decls[d].cname }
        "up{("->up", fns[cur].depth - fns[owner].depth - 1)(repeat)}->{decls[d].cname}"
    }
    // Does reading d need the temporal dead zone check (§5.1)?
    ;fn tdz(d) { decls[d].kind == "claim" && decls[d].func != cur }
    ;fn read(d) {
        d(tdz) ? { c: "rt_def({d(place)}, {decls[d].name(text.quote)})", k: effectK } : { c: d(place), k: pureK }
    }

    // Arguments evaluated left to right (codegen_c.js call()), as { pre, cs }:
    // the temporaries to declare first, and the arguments' code. A direct C call
    // is safe when at most one argument has effects and the others are constants.
    ;fn seq(args) {
        ;var effects is 0
