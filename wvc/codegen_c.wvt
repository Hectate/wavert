            ;(all, "  rt_syms({fields($length)}, (wstr *const[]){{ {(refs, ", ")($join)} }});")($push)
        }
        ;set k to 0
        ;while (k < out($length)) { ;(all, out[k])($push) ;set k += 1 }
        ;(all, "}}")($push)
        ;(all, "")($push)
        (all, "\n")($join)
    }

    ;var mi is 0
    ;while (mi < modules($length)) {
        ;mi(analyze)
        ;set mi += 1
    }
    ;set mi to 0
    ;while (mi < modules($length)) {
