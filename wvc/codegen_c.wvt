                    ;(members, "wv {decls[j].cname};")($push)
                }
                ;set j += 1
            }
            ;if (members($length) == 0) { ;(members, "char none;")($push) }
            ;(all, "struct fr{f} {{ {(members, " ")($join)} }};")($push)
            ;set k += 1
        }
        ;set k to 0
        ;while (k < globals($length)) { ;(all, "static wv {globals[k]};")($push) ;set k += 1 }
        ;set k to 0
        ;while (k < functions($length)) { ;(all, "{functions[k].proto};")($push) ;set k += 1 }
        ;set k to 0
        ;while (k < functions($length)) {
            ;(all, "")($push)
