        ;set withElse.els to (e, t)(suspectElse)
        ;if (withElse(isPlain)) { ;return "({{ wv {t} = {subject}; {(withElse, t)(ternaryChain)}; }})" }
        (withElse, t, subject)(branchValue)
    }

    // A call; checked: a fail it leaves pending becomes a panic here (§8.2).
    ;fn callC(callee, ref args, checked) {
        ;var code is ""
