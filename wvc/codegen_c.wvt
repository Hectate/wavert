        } else if (kind == "idx") {
            ;(e.index, scope, f)(aexpr)
            ;(e.arr, scope, f)(aexpr)
        } else if (kind == "mem") {
            ;if (!(e.rec, scope)(notValue)) { ;(e.rec, scope, f)(aexpr) }
        } else if (kind == "un") {
            ;(e.e, scope, f)(aexpr)
        } else if (kind == "bin") {
            ;(e.l, scope, f)(aexpr)
            ;(e.r, scope, f)(aexpr)
        } else if (kind == "tern") {
            ;(e.c, scope, f)(aexpr)
            ;(e.a, scope, f)(aexpr)
            ;(e.b, scope, f)(aexpr)
        } else if (kind == "call") {
            ;var k is 0
            ;while (k < e.args($length)) { ;(e.args[k], scope, f)(aexpr) ;set k += 1 }
            ;if (e.callee.k == "name") { ;set curSlot[e.callee.pos] to (scope, e.callee.name)(find).d }
        } else if (kind == "chain") {
            ;var k is 0
            ;while (k < e.branches($length)) {
                ;(e.branches[k].cond, scope, f)(aexpr)
                ;(e.branches[k].body, scope(newScope), f, null)(ablock)
                ;set k += 1
            }
            ;if (e.els != null) { ;(e.els, scope(newScope), f, null)(ablock) }
        } else if (kind == "suspect") {
            ;(e.subject, scope, f)(aexpr)
            ;var k is 0
            ;while (k < e.alibis($length)) {
                ;(e.alibis[k].body, scope(newScope), f, null)(ablock)
                ;set k += 1
            }
            ;if (e.els != null) { ;(e.els, scope(newScope), f, null)(ablock) }
        }
    }

    ;fn analyze(m) {
        ;set curMod to m
        ;set mod to m(modId)
        ;const top is (null, null)(newFn)
        ;(tops, top)($push)
        ;var slot is []
        ;var i is 0
        ;while (i <= modules[m].chars($length)) {
            ;(slot, null)($push)
            ;set i += 1
        }
        ;(slots, slot)($push)
        ;set curSlot to slot
        ;const scope is null(newScope)
        ;const steals is modules[m].steals
        ;var k is 0
        ;while (k < steals($length)) {
            ;(scope, steals[k].node.name, "module", null)(put)
            ;set k += 1
        }
        ;({ stmts: modules[m].program.stmts, value: null }, scope, top, scope)(ablock)
    }

    // ---- emission ----

    // Starts module m: module.name means the imported module's name (§13.1).
    ;fn enter(m) {
        ;(modules[m].file, modules[m].chars)(diag.setSource)
        ;set curMod to m
        ;set mod to m(modId)
        ;set curSlot to slots[m]
        ;set cur to tops[m]
