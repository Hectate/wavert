        }
        ;(lineupDefs, "static const wmem l{m}_{s.name}[] = {{ {(members, ", ")($join)} }};")($push)
    }

    // The index of the module that x names, or null. The checker forbids shadowing a module name.
    ;fn stolenFrom(ref x) {
        ;if (x.k != "name") { ;return null }
        ;var k is 0
        ;while (k < stolen($length)) {
