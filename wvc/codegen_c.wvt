        } else {
            ;"{d(place)} = {value};"(emit)
        }
    }

    ;fn schemeDef(s) {
        ;const d is curSlot[s.namePos]
        ;const f is decls[d].schemeFn
        ;const pf is fns[f].parent
        ;const hasUp is !fns[pf].top
        ;var params is []
        ;if (hasUp) { ;(params, "struct fr{pf} *up")($push) }
        ;var k is 0
        ;while (k < s.params($length)) {
            ;const pd is curSlot[s.params[k].pos]
            ;(params, "wv {decls[pd].captured ? "p_" : ""}{decls[pd].cname}")($push)
            ;set k += 1
        }
        ;const proto is "static wv {fns[f].cname}({params($length) == 0 ? "void" : (params, ", ")($join)})"
        ;var entry is { proto: proto, lines: [] }
        ;(functions, entry)($push)
        ;if (f(hasFrame)) { ;(frames, f)($push) }
        ;const start is out($length)
        ;const savedIndent is indent
        ;const savedLoops is loops
        ;const savedIife is iife
        ;const savedCur is cur
        ;set indent to 1
        ;set loops to 0
        ;set iife to false
        ;set cur to f
        ;"rt_enter({s.name(text.quote)});"(emit)
        ;if (f(hasFrame)) { ;"struct fr{f} fr = {{ {hasUp ? ".up = up" : "0"} }};"(emit) }
        ;set k to 0
        ;while (k < s.params($length)) {
            ;const p is s.params[k]
            ;const pd is curSlot[p.pos]
            ;const cn is decls[pd].cname
            // A ref parameter takes the argument as it is (§6.1).
            ;const arg is decls[pd].captured ? "p_{cn}" : cn
            ;const v is p.isFickle ? arg : "rt_bind({arg}, {p.isShifty ? 1 : 0})"
            ;if (decls[pd].captured) { ;"fr.{cn} = {v};"(emit) } else if (!p.isFickle) { ;"{cn} = {v};"(emit) }
            ;set k += 1
        }
        ;s.body.stmts(stmts)
        ;"RT_RET({s.body(valueOf)});"(emit)
        ;set entry.lines to (out, start, out($length))($slice)
        ;while (out($length) > start) { ;out($pop) }
        ;set indent to savedIndent
        ;set loops to savedLoops
        ;set iife to savedIife
        ;set cur to savedCur
    }

    // The value bound by a declaration or set, applying the copy table (§10.4, §10.9).
    // mode: the column of the copy table, "const", "shifty" or "fickle". A
    // literal is frozen unless bound var; ref keeps any other value as it is.
    ;fn bindRhs(e, mode) {
        ;const mutable is mode == "shifty"
        ;if (e.k == "arr") { ;return (e, mutable)(array).c }
        ;if (e.k == "rec") { ;return (e, mutable)(record).c }
        ;if ((scalarKinds, e.k)(text.contains) || mode == "fickle") { ;return e(expr).c }
        "rt_bind({e(expr).c}, {mutable ? 1 : 0})"
    }

    ;fn cheatStmt(s) {
        ;const t is s.target
