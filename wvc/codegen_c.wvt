        }
    }

    // A block whose value is discarded.
    ;fn blockBody(b) {
        ;b(resets)
        ;b.stmts(stmts)
        ;if (b.value != null) { ;"(void){b.value(expr).c};"(emit) }
    }

    ;fn valueOf(b) { b.value == null ? "RT_NULL" : b.value(expr).c }

    ;fn stmt(ref s) {
