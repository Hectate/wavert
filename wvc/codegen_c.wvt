        ;if (kind == "raw") { ;return { c: e.js, k: constK } }
        ;panic "codegen: unhandled expression {kind}"
    }

    // The whole program: the runtime, then static data, then the functions.
    ;fn assemble() {
        // The runtime gets LF line endings however it is checked out, so the output is the same everywhere.
        ;var all is [((runtime, "\r\n")($split), "\n")($join), "// ---- program ----", ""]
        ;var k is 0
