            ;while (k < shapes($length) && shapes[k] != key) { ;set k += 1 }
            ;if (k == shapes($length)) { ;(shapes, key)($push) }
            ;set shape to "K{k}"
        }
        ;var vals is []
        ;var k is 0
        ;while (k < e.fields($length)) {
            ;(vals, e.fields[k].e(expr))($push)
            ;set k += 1
        }
        ;const sq is vals(seq)
        (sq, "rt_rec({mutable ? 1 : 0}, {sq.cs($length)}, {shape}, {sq.cs(values)})")(wrap)
    }

    // `whine` catches a signal from the statement's outermost call only, so the
    // call's arguments are evaluated before it.
