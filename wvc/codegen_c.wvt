            ;set k += 1
        }
        ;var cs is []
        ;if (effects == 0 || effects == 1 && !anyPure) {
            ;set k to 0
            ;while (k < args($length)) { ;(cs, args[k].c)($push) ;set k += 1 }
            ;return { pre: "", cs: cs }
        }
        ;var pre is []
        ;set k to 0
        ;while (k < args($length)) {
            ;if (args[k].k == constK) {
                ;(cs, args[k].c)($push)
            } else {
                ;const temp is (tmp)
                ;(pre, "wv {temp} = {args[k].c};")($push)
                ;(cs, temp)($push)
            }
            ;set k += 1
        }
        { pre: (pre, " ")($join), cs: cs }
    }
    ;fn wrap(sq, inner) { { c: sq.pre == "" ? inner : "({{ {sq.pre} {inner}; }})", k: effectK } }

    ;fn stmts(list) {
        ;var k is 0
        ;while (k < list($length)) {
            ;list[k](stmt)
            ;set k += 1
        }
    }

    // A block's captured declarations start unset each time it runs, as a fresh scope
    // would (temporal dead zone, §5.1).
    ;fn resets(ref b) {
        ;var k is 0
