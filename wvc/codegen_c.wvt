        }
        ;"}}"(emit)
    }

    ;fn test(b) { "{b.neg ? "!" : ""}rt_cond({b.cond(expr).c})" }

    // Branches used as values, shared by conditional chains and matches. For a
    // chain, branch i is its i-th branch; for a match, its i-th case, tested
    // against the temporary t that holds the subject.
    ;fn branchCount(e) { e.k == "chain" ? e.branches($length) : e.alibis($length) }
    ;fn branchBody(e, i) { e.k == "chain" ? e.branches[i].body : e.alibis[i].body }
    ;fn branchTest(e, t, i) { e.k == "chain" ? e.branches[i](test) : (t, e.alibis[i])(alibiTest) }

    // Is every block, the else included, just a value?
    ;fn isPlain(e) {
        ;var k is 0
