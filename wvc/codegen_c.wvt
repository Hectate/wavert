            }
            ;const sq is [d(read), v](seq)
            ;"{at} = {(sq, "rt_{s.op(binFn)}({sq.cs[0]}, {sq.cs[1]})")(wrap).c};"(emit)
            ;return
        }
        ;var key is null
        ;if (t.k == "mem") { ;set key to { c: t.field(fieldRef), k: constK } }
        ;const v is s.e(expr)
        ;const i is t.k == "mem" ? key : t.index(expr)
        ;const box is (t.k == "mem" ? t.rec : t.arr)(expr)
        ;const sq is [v, i, box](seq)
        ;const which is t.k == "mem" ? "mem" : "idx"
        ;if (s.op == null) {
            ;"{(sq, "rt_set_{which}({(sq.cs, ", ")($join)})")(wrap).c};"(emit)
            ;return
        }
        ;"{(sq, "rt_upd_{which}({(sq.cs, ", ")($join)}, rt_{s.op(binFn)})")(wrap).c};"(emit)
    }

    ;fn exprs(list) {
        ;var xs is []
        ;var k is 0
        ;while (k < list($length)) {
            ;(xs, list[k](expr))($push)
            ;set k += 1
        }
        xs
    }

    ;fn array(e, mutable) {
        ;const sq is e.items(exprs)(seq)
        (sq, "rt_arr({sq.cs($length)}, {sq.cs(values)}, {mutable ? 1 : 0})")(wrap)
    }

    // Records of one literal share their keys: a static shape K<n>.
    ;fn record(e, mutable) {
        ;var shape is "NULL"
        ;if (e.fields($length) > 0) {
            ;var names is []
            ;var k is 0
            ;while (k < e.fields($length)) {
                ;(names, e.fields[k].name)($push)
