// wvc: The C code generator, for --target c (forked from wahc's codegen_c.wah,
// a port of wah/js/src/codegen_c.js: see there for the design).
//
// Syntax tree records have fixed shapes, so what the analysis finds is kept
// beside them: bindings and functions are numbered (decls, fns), and each
// module's slot array maps a source position to the binding declared or used
// there. Every name, declaration, parameter and onfail code is its own token, so
// positions tell them apart.

;import text from "text.wvt"
;import diag from "diag.wvt"

;const binOps is ["+", "-", "*", "/", "%", "**", "==", "!=", "<", ">", "<=", ">=", "&", "|", "^", "<<", ">>"]
;const binFns is ["add", "sub", "mul", "div", "mod", "pow", "eq", "ne", "lt", "gt", "le", "ge", "band", "bor", "bxor", "shl", "shr"]
// Node kinds whose value can never be an array or record (so binding needs no copy check).
;const scalarKinds is ["int", "float", "str", "bool", "null", "nan", "inf", "bin", "un"]
// Node kinds that evaluate without calling anything.
;const plainKinds is ["int", "float", "bool", "null", "nan", "inf", "name", "std"]
// Stdlib functions that can fail (§12.1).
;const signalers is ["readLine", "readFile", "writeFile", "appendFile", "listDir", "deleteFile", "env", "run", "toInt", "toFloat"]

// How an expression's evaluation interacts with others (see seq).
;const constK is 0 // a constant: nothing can change it
;const pureK is 1 // reads a binding, so another argument's effects could change it
;const effectK is 2 // may have effects or raise a tantrum

;fn binFn(op) {
    ;var k is 0
    ;while (binOps[k] != op) { ;set k += 1 }
    binFns[k]
}
// How a declaration or parameter binds its values (§10.4): "shifty", "fickle" or "const".
;fn modeOf(x) { x.isShifty ? "shifty" : x.isFickle ? "fickle" : "const" }

;fn unFn(op) { op == "-" ? "neg" : op == "!" ? "not" : "bnot" }

;fn repeat(s, count) {
    ;var out is ""
    ;var k is 0
    ;while (k < count) {
        ;set out to out + s
        ;set k += 1
    }
    out
}

// The UTF-8 length of s.
;fn utf8Length(s) {
    ;const cs is (s, "")($split)
    ;var n is 0
    ;var k is 0
    ;while (k < cs($length)) {
        ;const c is cs[k]($code)
        ;set n += c < 0x80 ? 1 : c < 0x800 ? 2 : c < 0x10000 ? 3 : 4
        ;set k += 1
    }
    n
}

// A C string literal for s: printable characters as they are (the C file is
// UTF-8), other control characters as three-digit octal escapes.
;fn cString(s) {
    ;const cs is (s, "")($split)
    ;var out is "\""
    ;var k is 0
    ;while (k < cs($length)) {
        ;const ch is cs[k]
        ;const c is ch($code)
        ;if (ch == "\"") {
            ;set out to out + "\\\""
        } else if (ch == "\\") {
            ;set out to out + "\\\\"
        } else if (ch == "\n") {
            ;set out to out + "\\n"
        } else if (ch == "\t") {
            ;set out to out + "\\t"
        } else if (ch == "\r") {
            ;set out to out + "\\r"
        } else if (c < 32 || c == 127) {
            ;set out to out + "\\{(c / 64)($floor)}{(c / 8)($floor) % 8}{c % 8}"
        } else {
            ;set out to out + ch
        }
        ;set k += 1
    }
    out + "\""
}

// A static wstr initializer: { bytes, code points, ascii, sym, data }.
;fn wstrInit(s) {
    ;const bytes is s(utf8Length)
    ;const cps is s($length)
    "{{ {bytes}, {cps}, {bytes == cps ? 1 : 0}, 0, {s(cString)} }}"
}

// A C array of values: (wv[]){ ... }, or NULL when empty.
;fn values(ref cs) { cs($length) == 0 ? "NULL" : "(wv[]){{ {(cs, ", ")($join)} }}" }

// modules: checked, in initialization order, the entry file last.
;export fn generateC(modules, runtime) {
    ;var n is 0
    ;var tmps is 0
    ;var strings is []
    ;var fields is []
    ;var shapes is []
    ;var lineupDefs is []
    ;var globals is []
    ;var frames is []
    ;var functions is []
    ;var out is []
    ;var indent is 1
    // loops: enclosing loops reachable by break/continue; iife: inside a conditional used as a value
    ;var loops is 0
    ;var iife is false

    // Bindings: { kind, name, func, cname, isFickle, captured, schemeFn }, where func
    // is the index of the function that owns it, and schemeFn, for a function, its
    // own function. Functions: { name, parent, depth, top, children, cname },
    // where parent is null for a module's top level.
    ;var decls is []
    ;var fns is []
    // Per module: its top-level function, and its positions -> binding index.
    ;var tops is []
    ;var slots is []

    // The current module: its index and id, its positions, its module names as
    // { name, lib }, its enum statements, and the current function.
    ;var curMod is 0
    ;var mod is ""
    ;var curSlot is []
    ;var stolen is []
    ;var ownLineups is []
    ;var cur is 0

    // The id of module m: its place in initialization order for a library, "" for the entry file.
    ;fn modId(m) { m == modules($length) - 1 ? "" : "{m + 1}" }

    ;fn hasFrame(f) { !fns[f].top && fns[f].children > 0 }

    // ---- analysis: resolve names, find what nested functions use ----

    ;fn newScope(parent) {
        ;var names is []
        { parent: parent, names: names }
    }
    ;fn put(scope, name, kind, d) { ;(scope.names, { name: name, kind: kind, d: d })($push) }
    // The entry for name in scope or around it, or null.
    ;fn find(ref scope, name) {
        ;ref s is scope
        ;while (s != null) {
            ;ref ns is s.names
            ;var k is 0
            ;while (k < ns($length)) {
                ;if (ns[k].name == name) { ;return ns[k] }
                ;set k += 1
            }
            ;set s to s.parent
        }
        null
    }
    ;fn kindOf(scope, name) {
        ;const entry is (scope, name)(find)
        entry == null ? null : entry.kind
    }

    ;fn newFn(name, parent) {
        ;var f is {
            name: name, parent: parent, depth: parent == null ? 0 : fns[parent].depth + 1,
            top: parent == null, children: 0, cname: ""
        }
        ;(fns, f)($push)
        fns($length) - 1
    }

    // A binding of function f. At a module's top scope, declarations and functions keep
    // their names (other modules use them); everything else is numbered.
    ;fn bind(kind, name, f, atTop, mode) {
        ;var cname is "w{mod}_{name}"
        ;if (!atTop) {
            ;set cname to (kind == "scheme" ? "s" : "v") + "{n}_{name}"
            ;set n += 1
        }
        ;var d is { kind: kind, name: name, func: f, cname: cname, isFickle: mode == "fickle", captured: false, schemeFn: null }
        ;(decls, d)($push)
        ;if (fns[f].top && kind != "scheme") { ;(globals, cname)($push) }
        decls($length) - 1
    }

    ;fn ablock(ref b, scope, f, topScope) {
        ;const atTop is scope == topScope
        ;const list is b.stmts
        ;var k is 0
        ;while (k < list($length)) {
            ;const s is list[k]
            ;if (s.k == "scheme") {
                ;const d is ("scheme", s.name, f, atTop, "")(bind)
                ;const child is (s.name, f)(newFn)
                ;set fns[child].cname to decls[d].cname
                ;set decls[d].schemeFn to child
                ;set fns[f].children += 1
                ;set curSlot[s.namePos] to d
                ;(scope, s.name, "scheme", d)(put)
            } else if (s.k == "lineup") {
                ;(scope, s.name, "lineup", null)(put)
            } else if (s.k == "claim") {
                ;const d is ("claim", s.name, f, atTop, s(modeOf))(bind)
                ;set curSlot[s.namePos] to d
                ;(scope, s.name, "claim", d)(put)
            }
            ;set k += 1
        }
        ;set k to 0
        ;while (k < list($length)) {
            ;(list[k], scope, f, topScope)(astmt)
            ;set k += 1
        }
        ;if (b.value != null) { ;(b.value, scope, f)(aexpr) }
    }

    ;fn astmt(ref s, scope, f, topScope) {
        ;const kind is s.k
        ;if (kind == "scheme") {
            ;const d is curSlot[s.namePos]
            ;const child is decls[d].schemeFn
            ;const ps is scope(newScope)
            ;var k is 0
            ;while (k < s.params($length)) {
                ;const p is s.params[k]
                ;const pd is ("param", p.name, child, false, p(modeOf))(bind)
                ;set curSlot[p.pos] to pd
                ;(ps, p.name, "param", pd)(put)
                ;set k += 1
            }
            ;(s.body, ps(newScope), child, topScope)(ablock)
        } else if (kind == "lurk") {
            ;(s.cond, scope, f)(aexpr)
            ;(s.body, scope(newScope), f, topScope)(ablock)
        } else if (kind == "getaway" || kind == "tantrum" || kind == "exit" || kind == "claim") {
            ;if (s.e != null) { ;(s.e, scope, f)(aexpr) }
        } else if (kind == "expr") {
            ;if (s.e.k == "sigcall") { ;(s.e.arg, scope, f)(aexpr) } else { ;(s.e, scope, f)(aexpr) }
        } else if (kind == "cheat") {
            ;(s.e, scope, f)(aexpr)
            ;(s.target, scope, f)(atarget)
        }
        ;if (s.handler != null) {
            ;const h is s.handler
            ;const hs is scope(newScope)
            ;if (h.param != null) {
                ;const wd is ("whine", h.param, f, false, "")(bind)
                ;set curSlot[h.paramPos] to wd
                ;(hs, h.param, "whine", wd)(put)
            }
            ;(h.body, hs(newScope), f, topScope)(ablock)
        }
    }

    // A name used in function f: a binding of another function is captured.
    ;fn use(x, scope, f) {
        ;const d is (scope, x.name)(find).d
        ;set curSlot[x.pos] to d
        ;if (decls[d].func != f) { ;set decls[d].captured to true }
    }

    ;fn atarget(t, scope, f) {
        ;if (t.k == "name") { ;(t, scope, f)(use) ;return }
        ;if (t.k == "idx") { ;(t.index, scope, f)(aexpr) }
        ;(t.k == "mem" ? t.rec : t.arr, scope, f)(aexpr)
    }

    // Is x (the right of '.') an enum or module name, rather than a value?
    ;fn notValue(ref x, scope) {
        ;if (x.k == "mem") { ;return x.rec.k == "name" && (scope, x.rec.name)(kindOf) == "module" }
        ;if (x.k != "name") { ;return false }
        ;const kind is (scope, x.name)(kindOf)
        kind == "lineup" || kind == "module"
    }

    ;fn aexpr(ref e, scope, f) {
        ;const kind is e.k
        ;if (kind == "str") {
            ;var k is 0
