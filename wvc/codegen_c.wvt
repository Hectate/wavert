            ;(kind == "bail" ? "break;" : "continue;")(emit)
            ;return
        }
        ;if (kind == "lurk") {
            ;"while ({s.neg ? "!" : ""}rt_cond({s.cond(expr).c})) {{"(emit)
            ;set indent += 1
            ;set loops += 1
            ;s.body(blockBody)
            ;set loops -= 1
            ;set indent -= 1
            ;"}}"(emit)
            ;return
        }
        ;if (kind == "signal") { ;"rt_i({s.code})"(signal) ;return }
        ;if (kind == "exit") { ;"rt_exit({s.e == null ? "rt_i(0)" : s.e(expr).c});"(emit) ;return }
        ;if (kind == "expr") {
            ;if (s.e.k == "chain") { ;s.e(chainStmt) ;return }
