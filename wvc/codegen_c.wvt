                ;if (!d(tdz)) { ;"{at} = {v};"(emit) ;return }
                // The value is evaluated first; then the binding must exist (§5.1).
                ;const temp is (tmp)
                ;"wv {temp} = {v};"(emit)
                ;"(void)rt_def({at}, {decls[d].name(text.quote)});"(emit)
                ;"{at} = {temp};"(emit)
                ;return
            }
            // The value is evaluated before the target is read (source order).
            ;var v is s.e(expr)
