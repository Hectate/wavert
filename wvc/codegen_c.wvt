            ;const key is { c: e.field(fieldRef), k: constK }
            ;const sq is [key, e.rec(expr)](seq)
            ;return (sq, "rt_get({sq.cs[0]}, {sq.cs[1]})")(wrap)
        }
        ;if (kind == "un") { ;return { c: "rt_{e.op(unFn)}({e.e(expr).c})", k: effectK } }
        ;if (kind == "bin") {
            ;if (e.op == "&&" || e.op == "||") {
                ;return { c: "rt_b(rt_bool({e.l(expr).c}, \"{e.op}\") {e.op} rt_bool({e.r(expr).c}, \"{e.op}\"))", k: effectK }
