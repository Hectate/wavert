            ;"RT_RET({s.e == null ? "RT_NULL" : s.e(expr).c});"(emit)
            ;return
        }
        ;if (kind == "tantrum") { ;"rt_tantrum({s.e(expr).c});"(emit) ;return }
        ;if (kind == "bail" || kind == "loiter") {
