            ;if (s.e.k == "sigcall") { ;s.e.arg(expr).c(signal) ;return }
            ;"(void){s.e(expr).c};"(emit)
            ;return
        }
        ;if (kind == "claim") { ;(curSlot[s.namePos], (s.e, s(modeOf))(bindRhs))(claimDecl) ;return }
        ;if (kind == "cheat") { ;s(cheatStmt) ;return }
        ;panic "codegen: unhandled statement {kind}"
    }

    // A fail leaves the function at once; the caller sees the code (§8.2).
    ;fn signal(code) {
        ;"rt_signal({code});"(emit)
        ;"RT_RET(RT_NULL);"(emit)
    }

    // Sets binding d for the first time: a new C local, or its frame slot or global.
    ;fn claimDecl(d, value) {
        ;const owner is decls[d].func
        ;if (!fns[owner].top && owner == cur && !decls[d].captured) {
