            ;set code to "({(e, t, k)(branchTest)} ? {(e, k)(branchBody)(valueOf)} : {code})"
            ;set k -= 1
        }
        code
    }

    // A statement expression ({ ... }) that runs the first block whose test
    // holds and has its value. subject, if not null, is the code that sets
    // the temporary t first. Its lines are emitted into out, then taken back off.
    ;fn branchValue(e, t, subject) {
        ;const start is out($length)
        ;const savedIndent is indent
