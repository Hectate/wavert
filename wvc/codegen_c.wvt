        ;"rt_sigcode = 0;"(emit)
        ;"{{"(emit)
        ;set indent += 1
        ;h.body(resets)
        ;h.body.stmts(stmts)
        ;"{r} = {h.body(valueOf)};"(emit)
        ;set indent -= 1
        ;"}}"(emit)
        ;set indent -= 1
        ;"}}"(emit)
        ;var rest is s
        ;set rest.handler to null
        ;set rest.e to { k: "raw", js: r, pos: s.pos, paren: false }
        ;rest(stmt)
    }

    ;fn chainStmt(e) {
        ;var k is 0
        ;while (k < e.branches($length)) {
            ;const b is e.branches[k]
