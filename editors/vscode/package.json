{
  "name": "wavert-language",
  "displayName": "Wavert",
  "description": "Syntax highlighting, brackets, snippets, and documentation on hover and in completions for Wavert (.wvt)",
  "version": "0.3.2",
  "publisher": "wavert",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "wavert",
        "aliases": [
          "Wavert",
          "wvt"
        ],
        "extensions": [
          ".wvt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "wavert",
        "scopeName": "source.wavert",
        "path": "./syntaxes/wavert.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "wavert",
        "path": "./snippets/wavert.code-snippets"
      }
    ],
    "configuration": {
      "title": "Wavert",
      "properties": {
        "wavert.libPath": {
          "type": "string",
          "default": "",
          "description": "The standard library folder that '$lib/' imports come from, for hovers and completions. Empty: found from wavert.wvcPath, or the Wavert repository the file is in."
        },
        "wavert.wvcPath": {
          "type": "string",
          "default": "",
          "description": "The wvc compiler. Its standard library is found as wvc finds it: lib/ next to wvc, then one folder up."
        }
      }
    }
  }
}
