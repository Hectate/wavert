{
  "Program": {
    "prefix": "program",
    "description": "A program: statements, then ;exit (§13)",
    "body": [
      "$0",
      ";exit"
    ]
  },
  "Library": {
    "prefix": "library",
    "description": "A library: declarations marked export, then ;end (§13.1)",
    "body": [
      ";export fn ${1:name}(${2:x}) {",
      "\t$0",
      "}",
      "",
      ";end"
    ]
  },
  "Import": {
    "prefix": "import",
    "description": "Import a library (§13.1)",
    "body": [
      ";import ${1:lib} from \"${2:$1}.wvt\""
    ]
  },
  "Function": {
    "prefix": "fn",
    "description": "Function definition (§6.1)",
    "body": [
      ";fn ${1:name}(${2:a, b}) {",
      "\t$0",
      "}"
    ]
  },
  "Enum": {
    "prefix": "enum",
    "description": "Enumeration, top level only (§4.1)",
    "body": [
      ";enum ${1:Name} (${2:a, b})"
    ]
  },
  "If": {
    "prefix": "if",
    "description": "if (§7.1)",
    "body": [
      ";if (${1:cond}) {",
      "\t$0",
      "}"
    ]
  },
  "If else": {
    "prefix": "if-else",
    "description": "if / else (§7.1)",
    "body": [
      ";if (${1:cond}) {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ]
  },
  "Loop over an array": {
    "prefix": "while-each",
    "description": "while loop over an array's elements (§7.4)",
    "body": [
      ";var ${1:i} is 0",
      ";while (${1:i} < ${2:xs}(\\$length)) {",
      "\t;const ${3:x} is ${2:xs}[${1:i}]",
      "\t$0",
      "\t;set ${1:i} += 1",
      "}"
    ]
  },
  "Match": {
    "prefix": "match",
    "description": "Multi-way branch (§7.5)",
    "body": [
      ";match (${1:x}) {",
      "\tcase ${2:\"a\"} {",
      "\t\t$0",
      "\t}",
      "\telse {",
      "\t}",
      "}"
    ]
  },
  "Onfail": {
    "prefix": "onfail",
    "description": "Fail handler on its own line, indented one level (§8.2)",
    "body": [
      "\tonfail (${1:c}) { ${0:null} }"
    ]
  },
  "Record": {
    "prefix": "record",
    "description": "Record literal (§10.7)",
    "body": [
      "{ ${1:kind}: ${2:value} }"
    ]
  },
  "Match on kind": {
    "prefix": "match-kind",
    "description": "Match on a record's kind field, an enum member (§10.10)",
    "body": [
      ";match (${1:thing}.kind) {",
      "\tcase ${2:Kind}.${3:a} {",
      "\t\t$0",
      "\t}",
      "}"
    ]
  },
  "Map": {
    "prefix": "map",
    "description": "Map literal; [:] is an empty map (§10.11)",
    "body": [
      "[${1:key}: ${2:value}]"
    ]
  },
  "Loop over a map": {
    "prefix": "while-map",
    "description": "while loop over a map's keys and values, in insertion order (§10.11)",
    "body": [
      ";const ${1:keys} is ${2:m}(\\$keys)",
      ";var ${3:i} is 0",
      ";while (${3:i} < ${1:keys}(\\$length)) {",
      "\t;const ${4:value} is ${2:m}[${1:keys}[${3:i}]]",
      "\t$0",
      "\t;set ${3:i} += 1",
      "}"
    ]
  },
  "Read keys": {
    "prefix": "readkey",
    "description": "Read key presses until q or the end of input (§12.2)",
    "body": [
      ";while (true) {",
      "\t;const ${1:key} is (\\$readKey)",
      "\t\tonfail { ;break }",
      "\t;if (${1:key} == \"q\") { ;break }",
      "\t$0",
      "}"
    ]
  },
  "Animation loop": {
    "prefix": "tick",
    "description": "Tick at a steady rate between key presses, with $waitKey and a deadline from $elapsed (§12.2)",
    "body": [
      ";var ${1:next} is (\\$elapsed) + ${2:100}",
      ";while (true) {",
      "\t;const ${3:key} is (${1:next} - (\\$elapsed))(\\$waitKey)",
      "\t\tonfail { ;break }",
      "\t;if (${3:key} == null) {",
      "\t\t;set ${1:next} += ${2:100}",
      "\t\t$0",
      "\t} else if (${3:key} == \"q\") {",
      "\t\t;break",
      "\t}",
      "}"
    ]
  }
}
