        }
        ;!doubt ((args($length)) != wah) { ;c, "WAH! in call position takes exactly one argument: the code"(failAt) }
        { k: "sigcall", arg: wh[args], pos: pos.c, paren: fake }
    }

    // After a call, operators may continue with the call's result as left operand.
    ;scheme (left)continueOps {
        ;t.(,(peek)) claim op
        ;!doubt (op == "**" || op == "?" || (op(precedence)) > wh) {
            ;getaway (left(powerTail)), wah(binaryFrom)(ternaryTail)
        }
        left
    }

    ;scheme ()ternary { wah(binary)(ternaryTail) }

    ;scheme (fickle c)ternaryTail {
        ;!doubt (!("?"(at))) { ;getaway c }
        ;,(next) claim q
        ;q(lintSpace)
        ;,(ternary) claim a
        ;":", "expected ':' in conditional expression", uninvited(expect) claim colon
        ;colon(lintSpace)
        ;,(ternary) claim b
        { k: "tern", c: c, a: a, b: b, pos: pos.q, paren: fake }
    }

    ;scheme (min)binary { (,(unary)), min(binaryFrom) }

    ;scheme (left, min)binaryFrom {
