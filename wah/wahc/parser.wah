                ;,(block) cheat els
            } anyway {
                ;bail
            }
        }
        ;!doubt ((alibis($length)) == wh) {
            ;,(peek), "a suspect needs at least one alibi", "suspect (x) {{ alibi \"a\" {{ ... }} }}"(failAtHint)
        }
        ;"}}", "expected 'alibi', 'anyway' or '}}' in a suspect", uninvited(expect)
        { k: "suspect", subject: subject, alibis: alibis, els: els, pos: pos.kw, paren: fake }
    }

    // An alibi value: a literal, or member.Name, which the checker resolves (§7.5).
    ;scheme ()alibiValue {
        ;,(peek) claim tk
        ;,(postfix) claim v
        ;k.v claim kind
        ;!doubt (kind == "int" || kind == "bool" || kind == "null") { ;getaway v }
        // member.Lineup, or member.Lineup.module for a stolen lineup
        ;!doubt (kind == "mem" && (k.rec.v == "name" || k.rec.v == "mem" && k.rec.rec.v == "name")) { ;getaway v }
