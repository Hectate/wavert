        ;op(lintSpace)
        { k: "bin", op: "**", l: base, r: ,(unary), pos: pos.op, paren: fake }
    }

    // Indexing and member access are inverted, with the container on the right:
    // i[arr], field.rec. Member access takes a whole postfix operand on its right,
    // so `kind.i[items]` is items[i].kind (§10.8).
    ;scheme ()postfix {
        ;,(peek) claim tk
        ;!doubt (p + wah < (toks($length)) && t.(p + wah)[toks] == ".") {
            ;!doubt (t.tk != "id") {
                ;(keywords.lexer, t.tk(contains.text)) ? "'{t.tk}' is a keyword and cannot be a field name"
                    : "expected a field name before '.', found {tk(describe)}" claim message
                ;tk, message, "member access is written field.record, e.g. kind.node"(failAtHint)
            }
            ;,(next)
            ;,(next)
            ;getaway { k: "mem", field: v.tk, rec: ,(postfix), pos: pos.tk, paren: fake }
        }
        ;,(primary) claim fickle e
        ;lurk ("["(at)) {
            ;,(next) claim open
            ;!doubt (nl.open && depth > wh) {
                ;warnings.diag, (pos.open, "'[' at the start of a line indexes the expression before it",
                    "if it starts the block's value, wrap the value in parentheses: ([a, b])"(warn.diag))($push)
            }
            ;,(expr) claim arr
            ;"]", "expected ']' to close the index", uninvited(expect)
            ;!doubt (k.e == "str" && !paren.e && (parts.e($length)) == wah && (wh[parts.e]($typeOf)) == "purple") {
                ;wh[parts.e] claim key
                ;!doubt ((key(isIdent)) && !(keywords.lexer, key(contains.text))) {
                    ;warnings.diag, (pos.e, "string-literal field key: write {key}.record instead of \"{key}\"[record]",
                        uninvited(warn.diag))($push)
                }
            }
            ;{ k: "idx", index: e, arr: arr, pos: pos.open, paren: fake } cheat e
        }
        ;!doubt ("."(at)) {
            ;,(peek), "the left side of '.' must be a field name",
                "member access is written field.record; for a computed key write key[record]"(failAtHint)
        }
        e
    }

    ;scheme ()primary {
        ;,(peek) claim tk
