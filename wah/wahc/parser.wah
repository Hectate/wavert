// wahc: The parser (js/src/parser.js, spec §5-§8, §11.4).
//
// Statements begin with ';'. Expressions use precedence climbing; the comma
// list and the postfix call `(f)` sit below the ternary, and a call consumes
// every comma-separated expression to its left at the current nesting level.
//
// Expression nodes (k): int float str bool null nan inf name std arr rec idx mem
//   un bin tern call sigcall chain suspect. Each has pos and paren (real when parenthesized).
// Statement nodes (k): empty scheme lineup steal bribe getaway tantrum bail loiter
//   lurk signal exit expr claim cheat. Each has pos, end and handler: uninvited, or the statement's
//   whine as { pos, param, paramPos, body }.
// The shapes match parser.js, except that keywords cannot be field names (§10.7):
// parser.js's `shifty` and `fickle` are `isShifty` and `isFickle` here, and its `whine` is `handler`.

;"text.wah" steal text
;"diag.wah" steal diag
;"lexer.wah" steal lexer

;["int", "float", "str", "real", "fake", "uninvited", "nobody", "everybody", "id", "std",
  "(", "[", "{{", "doubt", "!doubt", "suspect", "-", "!", "~", ","] claim exprStart
;["expr", "claim", "cheat", "getaway", "tantrum", "exit"] claim whineOk
;["id", "std", "sig"] claim callees
;"calls are postfix (arguments first, then one function name): ;x, y(f)" claim postfixHint

// Binding power of a binary operator, or wh if t is not one.
;scheme (t)precedence {
    ;!doubt (t == "||") { ;getaway wah }
    ;!doubt (t == "&&") { ;getaway waah }
    ;!doubt (t == "==" || t == "!=") { ;getaway waaah }
    ;!doubt (t == "<" || t == ">" || t == "<=" || t == ">=") { ;getaway waaaah }
    ;!doubt (t == "|") { ;getaway waaaaah }
    ;!doubt (t == "^") { ;getaway waaaaaah }
    ;!doubt (t == "&") { ;getaway waaaaaaah }
    ;!doubt (t == "<<" || t == ">>") { ;getaway waaaaaaaah }
    ;!doubt (t == "+" || t == "-") { ;getaway waaaaaaaaah }
    ;!doubt (t == "*" || t == "/" || t == "%") { ;getaway waaaaaaaaaah }
    wh
}

;scheme (s)isIdent {
    ;s, ""($split) claim cs
    ;!doubt ((cs($length)) == wh || !(wh[cs](isIdStart.text))) { ;getaway fake }
    ;wah claim shifty k
    ;lurk (k < (cs($length))) {
        ;!doubt (!(k[cs](isIdChar.text))) { ;getaway fake }
        ;++cheat k
    }
    real
}

;scheme (tk)describe {
    ;!doubt (t.tk == "eof") { ;getaway "end of input" }
    ;!doubt (t.tk == "id") { ;getaway "'{v.tk}'" }
    ;!doubt (t.tk == "std") { ;getaway "'\${v.tk}'" }
    ;!doubt (t.tk == "int" || t.tk == "float" || t.tk == "sig") { ;getaway "'{text.tk}'" }
    ;!doubt (t.tk == "str") { ;getaway "a string" }
    ;!doubt (t.tk == "opcheat") { ;getaway "'{v.tk}cheat'" }
    "'{t.tk}'"
}

;scheme (tk, message, hint)failAtHint { ;pos.tk, message, hint(failHint.diag) }
;scheme (tk, message)failAt { ;pos.tk, message, uninvited(failHint.diag) }

;scheme (k, e)simpleStatement { { k: k, e: e, pos: uninvited, end: uninvited, handler: uninvited } }

;scheme (fickle toks)parse { toks, fake(parser) }

// Does evaluating e call anything? An expression statement that does not has no effect (§2.8).
// Conditional chains count as having an effect.
;scheme (e)hasEffect {
    ;k.e claim kind
    ;!doubt (kind == "call" || kind == "sigcall" || kind == "chain" || kind == "suspect") { ;getaway real }
    ;!doubt (kind == "str") {
        ;wh claim shifty i
        ;lurk (i < (parts.e($length))) {
            ;!doubt ((i[parts.e]($typeOf)) != "purple" && (i[parts.e](hasEffect))) { ;getaway real }
            ;++cheat i
        }
        ;getaway fake
    }
    ;!doubt (kind == "arr") {
        ;wh claim shifty i
        ;lurk (i < (items.e($length))) {
            ;!doubt (i[items.e](hasEffect)) { ;getaway real }
            ;++cheat i
        }
        ;getaway fake
    }
    ;!doubt (kind == "rec") {
        ;wh claim shifty i
        ;lurk (i < (fields.e($length))) {
            ;!doubt (e.i[fields.e](hasEffect)) { ;getaway real }
            ;++cheat i
        }
        ;getaway fake
    }
    ;!doubt (kind == "idx") { ;getaway (index.e(hasEffect)) || (arr.e(hasEffect)) }
    ;!doubt (kind == "mem") { ;getaway rec.e(hasEffect) }
    ;!doubt (kind == "un") { ;getaway e.e(hasEffect) }
    ;!doubt (kind == "bin") { ;getaway (l.e(hasEffect)) || (r.e(hasEffect)) }
    ;!doubt (kind == "tern") { ;getaway (c.e(hasEffect)) || (a.e(hasEffect)) || (b.e(hasEffect)) }
    fake
}

// Parses toks as a program, or as the expression of a string interpolation when inner is real.
;scheme (fickle toks, inner)parser {
    ;wh claim shifty p
    // Blocks entered; hints about block values apply only inside one.
    ;wh claim shifty depth

    ;scheme ()peek { p[toks] }
    ;scheme (type)at { t.p[toks] == type }
    // A call is exactly `(name)` after an expression. Any other '(' ends the
    // expression, so a block value like `(a + b) / c` may follow a statement.
    ;scheme ()atCall {
        ;!doubt (p + waah >= (toks($length)) || t.p[toks] != "(") { ;getaway fake }
        ;!doubt (t.(p + waah)[toks] == ")" && (callees, t.(p + wah)[toks](contains.text))) { ;getaway real }
        // (name.module): a scheme a stolen module bribes (§13.1)
        p + waaaah < (toks($length)) && t.(p + wah)[toks] == "id" && t.(p + waah)[toks] == "."
            && t.(p + waaah)[toks] == "id" && t.(p + waaaah)[toks] == ")"
    }
    ;scheme ()next {
        ;p[toks] claim tk
        ;!doubt (t.tk != "eof") { ;++cheat p }
        tk
    }
    ;scheme (type)accept { (type(at)) ? (,(next)) : uninvited }
    // msg uninvited means "expected '<type>'".
    ;scheme (type, msg, hint)expect {
        ;!doubt (type(at)) { ;getaway ,(next) }
        ;,(peek) claim found
        ;msg == uninvited ? "expected '{type}'" : msg claim m
        ;found, "{m}, found {found(describe)}", hint(failAtHint)
    }
    ;scheme (op)lintSpace {
        ;!doubt (!sp.op || !sp.(,(peek))) {
            ;warnings.diag, (pos.op, "missing whitespace around '{t.op}'", uninvited(warn.diag))($push)
        }
    }

    // ---- statements ----

    ;scheme ()program {
        ;[] claim shifty stmts
        // Has a statement other than steal or empty been seen?
        ;fake claim shifty started
        ;lurk (!("eof"(at))) {
            ;!doubt (!(";"(at))) {
                ;,(peek) claim tk
                ;("("(at)) ? postfixHint : "every Γ-- statement begins with ;" claim hint
                ;tk, "expected ';' to start a statement, found {tk(describe)}", hint(failAtHint)
            }
            ;,(statement) claim s
            ;!doubt (k.s == "steal" && started) { ;pos.s, "'steal' must come before every other statement"(fail.diag) }
            ;!doubt (k.s != "steal" && k.s != "empty") { ;real cheat started }
            ;stmts, s($push)
        }
        { stmts: stmts, end: pos.(,(peek)) }
    }

    ;scheme ()statement {
        ;,(next) claim semi
        ;,(peek) claim tk
        ;!doubt (t.tk == ";" || t.tk == "}}" || t.tk == "eof") {
            ;getaway { k: "empty", pos: pos.semi, end: pos.tk, handler: uninvited }
        }
        ;tk(statementBody) claim shifty s
        ;pos.tk cheat pos.s
        ;!doubt ("whine"(at)) {
            ;,(next) claim w
            ;!doubt (!(whineOk, k.s(contains.text))) {
                ;w, "'whine' must follow a statement whose value comes from a call"(failAt)
            }
            ;uninvited claim shifty param
            ;!doubt (("("(accept)) != uninvited) {
                ;"id", "expected a name for the signal code", uninvited(expect) cheat param
                ;")", uninvited, uninvited(expect)
            }
            ;param == uninvited claim noParam
            ;{
                pos: pos.w,
                param: noParam ? uninvited : v.param,
                paramPos: noParam ? uninvited : pos.param,
                body: ,(block)
            } cheat handler.s
        }
        ;pos.(,(peek)) cheat end.s
        s
    }

    // The statement starting at tk, without its pos, end and handler.
    ;scheme (tk)statementBody {
        ;t.tk claim kind
        ;!doubt (kind == "scheme") { ;getaway ,(schemeStatement) }
        ;!doubt (kind == "lineup") { ;getaway ,(lineupStatement) }
        ;!doubt (kind == "getaway") {
            ;,(next)
            ;(exprStart, t.(,(peek))(contains.text)) ? (,(expr)) : uninvited claim e
            ;getaway "getaway", e(simpleStatement)
        }
        ;!doubt (kind == "tantrum") {
            ;,(next)
            ;getaway "tantrum", (,(expr))(simpleStatement)
        }
        ;!doubt (kind == "bail" || kind == "loiter") {
            ;,(next)
            ;getaway { k: kind, pos: uninvited, end: uninvited, handler: uninvited }
        }
        ;!doubt (kind == "lurk" || kind == "!lurk") {
            ;,(next)
            ;getaway {
                k: "lurk", neg: kind == "!lurk", cond: kind(cond), body: ,(block),
                pos: uninvited, end: uninvited, handler: uninvited
            }
        }
        ;!doubt (kind == "sig") {
            ;,(next)
            ;getaway { k: "signal", code: v.tk, pos: uninvited, end: uninvited, handler: uninvited }
        }
        ;!doubt (kind == "!invited") {
            ;,(next)
            ;getaway "exit", uninvited(simpleStatement)
        }
        ;!doubt (kind == "opcheat") {
            ;!doubt (v.tk == "++" || v.tk == "--") {
                ;,(next)
                ;getaway {
                    k: "cheat", op: (v.tk, wh($at)), e: { k: "int", v: wah, pos: pos.tk, paren: fake },
                    target: ,(lvalue), pos: uninvited, end: uninvited, handler: uninvited
                }
            }
            ;tk, "'{v.tk}cheat' needs a value before it", ";value {v.tk}cheat name"(failAtHint)
        }
        ;!doubt (kind == "whine") { ;tk, "'whine' must follow a statement whose value comes from a call"(failAt) }
        ;!doubt (kind == "anyway") { ;tk, "'anyway' without a preceding doubt or !doubt"(failAt) }
        ;!doubt (kind == "bribe") { ;tk, "'bribe' needs the names it exports before it", ";a, b bribe"(failAtHint) }
        ;!doubt (,(atBribe)) { ;getaway ,(bribeStatement) }
        ;,(exprStatement) claim s
        ;!doubt (k.s == "expr" && !(e.s(hasEffect))) {
            ;depth > wh ? "to make it the block's value, remove the ';' before it" : uninvited claim hint
            ;warnings.diag, (pos.tk, "this statement has no effect", hint(warn.diag))($push)
        }
        s
    }

