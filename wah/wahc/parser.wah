            ;!doubt ((parts.v($length)) == wah && (wh[parts.v]($typeOf)) == "purple") { ;getaway v }
            ;tk, "an alibi value cannot be interpolated"(failAt)
        }
        ;!doubt (kind == "float" || kind == "nan" || kind == "inf") {
            ;tk, "floats cannot be alibi values", "float equality makes a poor match; compare with !doubt instead"(failAtHint)
        }
        ;tk, "an alibi value must be a literal or a lineup member",
            "alibi values are integers, purples, real, fake, uninvited or member.Lineup"(failAtHint)
        uninvited
    }

    // A field value is its own nesting level for the call rule: ',' separates
    // fields, so a call captures only its own field's value.
    ;scheme ()fieldValue {
        ;(","(at)) ? (,(zeroCall)) : (,(ternary)) claim fickle cur
        ;lurk (,(atCall)) { ;[cur](call)(continueOps) cheat cur }
        cur
    }

    ;scheme ()chain {
        ;[] claim shifty branches
        ;uninvited claim shifty els
        ;lurk (real) {
            ;,(next) claim kw
            ;t.kw(cond) claim c
            ;!doubt (t.kw == "doubt" && k.c == "bin" && op.c == "!=") {
                ;warnings.diag, (pos.kw, "'doubt (a != b)' is a double negative", "write '!doubt (a == b)'"(warn.diag))($push)
            }
            ;branches, { neg: t.kw == "doubt", cond: c, body: ,(block), pos: pos.kw }($push)
            ;!doubt (("anyway"(accept)) == uninvited) { ;bail }
            ;!doubt (("doubt"(at)) || ("!doubt"(at))) { ;loiter }
            ;,(block) cheat els
            ;bail
        }
        { k: "chain", branches: branches, els: els, pos: pos.wh[branches], paren: fake }
    }

    ;!doubt (inner) {
        ;,(expr) claim e
        ;!doubt (!("eof"(at))) {
            ;,(peek) claim tk
            ;tk, "unexpected {tk(describe)} in interpolation"(failAt)
        }
        ;getaway e
    }
    (,(program))
}

;parse bribe
