                ;,(next) claim comma
                ;!doubt ("}}"(at)) { ;comma, "trailing comma in record literal"(failAt) }
            }
        }
        ;"}}", "expected ',' or '}}' in record literal", uninvited(expect)
        { k: "rec", fields: fields, pos: pos.open, paren: fake }
    }

    // suspect (subject) { alibi v, v { ... } ... anyway { ... } } (§7.5).
    ;scheme ()parseSuspect {
        ;,(next) claim kw
        ;"suspect"(cond) claim subject
        ;"{{", "expected '{{' after the suspect's subject", uninvited(expect)
