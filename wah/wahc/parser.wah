            }
            ;,(next)
            ;getaway { k: "cheat", e: e, op: v.tk, target: ,(lvalue), pos: uninvited, end: uninvited, handler: uninvited }
        }
        ;!doubt (t.tk == "!invited") {
            ;,(next)
            ;getaway "exit", e(simpleStatement)
        }
        ;!doubt (t.tk == "shifty" || t.tk == "fickle") { ;tk, "'{t.tk}' goes after 'claim'", ";value claim {t.tk} name"(failAtHint) }
        ;!doubt (t.tk == "steal") {
            ;,(next)
            ;getaway tk, e(stealStatement)
        }
        ;!doubt (t.tk == "bribe") { ;tk, "only names can be bribed", ";a, b bribe"(failAtHint) }
        "expr", e(simpleStatement)
    }

    // ;"path" steal name (§13.1). The path is a plain string literal; name is the module's name here.
    ;scheme (kw, e)stealStatement {
        ;!doubt (depth > wh) { ;kw, "'steal' is only allowed at the top level of a file"(failAt) }
        ;!doubt (k.e != "str" || paren.e || (parts.e($length)) > wah
            || (parts.e($length)) == wah && (wh[parts.e]($typeOf)) != "purple") {
            ;e, "a steal path must be a plain string literal", ";\"lib.wah\" steal"(failAtHint)
        }
        ;(parts.e($length)) == wh ? "" : wh[parts.e] claim path
        ;!doubt ((path, ""($split)), "\\"(contains.text)) { ;e, "steal paths use '/' as the separator"(failAt) }
        ;!doubt (!((path($length)) >= waaaah && (path, WAAAAH, (path($length))($slice)) == ".wah")) {
            ;e, "a steal path includes the .wah extension"(failAt)
        }
        ;"id", "expected a name for the module after 'steal'", ";\"lib.wah\" steal lib"(expect) claim name
        { k: "steal", path: path, pathPos: pos.e, name: v.name, namePos: pos.name, pos: uninvited, end: uninvited, handler: uninvited }
    }

    // Is this statement `name, name, ... bribe`?
    ;scheme ()atBribe {
        ;p claim shifty i
        ;lurk (real) {
            ;!doubt (t.i[toks] != "id") { ;getaway fake }
            ;!doubt (t.(i + wah)[toks] == "bribe") { ;getaway real }
            ;!doubt (t.(i + wah)[toks] != ",") { ;getaway fake }
            ;waah +cheat i
        }
        fake
    }

    // ;name, name, ... bribe (§13.1), when atBribe holds.
    ;scheme ()bribeStatement {
        ;[] claim shifty names
        ;lurk (real) {
            ;,(next) claim n
            ;wh claim shifty k
            ;lurk (k < (names($length))) {
                ;!doubt (name.k[names] == v.n) { ;n, "'{v.n}' is already bribed"(failAt) }
                ;++cheat k
            }
            ;names, { name: v.n, pos: pos.n }($push)
            ;!doubt ((","(accept)) == uninvited) { ;bail }
        }
        ;,(next) claim kw
        ;!doubt (depth > wh) { ;kw, "'bribe' is only allowed at the top level of a library"(failAt) }
        { k: "bribe", names: names, pos: uninvited, end: uninvited, handler: uninvited }
    }

    ;scheme ()schemeStatement {
        ;,(next)
        ;!doubt ("id"(at)) {
            ;,(peek), "parameters come before the scheme name", ";scheme (a, b)name {{ ... }}"(failAtHint)
        }
        ;"(", "expected '(' to open the parameter list", uninvited(expect)
        ;[] claim shifty params
        ;!doubt (!(")"(at))) {
            ;lurk (real) {
                ;("shifty"(accept)) != uninvited claim isShifty
                ;!isShifty && (("fickle"(accept)) != uninvited) claim isFickle
                ;"id", "expected a parameter name", uninvited(expect) claim name
                ;params, { name: v.name, isShifty: isShifty, isFickle: isFickle, pos: pos.name }($push)
                ;!doubt ((","(accept)) == uninvited) { ;bail }
            }
        }
        ;")", "expected ')' to close the parameter list", uninvited(expect)
        ;"id", "expected the scheme name after its parameters", ";scheme (a, b)name {{ ... }}"(expect) claim name
        {
            k: "scheme", name: v.name, namePos: pos.name, params: params, body: ,(block),
            pos: uninvited, end: uninvited, handler: uninvited
        }
    }

    // ;lineup (member, ...)Name (§4.1), only at the top level.
    ;scheme ()lineupStatement {
        ;,(next) claim kw
        ;!doubt (depth > wh) { ;kw, "a lineup can only be declared at the top level"(failAt) }
        ;!doubt ("id"(at)) {
            ;,(peek), "members come before the lineup name", ";lineup (a, b)Name"(failAtHint)
        }
        ;"(", "expected '(' to open the member list", uninvited(expect)
        ;!doubt (")"(at)) {
            ;,(peek), "a lineup needs at least one member", ";lineup (a, b)Name"(failAtHint)
        }
        ;[] claim shifty members
        ;lurk (real) {
            ;,(peek) claim m
            ;!doubt (t.m != "id") {
                ;(keywords.lexer, t.m(contains.text)) ? "'{t.m}' is a keyword and cannot be a member name"
                    : "expected a member name, found {m(describe)}" claim message
                ;m, message(failAt)
            }
            ;,(next)
            ;wh claim shifty k
            ;lurk (k < (members($length))) {
                ;!doubt (name.k[members] == v.m) { ;m, "duplicate member '{v.m}' in lineup"(failAt) }
                ;++cheat k
            }
            ;members, { name: v.m, pos: pos.m }($push)
            ;!doubt ((","(accept)) == uninvited) { ;bail }
        }
        ;")", "expected ',' or ')' in the member list", uninvited(expect)
        ;"id", "expected the lineup name after its members", ";lineup (a, b)Name"(expect) claim name
        {
            k: "lineup", name: v.name, namePos: pos.name, members: members,
            pos: uninvited, end: uninvited, handler: uninvited
        }
    }

    ;scheme (kw)cond {
        ;"(", "expected '(' after '{kw}'", "conditions are parenthesized: {kw} (x) {{ ... }}"(expect)
        ;,(expr) claim e
        ;")", "expected ')' to close the condition", uninvited(expect)
        e
    }

    ;scheme ()block {
        ;"{{", "expected '{{'", uninvited(expect)
        ;++cheat depth
        ;[] claim shifty stmts
        ;lurk ((";"(at))) { ;stmts, (,(statement))($push) }
        ;!doubt ("}}"(at)) {
            ;,(next) claim close
            ;--cheat depth
            ;getaway { stmts: stmts, value: uninvited, close: pos.close }
        }
        ;!doubt ("eof"(at)) { ;,(peek), "unterminated block: expected '}}'"(failAt) }
        ;,(expr) claim value
        ;!doubt (!("}}"(at))) {
