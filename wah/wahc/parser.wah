        }
        cur
    }

    ;scheme ()zeroCall {
        ;,(next) claim comma
        ;!doubt (!(,(atCall))) {
            ;comma, "a leading ',' must be followed by a call", "zero-argument calls are written ,(f)"(failAtHint)
        }
        ([])(call)(continueOps)
    }

    // Called only when atCall() holds: '(' name ')'.
    ;scheme (fickle args)call {
        ;,(next)
        ;,(next) claim c
        ;!doubt (("."(accept)) != uninvited) {
            ;,(next) claim m
            ;,(next)
