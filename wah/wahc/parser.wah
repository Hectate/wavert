            ;")", uninvited, uninvited(expect)
            ;real cheat paren.e
            ;getaway e
        }
        ;!doubt (kind == "[") {
            ;("]"(at)) ? [] : (real(seq)) claim items
            ;"]", "expected ']' to close the array", uninvited(expect)
            ;getaway { k: "arr", items: items, pos: at0, paren: fake }
        }
        ;!doubt (kind == "sig") {
            ;tk, "{text.tk} is a statement", "write ;WAH! to signal, or ;c(WAH!) to forward a code"(failAtHint)
        }
        ;!doubt (kind == "claim" || kind == "cheat" || kind == "shifty" || kind == "fickle") {
            ;tk, "unexpected '{kind}'", "Γ-- puts the value first: ;value claim name"(failAtHint)
        }
        ;!doubt (kind == "{{") { ;getaway tk(record) }
        ;tk, "expected an expression, found {tk(describe)}"(failAt)
    }

    // Record literal (§10.7); the '{' is already consumed.
    ;scheme (open)record {
        ;[] claim shifty fields
