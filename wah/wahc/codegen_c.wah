        ;lurk (k < (e(branchCount))) {
            ;e, k(branchBody) claim b
            ;"{k > wh ? "}} else " : ""}if ({(e, t, k(branchTest))}) {{"(emit)
            ;++cheat indent
            ;b(resets)
            ;stmts.b(stmts)
            ;"{r} = {b(valueOf)};"(emit)
            ;--cheat indent
            ;++cheat k
        }
        ;"}} else {{"(emit)
        ;++cheat indent
        ;els.e(resets)
        ;stmts.els.e(stmts)
        ;"{r} = {els.e(valueOf)};"(emit)
        ;--cheat indent
        ;"}}"(emit)
        ;"{r};"(emit)
        ;(out, start, (out($length))($slice)), "\n"($join) claim body
        ;lurk ((out($length)) > start) { ;out($pop) }
        ;savedIndent cheat indent
        ;savedLoops cheat loops
        ;savedIife cheat iife
        "({{\n{body}\n{("  ", indent(repeat))}}})"
    }

    // A conditional used as a value: a ternary chain when every branch is just a
    // value, otherwise a statement expression.
    ;scheme (e)chainExpr {
        ;!doubt (e(isPlain)) { ;getaway e, uninvited(ternaryChain) }
        e, uninvited, uninvited(branchValue)
    }

    // suspect (§7.5): the subject is evaluated once into a temporary, then
    // compared with each alibi value by ==.
    ;scheme (t, a)alibiTest {
        ;[] claim shifty tests
