    // The value bound by claim/cheat, applying the copy table (§10.4, §10.9).
    // mode: the column of the copy table, "const", "shifty" or "fickle". A
    // literal is frozen unless bound shifty; fickle keeps any other value as it is.
    ;scheme (e, mode)bindRhs {
        ;mode == "shifty" claim mutable
        ;!doubt (k.e == "arr") { ;getaway c.(e, mutable(array)) }
        ;!doubt (k.e == "rec") { ;getaway c.(e, mutable(record)) }
        ;!doubt ((scalarKinds, k.e(contains.text)) || mode == "fickle") { ;getaway c.(e(expr)) }
        "rt_bind({c.(e(expr))}, {mutable ? wah : wh})"
    }

