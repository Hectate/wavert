// wahc: The C code generator (js/src/codegen_c.js), for --target c. The
// output must match wahc0's byte for byte, so this follows codegen_c.js step
// by step: see there for the design.
//
// Syntax tree records have fixed shapes, so what the analysis finds is kept
// beside them: bindings and functions are numbered (decls, fns), and each
// module's slot array maps a source position to the binding declared or used
// there. Every name, claim, parameter and whine code is its own token, so
// positions tell them apart.

;"text.wah" steal text
;"diag.wah" steal diag

;["+", "-", "*", "/", "%", "**", "==", "!=", "<", ">", "<=", ">=", "&", "|", "^", "<<", ">>"] claim binOps
;["add", "sub", "mul", "div", "mod", "pow", "eq", "ne", "lt", "gt", "le", "ge", "band", "bor", "bxor", "shl", "shr"] claim binFns
// Node kinds whose value can never be an array or record (so binding needs no copy check).
;["int", "float", "str", "bool", "null", "nan", "inf", "bin", "un"] claim scalarKinds
// Node kinds that evaluate without calling anything.
;["int", "float", "bool", "null", "nan", "inf", "name", "std"] claim plainKinds
// Stdlib functions that can signal WAH! (§12.1).
;["readLine", "readFile", "writeFile", "appendFile", "listDir", "deleteFile", "env", "run", "toInt", "toFloat"] claim signalers

// How an expression's evaluation interacts with others (see seq).
;wh claim constK  // a constant: nothing can change it
;wah claim pureK  // reads a binding, so another argument's effects could change it
;waah claim effectK // may have effects or raise a tantrum

;scheme (op)binFn {
    ;wh claim shifty k
    ;lurk (k[binOps] != op) { ;++cheat k }
    k[binFns]
}
// How a claim or parameter binds its values (§10.4): "shifty", "fickle" or "const".
;scheme (x)modeOf { isShifty.x ? "shifty" : isFickle.x ? "fickle" : "const" }

;scheme (op)unFn { op == "-" ? "neg" : op == "!" ? "not" : "bnot" }

;scheme (s, count)repeat {
    ;"" claim shifty out
    ;wh claim shifty k
    ;lurk (k < count) {
        ;out + s cheat out
        ;++cheat k
    }
    out
}

// The UTF-8 length of s.
;scheme (s)utf8Length {
    ;s, ""($split) claim cs
    ;wh claim shifty n
    ;wh claim shifty k
    ;lurk (k < (cs($length))) {
        ;k[cs]($code) claim c
        ;(c < wa[0x80]h ? wah : c < wa[0x800]h ? waah : c < wa[0x10000]h ? waaah : waaaah) +cheat n
        ;++cheat k
    }
    n
}

// A C string literal for s: printable characters as they are (the C file is
// UTF-8), other control characters as three-digit octal escapes.
;scheme (s)cString {
    ;s, ""($split) claim cs
    ;"\"" claim shifty out
    ;wh claim shifty k
    ;lurk (k < (cs($length))) {
        ;k[cs] claim ch
        ;ch($code) claim c
        ;!doubt (ch == "\"") {
            ;out + "\\\"" cheat out
        } anyway !doubt (ch == "\\") {
            ;out + "\\\\" cheat out
        } anyway !doubt (ch == "\n") {
            ;out + "\\n" cheat out
        } anyway !doubt (ch == "\t") {
            ;out + "\\t" cheat out
        } anyway !doubt (ch == "\r") {
            ;out + "\\r" cheat out
        } anyway !doubt (c < wa[32]h || c == wa[127]h) {
            ;out + "\\{(c / wa[64]h($floor))}{(c / wa[8]h($floor)) % wa[8]h}{c % wa[8]h}" cheat out
        } anyway {
            ;out + ch cheat out
        }
        ;++cheat k
    }
    out + "\""
}

// A static wstr initializer: { bytes, code points, ascii, sym, data }.
;scheme (s)wstrInit {
    ;s(utf8Length) claim bytes
    ;s($length) claim cps
    "{{ {bytes}, {cps}, {bytes == cps ? wah : wh}, 0, {s(cString)} }}"
}

// A C array of values: (wv[]){ ... }, or NULL when empty.
;scheme (fickle cs)values { (cs($length)) == wh ? "NULL" : "(wv[]){{ {cs, ", "($join)} }}" }

// modules: checked, in initialization order, the entry file last.
;scheme (modules, runtime)generateC {
    ;wh claim shifty n
    ;wh claim shifty tmps
    ;[] claim shifty strings
    ;[] claim shifty fields
    ;[] claim shifty shapes
    ;[] claim shifty lineupDefs
    ;[] claim shifty globals
    ;[] claim shifty frames
    ;[] claim shifty functions
    ;[] claim shifty out
    ;wah claim shifty indent
    // loops: enclosing loops reachable by bail/loiter; iife: inside a conditional used as a value
    ;wh claim shifty loops
    ;fake claim shifty iife

    // Bindings: { kind, name, fn, cname, isFickle, captured, schemeFn }, where fn
    // is the index of the function that owns it, and schemeFn, for a scheme, its
    // own function. Functions: { name, parent, depth, top, children, cname },
    // where parent is uninvited for a module's top level.
    ;[] claim shifty decls
    ;[] claim shifty fns
    // Per module: its top-level function, and its positions -> binding index.
    ;[] claim shifty tops
    ;[] claim shifty slots

    // The current module: its index and id, its positions, its module names as
    // { name, lib }, its lineup statements, and the current function.
    ;wh claim shifty curMod
    ;"" claim shifty mod
    ;[] claim shifty curSlot
    ;[] claim shifty stolen
    ;[] claim shifty ownLineups
    ;wh claim shifty cur

    // The id of module m: its place in initialization order for a library, "" for the entry file.
    ;scheme (m)modId { m == (modules($length)) - wah ? "" : "{m + wah}" }

    ;scheme (f)hasFrame { !(top.f[fns]) && children.f[fns] > wh }

    // ---- analysis: resolve names, find what nested schemes use ----

    ;scheme (parent)newScope {
        ;[] claim shifty names
        { parent: parent, names: names }
    }
    ;scheme (scope, name, kind, d)put { ;names.scope, { name: name, kind: kind, d: d }($push) }
    // The entry for name in scope or around it, or uninvited.
    ;scheme (fickle scope, name)find {
        ;scope claim fickle s
        ;lurk (s != uninvited) {
            ;names.s claim fickle ns
            ;wh claim shifty k
            ;lurk (k < (ns($length))) {
                ;!doubt (name.k[ns] == name) { ;getaway k[ns] }
                ;++cheat k
            }
            ;parent.s cheat s
        }
        uninvited
    }
    ;scheme (scope, name)kindOf {
        ;scope, name(find) claim entry
        entry == uninvited ? uninvited : kind.entry
    }

    ;scheme (name, parent)newFn {
        ;{
            name: name, parent: parent, depth: parent == uninvited ? wh : depth.parent[fns] + wah,
            top: parent == uninvited, children: wh, cname: ""
        } claim shifty f
        ;fns, f($push)
        (fns($length)) - wah
    }

    // A binding of function f. At a module's top scope, claims and schemes keep
    // their names (other modules use them); everything else is numbered.
    ;scheme (kind, name, f, atTop, mode)bind {
        ;"w{mod}_{name}" claim shifty cname
        ;!doubt (!atTop) {
            ;(kind == "scheme" ? "s" : "v") + "{n}_{name}" cheat cname
            ;++cheat n
        }
        ;{ kind: kind, name: name, fn: f, cname: cname, isFickle: mode == "fickle", captured: fake, schemeFn: uninvited } claim shifty d
        ;decls, d($push)
        ;!doubt (top.f[fns] && kind != "scheme") { ;globals, cname($push) }
        (decls($length)) - wah
    }

    ;scheme (fickle b, scope, f, topScope)ablock {
        ;scope == topScope claim atTop
        ;stmts.b claim list
        ;wh claim shifty k
        ;lurk (k < (list($length))) {
            ;k[list] claim s
            ;!doubt (k.s == "scheme") {
                ;"scheme", name.s, f, atTop, ""(bind) claim d
                ;name.s, f(newFn) claim child
                ;cname.d[decls] cheat cname.child[fns]
                ;child cheat schemeFn.d[decls]
                ;++cheat children.f[fns]
                ;d cheat (namePos.s)[curSlot]
                ;scope, name.s, "scheme", d(put)
            } anyway !doubt (k.s == "lineup") {
                ;scope, name.s, "lineup", uninvited(put)
            } anyway !doubt (k.s == "claim") {
                ;"claim", name.s, f, atTop, (s(modeOf))(bind) claim d
                ;d cheat (namePos.s)[curSlot]
                ;scope, name.s, "claim", d(put)
            }
            ;++cheat k
        }
        ;wh cheat k
        ;lurk (k < (list($length))) {
            ;k[list], scope, f, topScope(astmt)
            ;++cheat k
        }
        ;!doubt (value.b != uninvited) { ;value.b, scope, f(aexpr) }
    }

    ;scheme (fickle s, scope, f, topScope)astmt {
        ;k.s claim kind
        ;!doubt (kind == "scheme") {
            ;(namePos.s)[curSlot] claim d
            ;schemeFn.d[decls] claim child
            ;scope(newScope) claim ps
            ;wh claim shifty k
            ;lurk (k < (params.s($length))) {
                ;k[params.s] claim p
                ;"param", name.p, child, fake, (p(modeOf))(bind) claim pd
                ;pd cheat (pos.p)[curSlot]
                ;ps, name.p, "param", pd(put)
                ;++cheat k
            }
            ;body.s, (ps(newScope)), child, topScope(ablock)
        } anyway !doubt (kind == "lurk") {
            ;cond.s, scope, f(aexpr)
            ;body.s, (scope(newScope)), f, topScope(ablock)
        } anyway !doubt (kind == "getaway" || kind == "tantrum" || kind == "exit" || kind == "claim") {
            ;!doubt (e.s != uninvited) { ;e.s, scope, f(aexpr) }
        } anyway !doubt (kind == "expr") {
            ;!doubt (k.e.s == "sigcall") { ;arg.e.s, scope, f(aexpr) } anyway { ;e.s, scope, f(aexpr) }
        } anyway !doubt (kind == "cheat") {
            ;e.s, scope, f(aexpr)
            ;target.s, scope, f(atarget)
        }
        ;!doubt (handler.s != uninvited) {
            ;handler.s claim h
            ;scope(newScope) claim hs
            ;!doubt (param.h != uninvited) {
                ;"whine", param.h, f, fake, ""(bind) claim wd
                ;wd cheat (paramPos.h)[curSlot]
                ;hs, param.h, "whine", wd(put)
            }
            ;body.h, (hs(newScope)), f, topScope(ablock)
        }
    }

    // A name used in function f: a binding of another function is captured.
    ;scheme (x, scope, f)use {
        ;d.(scope, name.x(find)) claim d
        ;d cheat (pos.x)[curSlot]
        ;!doubt (fn.d[decls] != f) { ;real cheat captured.d[decls] }
    }

    ;scheme (t, scope, f)atarget {
        ;!doubt (k.t == "name") { ;t, scope, f(use) ;getaway }
        ;!doubt (k.t == "idx") { ;index.t, scope, f(aexpr) }
        ;(k.t == "mem" ? rec.t : arr.t), scope, f(aexpr)
    }

    // Is x (the right of '.') a lineup or module name, rather than a value?
    ;scheme (fickle x, scope)notValue {
        ;!doubt (k.x == "mem") { ;getaway k.rec.x == "name" && (scope, name.rec.x(kindOf)) == "module" }
        ;!doubt (k.x != "name") { ;getaway fake }
        ;scope, name.x(kindOf) claim kind
        kind == "lineup" || kind == "module"
    }

    ;scheme (fickle e, scope, f)aexpr {
        ;k.e claim kind
        ;!doubt (kind == "str") {
            ;wh claim shifty k
            ;lurk (k < (parts.e($length))) {
                ;!doubt ((k[parts.e]($typeOf)) != "purple") { ;k[parts.e], scope, f(aexpr) }
                ;++cheat k
            }
        } anyway !doubt (kind == "name") {
            ;e, scope, f(use)
        } anyway !doubt (kind == "arr") {
            ;wh claim shifty k
            ;lurk (k < (items.e($length))) { ;k[items.e], scope, f(aexpr) ;++cheat k }
        } anyway !doubt (kind == "rec") {
            ;wh claim shifty k
            ;lurk (k < (fields.e($length))) { ;e.k[fields.e], scope, f(aexpr) ;++cheat k }
        } anyway !doubt (kind == "idx") {
            ;index.e, scope, f(aexpr)
            ;arr.e, scope, f(aexpr)
        } anyway !doubt (kind == "mem") {
            ;!doubt (!(rec.e, scope(notValue))) { ;rec.e, scope, f(aexpr) }
        } anyway !doubt (kind == "un") {
            ;e.e, scope, f(aexpr)
        } anyway !doubt (kind == "bin") {
            ;l.e, scope, f(aexpr)
            ;r.e, scope, f(aexpr)
        } anyway !doubt (kind == "tern") {
            ;c.e, scope, f(aexpr)
            ;a.e, scope, f(aexpr)
            ;b.e, scope, f(aexpr)
        } anyway !doubt (kind == "call") {
            ;wh claim shifty k
            ;lurk (k < (args.e($length))) { ;k[args.e], scope, f(aexpr) ;++cheat k }
            ;!doubt (k.callee.e == "name") { ;d.(scope, name.callee.e(find)) cheat (pos.callee.e)[curSlot] }
        } anyway !doubt (kind == "chain") {
            ;wh claim shifty k
            ;lurk (k < (branches.e($length))) {
                ;cond.k[branches.e], scope, f(aexpr)
                ;body.k[branches.e], (scope(newScope)), f, uninvited(ablock)
                ;++cheat k
            }
            ;!doubt (els.e != uninvited) { ;els.e, (scope(newScope)), f, uninvited(ablock) }
        } anyway !doubt (kind == "suspect") {
            ;subject.e, scope, f(aexpr)
            ;wh claim shifty k
            ;lurk (k < (alibis.e($length))) {
                ;body.k[alibis.e], (scope(newScope)), f, uninvited(ablock)
                ;++cheat k
            }
            ;!doubt (els.e != uninvited) { ;els.e, (scope(newScope)), f, uninvited(ablock) }
        }
    }

    ;scheme (m)analyze {
        ;m cheat curMod
        ;m(modId) cheat mod
        ;uninvited, uninvited(newFn) claim top
        ;tops, top($push)
        ;[] claim shifty slot
        ;wh claim shifty i
        ;lurk (i <= (chars.m[modules]($length))) {
            ;slot, uninvited($push)
            ;++cheat i
        }
        ;slots, slot($push)
        ;slot cheat curSlot
        ;uninvited(newScope) claim scope
        ;steals.m[modules] claim steals
        ;wh claim shifty k
        ;lurk (k < (steals($length))) {
            ;scope, name.node.k[steals], "module", uninvited(put)
            ;++cheat k
        }
        ;{ stmts: stmts.program.m[modules], value: uninvited }, scope, top, scope(ablock)
    }

    // ---- emission ----

    // Starts module m: name.module means the stolen module's name (§13.1).
    ;scheme (m)enter {
        ;file.m[modules], chars.m[modules](setSource.diag)
        ;m cheat curMod
        ;m(modId) cheat mod
        ;m[slots] cheat curSlot
        ;m[tops] cheat cur
        ;[] cheat stolen
        ;[] cheat ownLineups
        ;stmts.program.m[modules] claim list
        ;wh claim shifty k
        ;lurk (k < (list($length))) {
            ;!doubt (k.k[list] == "lineup") { ;ownLineups, k[list]($push) }
            ;++cheat k
        }
        ;steals.m[modules] claim steals
        ;wh cheat k
        ;lurk (k < (steals($length))) {
            ;stolen, { name: name.node.k[steals], lib: lib.k[steals] }($push)
            ;++cheat k
        }
    }

    ;scheme (line)emit { ;out, ("  ", indent(repeat)) + line($push) }
    ;scheme ()tmp {
        ;"t{tmps}" claim name
        ;++cheat tmps
        name
    }

    ;scheme (s)str {
        ;wh claim shifty k
        ;lurk (k < (strings($length)) && k[strings] != s) { ;++cheat k }
        ;!doubt (k == (strings($length))) { ;strings, s($push) }
        "&S{k}"
    }
    ;scheme (name)fieldRef {
        ;!doubt (!(fields, name(contains.text))) { ;fields, name($push) }
        "&F_{name}"
    }

    // A lineup is a static array of its members (§4.1).
    ;scheme (s, m)lineupDef {
        ;name.s(str) claim nm
        ;[] claim shifty members
        ;wh claim shifty k
        ;lurk (k < (members.s($length))) {
            ;members, "{{ {nm}, {name.k[members.s](str)} }}"($push)
            ;++cheat k
        }
        ;lineupDefs, "static const wmem l{m}_{name.s}[] = {{ {members, ", "($join)} }};"($push)
    }

    // The index of the module that x names, or uninvited. The checker forbids shadowing a module name.
    ;scheme (fickle x)stolenFrom {
        ;!doubt (k.x != "name") { ;getaway uninvited }
        ;wh claim shifty k
        ;lurk (k < (stolen($length))) {
            ;!doubt (name.k[stolen] == name.x) { ;getaway lib.k[stolen] }
            ;++cheat k
        }
        uninvited
    }

    // The lineup statement named name in a list of statements, or uninvited.
    ;scheme (fickle list, name)lineupIn {
        ;wh claim shifty k
        ;lurk (k < (list($length))) {
            ;!doubt (k.k[list] == "lineup" && name.k[list] == name) { ;getaway k[list] }
            ;++cheat k
        }
        uninvited
    }

    // The C name and statement of the lineup x names (Lineup or Lineup.module), as { c, node }, or uninvited.
    ;scheme (fickle x)lineupOf {
        ;!doubt (k.x == "name") {
            ;ownLineups, name.x(lineupIn) claim s
            ;getaway s == uninvited ? uninvited : { c: "l{mod}_{name.x}", node: s }
        }
        ;!doubt (k.x != "mem") { ;getaway uninvited }
        ;rec.x(stolenFrom) claim lib
        ;!doubt (lib == uninvited) { ;getaway uninvited }
        ;exports.lib[modules] claim xs
        ;wh claim shifty k
        ;lurk (k < (xs($length)) && name.k[xs] != field.x) { ;++cheat k }
        ;!doubt (k == (xs($length)) || kind.k[xs] != "lineup") { ;getaway uninvited }
        { c: "l{lib(modId)}_{field.x}", node: (stmts.program.lib[modules], field.x(lineupIn)) }
    }

    // Where binding d lives, seen from the current function.
    ;scheme (d)place {
        ;fn.d[decls] claim owner
        ;!doubt (top.owner[fns]) { ;getaway cname.d[decls] }
        ;!doubt (owner == cur) { ;getaway captured.d[decls] ? "fr.{cname.d[decls]}" : cname.d[decls] }
        "up{("->up", (depth.cur[fns] - depth.owner[fns] - wah)(repeat))}->{cname.d[decls]}"
    }
    // Does reading d need the temporal dead zone check (§5.1)?
    ;scheme (d)tdz { kind.d[decls] == "claim" && fn.d[decls] != cur }
    ;scheme (d)read {
        d(tdz) ? { c: "rt_def({d(place)}, {name.d[decls](quote.text)})", k: effectK } : { c: d(place), k: pureK }
    }

    // Arguments evaluated left to right (codegen_c.js call()), as { pre, cs }:
    // the temporaries to declare first, and the arguments' code. A direct C call
    // is safe when at most one argument has effects and the others are constants.
    ;scheme (args)seq {
        ;wh claim shifty effects
        ;fake claim shifty anyPure
        ;wh claim shifty k
        ;lurk (k < (args($length))) {
            ;!doubt (k.k[args] == effectK) { ;++cheat effects }
            ;!doubt (k.k[args] == pureK) { ;real cheat anyPure }
            ;++cheat k
        }
        ;[] claim shifty cs
        ;!doubt (effects == wh || effects == wah && !anyPure) {
            ;wh cheat k
            ;lurk (k < (args($length))) { ;cs, c.k[args]($push) ;++cheat k }
            ;getaway { pre: "", cs: cs }
        }
        ;[] claim shifty pre
        ;wh cheat k
        ;lurk (k < (args($length))) {
            ;!doubt (k.k[args] == constK) {
                ;cs, c.k[args]($push)
            } anyway {
                ;,(tmp) claim temp
                ;pre, "wv {temp} = {c.k[args]};"($push)
                ;cs, temp($push)
            }
            ;++cheat k
        }
        { pre: (pre, " "($join)), cs: cs }
    }
    ;scheme (sq, inner)wrap { { c: pre.sq == "" ? inner : "({{ {pre.sq} {inner}; }})", k: effectK } }

    ;scheme (list)stmts {
        ;wh claim shifty k
        ;lurk (k < (list($length))) {
            ;k[list](stmt)
            ;++cheat k
        }
    }

    // A block's captured claims start unset each time it runs, as a fresh scope
    // would (temporal dead zone, §5.1).
    ;scheme (fickle b)resets {
        ;wh claim shifty k
        ;lurk (k < (stmts.b($length))) {
            ;k[stmts.b] claim fickle s
            ;!doubt (k.s == "claim") {
                ;(namePos.s)[curSlot] claim d
                ;!doubt (captured.d[decls]) { ;"{d(place)} = RT_UNSET;"(emit) }
            }
            ;++cheat k
        }
    }

    // A block whose value is discarded.
    ;scheme (b)blockBody {
        ;b(resets)
        ;stmts.b(stmts)
        ;!doubt (value.b != uninvited) { ;"(void){c.(value.b(expr))};"(emit) }
    }

    ;scheme (b)valueOf { value.b == uninvited ? "RT_NULL" : c.(value.b(expr)) }

    ;scheme (fickle s)stmt {
        ;!doubt (handler.s != uninvited) { ;s(whineStmt) ;getaway }
        ;k.s claim kind
        ;!doubt (kind == "empty" || kind == "lineup" || kind == "steal" || kind == "bribe") { ;getaway }
        ;!doubt (kind == "scheme") { ;s(schemeDef) ;getaway }
        ;!doubt (kind == "getaway") {
            ;!doubt (iife) { ;pos.s, "'getaway' inside a conditional used as a value is not supported in stage 0"(fail.diag) }
            ;"RT_RET({e.s == uninvited ? "RT_NULL" : c.(e.s(expr))});"(emit)
            ;getaway
        }
        ;!doubt (kind == "tantrum") { ;"rt_tantrum({c.(e.s(expr))});"(emit) ;getaway }
        ;!doubt (kind == "bail" || kind == "loiter") {
            ;!doubt (loops == wh) { ;pos.s, "'{kind}' cannot leave a conditional used as a value in stage 0"(fail.diag) }
            ;(kind == "bail" ? "break;" : "continue;")(emit)
            ;getaway
        }
        ;!doubt (kind == "lurk") {
            ;"while ({neg.s ? "!" : ""}rt_cond({c.(cond.s(expr))})) {{"(emit)
            ;++cheat indent
            ;++cheat loops
            ;body.s(blockBody)
            ;--cheat loops
            ;--cheat indent
            ;"}}"(emit)
            ;getaway
        }
        ;!doubt (kind == "signal") { ;"rt_i({code.s})"(signal) ;getaway }
        ;!doubt (kind == "exit") { ;"rt_exit({e.s == uninvited ? "rt_i(0)" : c.(e.s(expr))});"(emit) ;getaway }
        ;!doubt (kind == "expr") {
            ;!doubt (k.e.s == "chain") { ;e.s(chainStmt) ;getaway }
            ;!doubt (k.e.s == "suspect") { ;e.s(suspectStmt) ;getaway }
            ;!doubt (k.e.s == "sigcall") { ;c.(arg.e.s(expr))(signal) ;getaway }
            ;"(void){c.(e.s(expr))};"(emit)
            ;getaway
        }
        ;!doubt (kind == "claim") { ;(namePos.s)[curSlot], (e.s, (s(modeOf))(bindRhs))(claimDecl) ;getaway }
        ;!doubt (kind == "cheat") { ;s(cheatStmt) ;getaway }
