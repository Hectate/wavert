            ;wh claim shifty k
            ;lurk (k < (args($length))) { ;all, k[args]($push) ;++cheat k }
            ;"{f}({all, ", "($join)})" cheat code
        }
        checked ? "rt_chk({code}, {top.cur[fns] ? "NULL" : (name.cur[fns](quote.text))})" : code
    }

