            ;++cheat indent
            ;els(blockBody)
            ;--cheat indent
        }
        ;"}}"(emit)
    }

    // A suspect used as a value: a statement expression that sets the subject,
    // then a ternary chain when every block is just a value.
    ;scheme (e)suspectExpr {
        ;,(tmp) claim t
