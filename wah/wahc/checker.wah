            } anyway !doubt (kind.d == "claim") {
                ;(rebind ? "declare it with ';... claim fickle {name}' to rebind it, or ';... claim shifty {name}' for a mutable copy"
                    : "declare it with ';... claim shifty {name}'") cheat hint
            }
            ;pos, message, hint(error)
        }
    }

