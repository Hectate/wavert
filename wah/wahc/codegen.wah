// wahc: The code generator (js/src/codegen.js, spec §15 codegen notes).
//
// User names are emitted as w_<name>; stdlib names as $std.<name>; record
// fields as f_<name>; every operator goes through a $rt helper that enforces
// Γ-- typing rules. Library k (in initialization order) uses w<k>_<name>, so
// private names in different modules never collide (§13.1). The output must
// match wahc0's byte for byte.

;"text.wah" steal text
;"diag.wah" steal diag

;["+", "-", "*", "/", "%", "**", "==", "!=", "<", ">", "<=", ">=", "&", "|", "^", "<<", ">>"] claim binOps
;["add", "sub", "mul", "div", "mod", "pow", "eq", "ne", "lt", "gt", "le", "ge", "band", "bor", "bxor", "shl", "shr"] claim binFns
// Node kinds whose value can never be an array (so binding needs no copy check).
;["int", "float", "str", "bool", "null", "nan", "inf", "bin", "un"] claim scalarKinds
// Node kinds that evaluate without calling anything.
;["int", "float", "bool", "null", "nan", "inf", "name", "std"] claim plainKinds

;scheme (op)binFn {
    ;wh claim shifty k
    ;lurk (k[binOps] != op) { ;++cheat k }
    k[binFns]
}
// How a claim or parameter binds its values (§10.4): "shifty", "fickle" or "const".
;scheme (x)modeOf { isShifty.x ? "shifty" : isFickle.x ? "fickle" : "const" }

;scheme (op)unFn { op == "-" ? "neg" : op == "!" ? "not" : "bnot" }
;scheme (b)jsBool { b ? "true" : "false" }

;scheme (s, count)repeat {
    ;"" claim shifty out
    ;wh claim shifty k
    ;lurk (k < count) {
        ;out + s cheat out
        ;++cheat k
    }
    out
}

// A float literal as JS prints it: Γ-- text without the ".0" Γ-- adds (1.0 -> 1, 1.0e+21 -> 1e+21).
;scheme (x)jsFloat {
    ;x($toPurple), ""($split) claim cs
    ;cs($length) claim len
    ;"" claim shifty out
    ;wh claim shifty k
    ;lurk (k < len) {
        ;!doubt (k[cs] == "." && (k + wah)[cs] == "0" && (k + waah == len || (k + waah)[cs] == "e")) {
            ;waah +cheat k
            ;loiter
        }
        ;out + k[cs] cheat out
        ;++cheat k
    }
    out
}

// modules: checked, in initialization order, the entry file last. Libraries
// run first, in that order, then the entry file's body (§13.1).
;scheme (modules, runtime)generate {
    ;[] claim shifty out
    ;wah claim shifty indent
    ;wh claim shifty n
    // loops: enclosing loops reachable by bail/loiter; iife: inside an expression-valued conditional
    ;wh claim shifty loops
    ;fake claim shifty iife

    // The current module's id, its module names as { name, lib } (lib is the
    // stolen module's index), the names of its own lineups, and the positions
    // of its cheat targets that are fickle bindings.
    ;"" claim shifty mod
    ;[] claim shifty stolen
    ;[] claim shifty lineups
    ;[] claim shifty fickles

    // The id of module m: its place in initialization order for a library, "" for the entry file.
    ;scheme (m)modId { m == (modules($length)) - wah ? "" : "{m + wah}" }

    // Starts module m: its own names get its id; name.module, the stolen module's (§13.1).
    ;scheme (m)enter {
        ;file.m[modules], chars.m[modules](setSource.diag)
        ;m(modId) cheat mod
        ;[] cheat stolen
        ;[] cheat lineups
        ;fickleTargets.m[modules] cheat fickles
        ;stmts.program.m[modules] claim list
        ;wh claim shifty k
        ;lurk (k < (list($length))) {
            ;!doubt (k.k[list] == "lineup") { ;lineups, name.k[list]($push) }
            ;++cheat k
        }
        ;steals.m[modules] claim steals
        ;wh cheat k
        ;lurk (k < (steals($length))) {
            ;stolen, { name: name.node.k[steals], lib: lib.k[steals] }($push)
            ;++cheat k
        }
    }

    // The JS name of a user name in the current module.
    ;scheme (name)id { "w{mod}_{name}" }

    // The index of the module that x names, or uninvited. The checker forbids shadowing a module name.
    ;scheme (x)stolenFrom {
        ;!doubt (k.x != "name") { ;getaway uninvited }
        ;wh claim shifty k
        ;lurk (k < (stolen($length))) {
            ;!doubt (name.k[stolen] == name.x) { ;getaway lib.k[stolen] }
            ;++cheat k
        }
        uninvited
    }

    // The kind of what module lib bribes as name.
    ;scheme (lib, name)exportKind {
        ;exports.lib[modules] claim xs
        ;wh claim shifty k
        ;lurk (name.k[xs] != name) { ;++cheat k }
        kind.k[xs]
    }

    // The JS name of the lineup x names (Lineup or Lineup.module), or uninvited.
    ;scheme (x)lineupJs {
        ;!doubt (k.x == "name") { ;getaway (lineups, name.x(contains.text)) ? "l{mod}_{name.x}" : uninvited }
        ;!doubt (k.x != "mem") { ;getaway uninvited }
        ;rec.x(stolenFrom) claim lib
        lib != uninvited && (lib, field.x(exportKind)) == "lineup" ? "l{lib(modId)}_{field.x}" : uninvited
    }

    ;scheme (line)emit { ;out, ("  ", indent(repeat)) + line($push) }
    ;scheme ()tmp {
        ;"\$t{n}" claim name
        ;++cheat n
        name
    }

    ;scheme (list)stmts {
        ;wh claim shifty k
        ;lurk (k < (list($length))) {
            ;k[list](stmt)
            ;++cheat k
        }
    }

    // A block whose value is discarded.
    ;scheme (b)blockBody {
        ;stmts.b(stmts)
        ;!doubt (value.b != uninvited) { ;"{value.b(expr)};"(emit) }
    }

    ;scheme (b)valueOf { value.b == uninvited ? "null" : (value.b(expr)) }

    ;scheme (s)stmt {
        ;!doubt (handler.s != uninvited) { ;s(whineStmt) ;getaway }
        ;k.s claim kind
        ;!doubt (kind == "empty" || kind == "lineup" || kind == "steal" || kind == "bribe") { ;getaway }
        ;!doubt (kind == "scheme") { ;s(schemeDef) ;getaway }
        ;!doubt (kind == "getaway") {
            ;!doubt (iife) { ;pos.s, "'getaway' inside a conditional used as a value is not supported in stage 0"(fail.diag) }
            ;"return {e.s == uninvited ? "null" : (e.s(expr))};"(emit)
            ;getaway
        }
        ;!doubt (kind == "tantrum") { ;"throw \$rt.tantrum({e.s(expr)});"(emit) ;getaway }
        ;!doubt (kind == "bail" || kind == "loiter") {
            ;!doubt (loops == wh) { ;pos.s, "'{kind}' cannot leave a conditional used as a value in stage 0"(fail.diag) }
            ;(kind == "bail" ? "break;" : "continue;")(emit)
            ;getaway
        }
        ;!doubt (kind == "lurk") {
            ;"while ({neg.s ? "!" : ""}\$rt.cond({cond.s(expr)})) {{"(emit)
            ;++cheat indent
            ;++cheat loops
            ;body.s(blockBody)
            ;--cheat loops
            ;--cheat indent
            ;"}}"(emit)
            ;getaway
        }
        ;!doubt (kind == "signal") { ;"throw \$rt.signal({code.s});"(emit) ;getaway }
        ;!doubt (kind == "exit") { ;"\$rt.exit({e.s == uninvited ? "0" : (e.s(expr))});"(emit) ;getaway }
        ;!doubt (kind == "expr") {
            ;!doubt (k.e.s == "chain") { ;e.s(chainStmt) ;getaway }
            ;!doubt (k.e.s == "suspect") { ;e.s(suspectStmt) ;getaway }
            ;!doubt (k.e.s == "sigcall") { ;"throw \$rt.signal({arg.e.s(expr)});"(emit) ;getaway }
            ;"{e.s(expr)};"(emit)
            ;getaway
        }
        ;!doubt (kind == "claim") {
            ;"{isShifty.s || isFickle.s ? "let" : "const"} {name.s(id)} = {(e.s, (s(modeOf))(bindRhs))};"(emit)
            ;getaway
        }
        ;!doubt (kind == "cheat") { ;s(cheatStmt) ;getaway }
        ;tantrum "codegen: unhandled statement {kind}"
    }

    ;scheme (s)schemeDef {
        ;[] claim shifty names
        ;wh claim shifty k
        ;lurk (k < (params.s($length))) {
            ;names, (name.k[params.s](id))($push)
            ;++cheat k
        }
        ;"function {name.s(id)}({names, ", "($join)}) {{"(emit)
        ;++cheat indent
        ;wh cheat k
        ;lurk (k < (params.s($length))) {
            ;k[params.s] claim param
            // A fickle parameter takes the argument as it is (§6.1).
            ;!doubt (!isFickle.param) { ;"{name.param(id)} = \$rt.bind({name.param(id)}, {isShifty.param(jsBool)});"(emit) }
            ;++cheat k
        }
        ;"try {{"(emit)
        ;++cheat indent
        ;loops claim savedLoops
        ;iife claim savedIife
        ;wh cheat loops
        ;fake cheat iife
        ;stmts.body.s(stmts)
        ;"return {body.s(valueOf)};"(emit)
        ;savedLoops cheat loops
        ;savedIife cheat iife
        ;--cheat indent
        ;"}} catch (\$e) {{"(emit)
        ;"  throw \$rt.leave(\$e, {name.s(quote.text)});"(emit)
        ;"}}"(emit)
        ;--cheat indent
        ;"}}"(emit)
    }

    // A lineup is l_<name>, a frozen object whose m_<member> properties are its members.
    ;scheme (s, m)lineupDef {
        ;[] claim shifty names
        ;wh claim shifty k
        ;lurk (k < (members.s($length))) {
            ;names, (name.k[members.s](quote.text))($push)
            ;++cheat k
        }
        ;"const l{m}_{name.s} = \$rt.lineup({name.s(quote.text)}, [{names, ", "($join)}]);"(emit)
    }

    // The value bound by claim/cheat, applying the copy table (§10.4, §10.9).
    // mode: the column of the copy table, "const", "shifty" or "fickle". A
    // literal is frozen unless bound shifty; fickle keeps any other value as it is.
    ;scheme (e, mode)bindRhs {
        ;mode == "shifty" claim mutable
        ;!doubt (k.e == "arr") {
            ;items.e(exprList) claim items
            ;getaway mutable ? "[{items}]" : "\$rt.frozen([{items}])"
        }
        ;!doubt (k.e == "rec") { ;getaway e, mutable(record) }
        ;!doubt ((scalarKinds, k.e(contains.text)) || mode == "fickle") { ;getaway e(expr) }
        "\$rt.bind({e(expr)}, {mutable(jsBool)})"
    }

    ;scheme (s)cheatStmt {
        ;target.s claim t
        ;!doubt (k.t == "name") {
            ;(fickles, pos.t(contains.text)) ? "fickle" : "shifty" claim mode
            ;!doubt (op.s == uninvited) { ;"{name.t(id)} = {(e.s, mode(bindRhs))};"(emit) ;getaway }
            // The value is evaluated before the target is read (source order).
            ;e.s(expr) claim shifty v
            ;!doubt (k.e.s != "int" && k.e.s != "name") {
                ;,(tmp) claim temp
                ;"const {temp} = {v};"(emit)
                ;temp cheat v
            }
            ;"{name.t(id)} = \$rt.{op.s(binFn)}({name.t(id)}, {v});"(emit)
            ;getaway
        }
        ;!doubt (k.t == "mem") {
            ;"{e.s(expr)}, \"f_{field.t}\", {rec.t(expr)}" claim args
            ;!doubt (op.s == uninvited) { ;"\$rt.setMem({args});"(emit) ;getaway }
            ;"\$rt.updMem({args}, \$rt.{op.s(binFn)});"(emit)
            ;getaway
        }
        ;"{e.s(expr)}, {index.t(expr)}, {arr.t(expr)}" claim args
        ;!doubt (op.s == uninvited) { ;"\$rt.setIdx({args});"(emit) ;getaway }
        ;"\$rt.updIdx({args}, \$rt.{op.s(binFn)});"(emit)
    }

    // A null-prototype object with mangled keys; values evaluate in source order.
    ;scheme (e, mutable)record {
        ;"" claim shifty fields
        ;wh claim shifty k
        ;lurk (k < (fields.e($length))) {
            ;k[fields.e] claim field
            ;fields + ", f_{name.field}: {e.field(expr)}" cheat fields
            ;++cheat k
        }
        "\$rt.rec({{ __proto__: null{fields} }}, {mutable(jsBool)})"
    }

    // `whine` catches a signal from the statement's outermost call only, so the
    // call's arguments are evaluated before the try.
    ;scheme (s)whineStmt {
        ;e.s claim call
        ;[] claim shifty args
        ;wh claim shifty k
        ;lurk (k < (args.call($length))) {
            ;k[args.call] claim a
            ;!doubt (plainKinds, k.a(contains.text)) {
                ;args, (a(expr))($push)
            } anyway {
                ;,(tmp) claim temp
                ;"const {temp} = {a(expr)};"(emit)
                ;args, temp($push)
            }
            ;++cheat k
        }
        ;,(tmp) claim r
        ;"\$e{n}" claim ev
        ;++cheat n
        ;"let {r};"(emit)
        ;"try {{"(emit)
        ;"  {r} = {(callee.call, args(callJs))};"(emit)
        ;"}} catch ({ev}) {{"(emit)
        ;++cheat indent
        ;"if (!({ev} instanceof \$rt.Wah)) throw {ev};"(emit)
        ;!doubt (param.handler.s != uninvited) { ;"const {param.handler.s(id)} = {ev}.code;"(emit) }
        ;"{{"(emit)
        ;++cheat indent
        ;stmts.body.handler.s(stmts)
        ;"{r} = {body.handler.s(valueOf)};"(emit)
        ;--cheat indent
        ;"}}"(emit)
        ;--cheat indent
        ;"}}"(emit)
        ;s claim shifty rest
        ;uninvited cheat handler.rest
        ;{ k: "raw", js: r, pos: pos.s, paren: fake } cheat e.rest
        ;rest(stmt)
    }

    ;scheme (e)chainStmt {
        ;wh claim shifty k
        ;lurk (k < (branches.e($length))) {
            ;k[branches.e] claim b
            ;"{k > wh ? "}} else " : ""}if ({b(test)}) {{"(emit)
            ;++cheat indent
            ;body.b(blockBody)
            ;--cheat indent
            ;++cheat k
        }
        ;!doubt (els.e != uninvited) {
            ;"}} else {{"(emit)
            ;++cheat indent
            ;els.e(blockBody)
            ;--cheat indent
        }
        ;"}}"(emit)
    }

    ;scheme (b)test { "{neg.b ? "!" : ""}\$rt.cond({cond.b(expr)})" }

    // Branches used as values, shared by conditional chains and suspects. For a
    // chain, branch i is its i-th branch; for a suspect, its i-th alibi, tested
    // against the temporary t that holds the subject.
    ;scheme (e)branchCount { k.e == "chain" ? (branches.e($length)) : (alibis.e($length)) }
    ;scheme (e, i)branchBody { k.e == "chain" ? body.i[branches.e] : body.i[alibis.e] }
    ;scheme (e, t, i)branchTest { k.e == "chain" ? (i[branches.e](test)) : (t, i[alibis.e](alibiTest)) }

    // Is every block, the anyway included, just a value?
    ;scheme (e)isPlain {
        ;wh claim shifty k
        ;lurk (k <= (e(branchCount))) {
            ;k < (e(branchCount)) ? (e, k(branchBody)) : els.e claim b
            ;wh claim shifty j
            ;lurk (j < (stmts.b($length))) {
                ;!doubt (k.j[stmts.b] != "empty") { ;getaway fake }
                ;++cheat j
            }
            ;++cheat k
        }
        real
    }

    // A ternary chain over the branches, ending in the anyway block's value.
    ;scheme (e, t)ternaryChain {
        ;els.e(valueOf) claim shifty js
        ;(e(branchCount)) - wah claim shifty k
        ;lurk (k >= wh) {
            ;"({(e, t, k(branchTest))} ? {(e, k(branchBody))(valueOf)} : {js})" cheat js
            ;--cheat k
        }
        js
    }

    // The body of an arrow function that runs the first block whose test holds
    // and returns its value. Its lines are emitted into out, then taken back off.
    ;scheme (e, t)branchFunction {
        ;out($length) claim start
        ;indent claim savedIndent
        ;loops claim savedLoops
        ;iife claim savedIife
        ;savedIndent + wah cheat indent
        ;wh cheat loops
        ;real cheat iife
        ;wh claim shifty k
        ;lurk (k < (e(branchCount))) {
            ;e, k(branchBody) claim b
            ;"{k > wh ? "}} else " : ""}if ({(e, t, k(branchTest))}) {{"(emit)
            ;++cheat indent
            ;stmts.b(stmts)
            ;"return {b(valueOf)};"(emit)
            ;--cheat indent
            ;++cheat k
        }
        ;"}} else {{"(emit)
        ;++cheat indent
        ;stmts.els.e(stmts)
        ;"return {els.e(valueOf)};"(emit)
        ;--cheat indent
        ;"}}"(emit)
        ;(out, start, (out($length))($slice)), "\n"($join) claim body
        ;lurk ((out($length)) > start) { ;out($pop) }
        ;savedIndent cheat indent
        ;savedLoops cheat loops
        ;savedIife cheat iife
        body
    }

    // A conditional used as a value: a ternary chain when every branch is just a
    // value, otherwise an immediately-invoked arrow function.
    ;scheme (e)chainExpr {
        ;!doubt (e(isPlain)) { ;getaway e, uninvited(ternaryChain) }
        ;e, uninvited(branchFunction) claim body
        "(() => {{\n{body}\n{("  ", indent(repeat))}}})()"
    }

    // suspect (§7.5): the subject is evaluated once into a temporary, then
    // compared with each alibi value by ==.
    ;scheme (t, a)alibiTest {
        ;[] claim shifty tests
        ;wh claim shifty k
        ;lurk (k < (values.a($length))) {
            ;tests, "\$rt.eq({t}, {k[values.a](expr)})"($push)
            ;++cheat k
        }
        tests, " || "($join)
    }

    // The anyway block, or for an exhaustive lineup suspect (which has none), a
    // block that raises a tantrum for a subject that is not one of the members.
    ;scheme (e, t)suspectElse {
        ;!doubt (els.e != uninvited || k.wh[values.wh[alibis.e]] != "mem") { ;getaway els.e }
        { stmts: [], value: { k: "raw", js: "\$rt.noAlibi({t})", pos: uninvited, paren: fake }, close: uninvited }
    }

    ;scheme (e)suspectStmt {
        ;,(tmp) claim t
        ;"const {t} = {subject.e(expr)};"(emit)
        ;wh claim shifty k
        ;lurk (k < (alibis.e($length))) {
            ;"{k > wh ? "}} else " : ""}if ({(t, k[alibis.e](alibiTest))}) {{"(emit)
            ;++cheat indent
            ;body.k[alibis.e](blockBody)
            ;--cheat indent
            ;++cheat k
        }
        ;e, t(suspectElse) claim els
        ;!doubt (els != uninvited) {
            ;"}} else {{"(emit)
            ;++cheat indent
            ;els(blockBody)
            ;--cheat indent
        }
        ;"}}"(emit)
    }

    // A suspect used as a value: an arrow function taking the subject, whose body
    // is a ternary chain when every block is just a value.
    ;scheme (e)suspectExpr {
        ;,(tmp) claim t
        ;subject.e(expr) claim subject
        ;e claim shifty withElse
        ;e, t(suspectElse) cheat els.withElse
        ;!doubt (withElse(isPlain)) { ;getaway "(({t}) => {(withElse, t(ternaryChain))})({subject})" }
        ;withElse, t(branchFunction) claim body
        "(({t}) => {{\n{body}\n{("  ", indent(repeat))}}})({subject})"
    }

    ;scheme (callee, args)callJs {
        ;k.callee == "std" ? "\$std.{name.callee}"
            : k.callee == "mem" ? "w{(rec.callee(stolenFrom))(modId)}_{field.callee}" : (name.callee(id)) claim fn
        "{fn}({args, ", "($join)})"
    }

    ;scheme (list)exprList {
        ;[] claim shifty js
        ;wh claim shifty k
        ;lurk (k < (list($length))) {
            ;js, (k[list](expr))($push)
            ;++cheat k
        }
        js, ", "($join)
    }

    ;scheme (e)expr {
        ;k.e claim kind
        ;!doubt (kind == "int") { ;getaway v.e < wh ? "({v.e})" : "{v.e}" }
        ;!doubt (kind == "float") { ;getaway "\$rt.f({v.e(jsFloat)})" }
        ;!doubt (kind == "str") {
            ;[] claim shifty parts
            ;wh claim shifty k
            ;lurk (k < (parts.e($length))) {
                ;k[parts.e] claim part
                ;!doubt ((part($typeOf)) == "purple") {
                    ;!doubt (part != "") { ;parts, (part(quote.text))($push) }
                } anyway {
                    ;parts, "\$rt.text({part(expr)})"($push)
                }
                ;++cheat k
            }
            ;!doubt ((parts($length)) == wh) { ;getaway "\"\"" }
            ;!doubt ((parts($length)) == wah) { ;getaway wh[parts] }
            ;getaway "({parts, " + "($join)})"
        }
        ;!doubt (kind == "bool") { ;getaway v.e(jsBool) }
        ;!doubt (kind == "null") { ;getaway "null" }
        ;!doubt (kind == "nan") { ;getaway "\$rt.NOBODY" }
        ;!doubt (kind == "inf") { ;getaway "\$rt.EVERYBODY" }
        ;!doubt (kind == "name") { ;getaway name.e(id) }
        ;!doubt (kind == "std") { ;getaway "\$std.{name.e}" }
        ;!doubt (kind == "arr") { ;getaway "\$rt.frozen([{items.e(exprList)}])" }
        ;!doubt (kind == "rec") { ;getaway e, fake(record) }
        ;!doubt (kind == "idx") { ;getaway "\$rt.idx({index.e(expr)}, {arr.e(expr)})" }
        ;!doubt (kind == "mem") {
            // A lineup member, a claim stolen from a module, or a record field. The
            // checker forbids shadowing lineup and module names, so these are exact.
            ;rec.e(lineupJs) claim lin
            ;!doubt (lin != uninvited) { ;getaway "{lin}.m_{field.e}" }
            ;rec.e(stolenFrom) claim lib
            ;!doubt (lib != uninvited) { ;getaway "w{lib(modId)}_{field.e}" }
            ;getaway "\$rt.get(\"f_{field.e}\", {rec.e(expr)})"
        }
        ;!doubt (kind == "un") { ;getaway "\$rt.{op.e(unFn)}({e.e(expr)})" }
        ;!doubt (kind == "bin") {
            ;!doubt (op.e == "&&" || op.e == "||") {
                ;getaway "(\$rt.bool({l.e(expr)}, \"{op.e}\") {op.e} \$rt.bool({r.e(expr)}, \"{op.e}\"))"
            }
            ;getaway "\$rt.{op.e(binFn)}({l.e(expr)}, {r.e(expr)})"
        }
        ;!doubt (kind == "tern") { ;getaway "(\$rt.cond({c.e(expr)}) ? {a.e(expr)} : {b.e(expr)})" }
        ;!doubt (kind == "call") {
            ;[] claim shifty args
            ;wh claim shifty k
            ;lurk (k < (args.e($length))) {
                ;args, (k[args.e](expr))($push)
                ;++cheat k
            }
            ;getaway callee.e, args(callJs)
        }
        ;!doubt (kind == "chain") { ;getaway e(chainExpr) }
        ;!doubt (kind == "suspect") { ;getaway e(suspectExpr) }
        ;!doubt (kind == "raw") { ;getaway js.e }
        ;tantrum "codegen: unhandled expression {kind}"
    }

    // Lineups are visible throughout their file, so they are all created first (§4.1).
    ;wh claim shifty mi
    ;lurk (mi < (modules($length))) {
        ;stmts.program.mi[modules] claim list
        ;wh claim shifty li
        ;lurk (li < (list($length))) {
            ;!doubt (k.li[list] == "lineup") { ;li[list], (mi(modId))(lineupDef) }
            ;++cheat li
        }
        ;++cheat mi
    }
    ;wh cheat mi
