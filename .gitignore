# Build outputs (build.ps1), and wvc built there
/bin/
/.wvt/
# Native builds of wvc (zig cc -O2 -o wvc/wvc.exe wvc/wvc.c)
/wvc/wvc
/wvc/wvc.exe
/wvc/wvc.pdb
# Programs built from the examples and samples with wvc build, and their C:
# everything there but the sources. On Linux and macOS a program has no
# extension, so the programs cannot be named by one.
/examples/**
!/examples/**/
!/examples/**/*.wvt
/samples/**
!/samples/**/
!/samples/**/*.wvt
!/samples/crates-puzzles/*.txt
