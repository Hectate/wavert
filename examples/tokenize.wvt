// A tokenizer for Wavert, written in Wavert.
//
// It uses the same subset of the language that the compiler is written in
// (records and arrays, no maps).
//
// Usage: wvc build examples/tokenize.wvt, then: tokenize <file.wvt>
// Prints one token per line as "<kind> <text>", then the token count.

;const keywords is ["fn", "return", "const", "var", "ref", "set", "if", "else", "while", "break",
  "continue", "match", "case", "enum", "import", "export", "true", "false", "null", "nan", "inf",
  "exit", "fail", "onfail", "panic"]
;const bangWords is ["if", "while"]
// Operators of three and two characters, longest first. A compound assignment
// such as "+=" is one token.
;const longOps is ["**=", "<<=", ">>=", "**", "==", "!=", "<=", ">=", "&&", "||", "<<", ">>",
  "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^="]

;fn contains(xs, x) {
    ;var k is 0
    ;while (k < xs($length)) {
        ;if (xs[k] == x) { ;return true }
        ;set k += 1
    }
    false
}

;fn isSpace(c) { c == " " || c == "\t" || c == "\n" || c == "\r" }
;fn isDigit(c) { c >= "0" && c <= "9" }
;fn isIdStart(c) { c >= "a" && c <= "z" || c >= "A" && c <= "Z" || c == "_" }
;fn isIdChar(c) { c(isIdStart) || c(isDigit) }

// The character at i, or "" past the end.
;fn charAt(cs, i) { i < cs($length) ? cs[i] : "" }

// Does the text s occur in cs at position i?
;fn lookingAt(cs, i, s) {
    ;const len is s($length)
    ;if (i + len > cs($length)) { ;return false }
    ((cs, i, i + len)($slice), "")($join) == s
}

// Length of the operator or punctuation at i.
;fn opLength(cs, i) {
    ;var k is 0
    ;while (k < longOps($length)) {
        ;if ((cs, i, longOps[k])(lookingAt)) { ;return longOps[k]($length) }
        ;set k += 1
    }
    1
}

