// arrays: array helpers. For maps, see maps.wvt.
//
// ;import arrays from "$lib/arrays.wvt"
// ;(0, 5)(arrays.range)                      // [0, 1, 2, 3, 4]
// ;(["orc", "rat", "orc"], "orc")(arrays.count)   // 2
// ;var pack is ["sword", "rope", "lamp"]
// ;const dropped is (pack, 1)(arrays.removeAt)    // "rope"; pack is ["sword", "lamp"]
// ;[1, ["a", { x: 2 }]](arrays.toString)           // [1, ["a", { x: 2 }]]
//
// Elements compare with $same (§10.5), so arrays and records in an array are
// found by their contents. An index may be negative, counting from the end,
// as in xs[i].

// The index of the first element of xs that is the same as x. Fails if there
// is none.
;export fn indexOf(ref xs, x) {
    ;for (i, y in xs) {
        ;if ((y, x)($same)) { ;return i }
    }
    ;fail
}

// Whether xs has an element that is the same as x.
;export fn contains(ref xs, x) {
    ;const i is (xs, x)(indexOf)
        onfail { -1 }
    i >= 0
}

// The number of elements of xs that are the same as x.
;export fn count(ref xs, x) {
    ;var n is 0
    ;for (y in xs) {
        ;if ((y, x)($same)) { ;set n += 1 }
    }
    n
}

// The ints from a up to b, not including b, in either direction: (0, 3) is
// [0, 1, 2], and (3, 0) is [3, 2, 1]. [] if a and b are equal.
;export fn range(a, b) {
    ;var out is []
    ;if (a < b) {
        ;for (i in a, b) { ;(out, i)($push) }
    } else {
        ;for (i in b + 1, a + 1 reversed) { ;(out, i)($push) }
    }
    out
}

// An array of n elements, each v; [] if n is 0 or less. v is shared by every
// element, so for a mutable array in each, push a new one each time instead.
;export fn filled(n, v) {
    ;var out is []
    ;for (i in 0, n) { ;(out, v)($push) }
    out
}

// A new array of the elements of a, then those of b.
;export fn concat(ref a, ref b) {
    ;var out is []
    ;for (x in a) { ;(out, x)($push) }
    ;for (x in b) { ;(out, x)($push) }
    out
}

// The index i of xs as a position from the start, or -1 if there is no such
// element.
;fn position(ref xs, i) {
    ;const k is i < 0 ? xs($length) + i : i
    k >= 0 && k < xs($length) ? k : -1
}

// Removes element i of xs, a mutable array, and returns it; the elements after
// it move down one. Fails, changing nothing, if there is no element i.
;export fn removeAt(ref xs, i) {
    ;const k is (xs, i)(position)
    ;if (k < 0) { ;fail }
    ;const removed is xs[k]
    ;for (j in k, xs($length) - 1) { ;set xs[j] to xs[j + 1] }
    ;xs($pop)
    removed
}

// Inserts x into xs, a mutable array, so that it becomes element i; the
// elements from i on move up one. i may be xs($length), to add x at the end,
// and -1 puts x before the last element. Fails, changing nothing, if i is
// beyond either end.
;export fn insertAt(ref xs, i, x) {
    ;const n is xs($length)
    ;const k is i < 0 ? n + i : i
    ;if (k < 0 || k > n) { ;fail }
    ;(xs, x)($push)
    ;for (j in k + 1, n + 1 reversed) { ;set xs[j] to xs[j - 1] }
    ;set xs[k] to x
}

// s in double quotes, with backslashes, quotes, newlines and tabs escaped.
;fn quoted(s) {
    ;var parts is ["\""]
    ;for (i in 0, s($length)) {
        ;const c is (s, i)($at)
        ;match (c) {
            case "\\" { ;(parts, "\\\\")($push) }
            case "\"" { ;(parts, "\\\"")($push) }
            case "\n" { ;(parts, "\\n")($push) }
            case "\t" { ;(parts, "\\t")($push) }
            else { ;(parts, c)($push) }
        }
    }
    ;(parts, "\"")($push)
    (parts, "")($join)
}

// The text of v, as for toString. seen holds the arrays, records and maps
// being written, outside v; v being one of them fails.
;fn text(ref v, ref seen) {
    ;const t is v($typeOf)
    ;if (t == "string") { ;return v(quoted) }
    ;!if (t == "array" || t == "record" || t == "map") { ;return v($toString) }
    ;for (outer in seen) {
        ;if (outer == v) { ;fail }
    }
    ;(seen, v)($push)
    ;var parts is []
    ;match (t) {
        case "array" {
            ;for (x in v) {
                ;const item is (x, seen)(text)
                    onfail { ;fail }
                ;(parts, item)($push)
            }
        }
        case "record" {
            ;for (name in v($fields)) {
                ;const field is (v[name], seen)(text)
                    onfail { ;fail }
                ;(parts, "{name}: {field}")($push)
            }
        }
        else {
            ;for (k, x in v) {
                ;const key is (k, seen)(text)
                    onfail { ;fail }
                ;const value is (x, seen)(text)
                    onfail { ;fail }
                ;(parts, "{key}: {value}")($push)
            }
        }
    }
    ;seen($pop)
    ;const inside is (parts, ", ")($join)
    ;if (t == "array") { ;return "[{inside}]" }
    ;if (t == "map") { ;return parts($length) == 0 ? "[:]" : "[{inside}]" }
    parts($length) == 0 ? "{{}}" : "{{ {inside} }}"
}

// The text of xs in the form of a literal, such as
// [1, 2.5, "rope", [true, null], { x: 1 }, ["a": 1]]. Strings are quoted, with
// backslashes, quotes, newlines and tabs escaped; arrays, records and maps
// inside xs are written out the same way; numbers, booleans, null and enum
// members appear as interpolation gives them (§9.3). Fails if xs contains
// itself, at any depth.
;export fn toString(ref xs) {
    ;var seen is []
    ;const out is (xs, seen)(text)
        onfail { ;fail }
    out
}

;end
