// math: integer and number helpers, and sin and cos.
//
// ;import math from "$lib/math.wvt"
// ;(7, 0, 5)(math.clamp)        // 5
// ;(-7, 2)(math.div)            // -4, floored like %
// ;99(math.isqrt)               // 9
//
// Functions that take numbers accept ints and floats unless they say "ints".

// The absolute value of x.
;export fn abs(x) { x < 0 ? -x : x }

// -1, 0 or 1, as x is negative, zero or positive. nan gives 0.
;export fn sign(x) { x < 0 ? -1 : x > 0 ? 1 : 0 }

// The smaller of a and b; a if they are equal.
;export fn min(a, b) { b < a ? b : a }

// The larger of a and b; a if they are equal.
;export fn max(a, b) { b > a ? b : a }

// x limited to the range between a and b, given in either order: (x, 0, 5)
// and (x, 5, 0) both keep x within 0..5.
;export fn clamp(x, a, b) {
    ;const lo is (a, b)(min)
    ;const hi is (a, b)(max)
    x < lo ? lo : x > hi ? hi : x
}

// a divided by b, rounded down: the integer division that matches % (§11.2),
// so a == (a, b)(div) * b + a % b. Ints. Exact for every int, unlike
// (a / b)($floor), whose float division can round. Panics if b is 0.
;export fn div(a, b) {
    ;if (b == 0) { ;panic "math.div: division by zero" }
    // a - a % b is a multiple of b, so this float division is exact.
    ((a - a % b) / b)($trunc)
}

// The integer square root of n: the largest int whose square is at most n.
// n is an int, 0 or more.
;export fn isqrt(n) {
    ;if (n < 0) { ;panic "math.isqrt: {n} is negative" }
    ;if (n < 2) { ;return n }
    // The float square root is close; correct it without squaring, which
    // could overflow near the largest ints.
    ;var r is (n ** 0.5)($floor)
    ;while (r > (n, r)(div)) { ;set r -= 1 }
    ;while (r + 1 <= (n, r + 1)(div)) { ;set r += 1 }
    r
}

// The greatest common divisor of ints a and b, 0 or more; (0, 0) gives 0.
;export fn gcd(a, b) {
    ;var x is a(abs)
    ;var y is b(abs)
    ;while (y != 0) {
        ;const r is x % y
        ;set x to y
        ;set y to r
    }
    x
}

// The least common multiple of ints a and b, 0 or more; 0 if either is 0.
;export fn lcm(a, b) {
    ;if (a == 0 || b == 0) { ;return 0 }
    ((a, (a, b)(gcd))(div) * b)(abs)
}

// The sum of an array of numbers; 0 for an empty array.
;export fn sum(ref xs) {
    ;var total is 0
    ;for (x in xs) { ;set total += x }
    total
}

// The smallest number in an array, the first if several are equal. Fails on
// an empty array.
;export fn minOf(ref xs) {
    ;if (xs($length) == 0) { ;fail }
    ;var best is xs[0]
    ;for (x in xs) {
        ;if (x < best) { ;set best to x }
    }
    best
}

// The largest number in an array, the first if several are equal. Fails on
// an empty array.
;export fn maxOf(ref xs) {
    ;if (xs($length) == 0) { ;fail }
    ;var best is xs[0]
    ;for (x in xs) {
        ;if (x > best) { ;set best to x }
    }
    best
}

// The value a fraction t of the way from a to b: a at 0.0, b at 1.0. t may
// be outside 0..1, which extends the line.
;export fn lerp(a, b, t) { a + (b - a) * t }

// The fraction of the way from a to b that x is: 0.0 at a, 1.0 at b, the
// inverse of lerp. x may be outside a..b, which gives a fraction outside
// 0..1. Fails if a and b are equal.
;export fn inverseLerp(a, b, x) {
    ;if (a == b) { ;fail }
    (x - a) / (b - a)
}

// A smooth step from 0.0 to 1.0 as x goes from a to b: 0.0 at a and before,
// 1.0 at b and after, and the curve 3t² - 2t³ between, which starts and ends
// flat. With a greater than b the step falls instead. If a and b are equal,
// it is a sharp step: 0.0 below a, 1.0 from a on.
;export fn smoothstep(a, b, x) {
    ;if (a == b) { ;return x < a ? 0.0 : 1.0 }
    ;const t is ((x - a) / (b - a), 0.0, 1.0)(clamp)
    t * t * (3.0 - 2.0 * t)
}

// π, the ratio of a circle's circumference to its diameter: half a turn in
// radians.
;export const pi is 3.141592653589793

// τ = 2π, a full turn in radians.
;export const tau is 6.283185307179586

// π/2 in three parts, for taking whole quarter turns off an angle (fdlibm's
// pio2_1, pio2_2 and pio2_3). The first two hold 33 bits each, so k times
// either is exact while k is below 2^20.
;const halfPi1 is 1.57079632673412561417e+00
;const halfPi2 is 6.07710050630396597660e-11
;const halfPi3 is 2.02226624871116645580e-21
;const twoOverPi is 6.36619772367581382433e-01

// The nearest whole number of quarter turns to x radians, as a float, so
// that huge angles cannot overflow an int.
;fn quarterTurns(x) {
    ;const t is x * twoOverPi + 0.5
    t - t % 1.0
}

// x less k quarter turns, with k from quarterTurns: an angle within about
// π/4 of 0.
;fn remainder(x, k) { ((x - k * halfPi1) - k * halfPi2) - k * halfPi3 }

// sin and cos for x within π/4 of 0: fdlibm's polynomials (k_sin.c and
// k_cos.c), good to within an ulp there.
;fn kernelSin(x) {
    ;const z is x * x
    ;const p is 8.33333333332248946124e-03 + z * (z * (2.75573137070700676789e-06 + z * (z * 1.58969099521155010221e-10 - 2.50507602534068634195e-08)) - 1.98412698298579493134e-04)
    x + z * x * (z * p - 1.66666666666666324348e-01)
}
;fn kernelCos(x) {
    ;const z is x * x
    ;const p is z * (4.16666666666666019037e-02 + z * (z * (2.48015872894767294178e-05 + z * (z * (2.08757232129817482790e-09 - z * 1.13596475577881948265e-11) - 2.75573143513906633035e-07)) - 1.38888888888741095749e-03))
    ;const hz is 0.5 * z
    ;const w is 1.0 - hz
    // w is cos to within its rounding; the rest adds back what w lost.
    w + (((1.0 - w) - hz) + z * p)
}

// The sine of x radians, a float from -1.0 to 1.0. Accurate to within a
// couple of ulps for x up to about a million in size; beyond that the error
// grows with x. Not exact where the true value is: pi(sin) is about
// 1.2e-16, not 0. nan and infinities give nan.
;export fn sin(x) {
    ;if (x($isNan) || x == inf || x == -inf) { ;return nan }
    ;const k is x(quarterTurns)
    ;const r is (x, k)(remainder)
    ;const q is k % 4.0
    q == 0.0 ? r(kernelSin) : q == 1.0 ? r(kernelCos) : q == 2.0 ? -r(kernelSin) : -r(kernelCos)
}

// The cosine of x radians, a float from -1.0 to 1.0. Accurate as sin is:
// (pi / 2)(cos) is about 6.1e-17, not 0. nan and infinities give nan.
;export fn cos(x) {
    ;if (x($isNan) || x == inf || x == -inf) { ;return nan }
    ;const k is x(quarterTurns)
    ;const r is (x, k)(remainder)
    ;const q is k % 4.0
    q == 0.0 ? r(kernelCos) : q == 1.0 ? -r(kernelSin) : q == 2.0 ? -r(kernelCos) : r(kernelSin)
}

;end
