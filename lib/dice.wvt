// dice: random helpers on top of $random, and the exact odds of dice rolls.
//
// ;import dice from "$lib/dice.wvt"
// ;var rng is ($time)($newRandom)
// ;(rng, 3, 6)(dice.dice)                      // 3d6: 3 to 18
// ;(rng, "2d6+1")(dice.rollText)               // 3 to 13
// ;(2, 6, 8)(dice.chanceAtLeast)(dice.percent)   // "42%": the chance that 2d6 is 8 or more
//
// The functions that roll take the generator first, as a ref parameter, so
// they advance the caller's generator: hold it in a var binding (§12.8).
// The odds functions roll nothing: they compute the exact chance, which is the
// same on every platform.

;import math from "math.wvt"

// ---- Rolling ----

// A roll of one die with the given number of sides: 1 to sides.
;export fn roll(ref rng, sides) {
    ;if (sides < 1) { ;panic "dice.roll: a die needs 1 or more sides, got {sides}" }
    (rng, sides)($random) + 1
}

// The total of count dice with the given number of sides, such as 3d6.
;export fn dice(ref rng, count, sides) {
    ;if (count < 0) { ;panic "dice.dice: the count of dice is negative, got {count}" }
    ;var total is 0
    ;var i is 0
    ;while (i < count) {
        ;set total += (rng, sides)(roll)
        ;set i += 1
    }
    total
}

// An int from a to b, both included, in either order: (rng, 5, 2) and
// (rng, 2, 5) both give 2 to 5.
;export fn between(ref rng, a, b) {
    ;const lo is (a, b)(math.min)
    lo + (rng, (a, b)(math.max) - lo + 1)($random)
}

// true with the given chance in percent: never at 0, always at 100.
;export fn chance(ref rng, pct) { rng($randomFloat) * 100 < pct }

// A random element of xs. Fails on an empty array.
;export fn pick(ref rng, ref xs) {
    ;if (xs($length) == 0) { ;fail }
    xs[(rng, xs($length))($random)]
}

// A copy of xs in random order, every order equally likely (Fisher-Yates).
;export fn shuffled(ref rng, xs) {
    ;var out is xs
    ;var i is out($length) - 1
    ;while (i > 0) {
        ;const j is (rng, i + 1)($random)
        ;const t is out[i]
        ;set out[i] to out[j]
        ;set out[j] to t
        ;set i -= 1
    }
    out
}

// An index of weights, each chosen in proportion to its weight: for weights
// [3, 1], 0 three times as often as 1. Weights are 0 or more, ints or floats;
// with only ints the choice is exact. Panics if they add up to 0.
;export fn weighted(ref rng, ref weights) {
    ;var total is 0
    ;var i is 0
    ;while (i < weights($length)) {
        ;if (weights[i] < 0) { ;panic "dice.weighted: weight {i} is negative, got {weights[i]}" }
        ;set total += weights[i]
        ;set i += 1
    }
    ;if (total <= 0) { ;panic "dice.weighted: the weights add up to {total}" }
    ;var r is total($typeOf) == "int" ? (rng, total)($random) : rng($randomFloat) * total
    ;set i to 0
    // The last index with a weight above 0 catches a float r that rounding
    // pushed to total.
    ;var last is 0
    ;while (i < weights($length)) {
        ;if (weights[i] > 0) {
            ;if (r < weights[i]) { ;return i }
            ;set r -= weights[i]
            ;set last to i
        }
        ;set i += 1
    }
    last
}

// Dice notation such as "3d6", "d20", "2d6+1", "1d8-1" or "4" (a fixed
// amount), as { count, sides, bonus }. Spaces are ignored, and D is d. Fails on
// anything else.
;fn parse(text) {
    ;const s is ((((text, " ")($split), "")($join), "D")($split), "d")($join)
    ;const halves is (s, "d")($split)
    ;if (halves($length) == 1) {
        ;const n is s($toInt)
            onfail { ;fail }
        ;return { count: 0, sides: 1, bonus: n }
    }
    ;if (halves($length) != 2) { ;fail }
    ;var count is 1
    ;if (halves[0] != "") {
        ;set count to halves[0]($toInt)
            onfail { ;fail }
    }
    ;var rest is (halves[1], "+")($split)
    ;var sign is 1
    ;if (rest($length) == 1) {
        ;set rest to (halves[1], "-")($split)
        ;set sign to -1
    }
    ;if (rest($length) > 2) { ;fail }
    ;const sides is rest[0]($toInt)
        onfail { ;fail }
    ;var bonus is 0
    ;if (rest($length) == 2) {
        ;set bonus to rest[1]($toInt)
            onfail { ;fail }
    }
    ;if (count < 0 || sides < 1 || bonus < 0) { ;fail }
    { count: count, sides: sides, bonus: sign * bonus }
}

// A roll of dice notation such as "2d6+1" (see parse). Fails on bad notation.
;export fn rollText(ref rng, text) {
    ;const d is text(parse)
        onfail { ;fail }
    (rng, d.count, d.sides)(dice) + d.bonus
}

// A roll of count dice compared with target: { total, success }, where success
// is whether total is target or more.
;export fn check(ref rng, count, sides, target) {
    ;const total is (rng, count, sides)(dice)
    { total: total, success: total >= target }
}

// ---- Odds ----

// The chance of each total of count dice with the given number of sides, as
// an array of floats indexed by the total: index 7 of (2, 6)(odds) is the
// chance that 2d6 is 7. Totals below count have a chance of 0.0.
;export fn odds(count, sides) {
    ;if (count < 0 || sides < 1) { ;panic "dice.odds: cannot roll {count}d{sides}" }
    // One die at a time: each total so far spreads evenly over the next die's faces.
    ;var dist is [1.0]
    ;var n is 0
    ;while (n < count) {
        ;var next is []
        ;var t is 0
        ;while (t < dist($length) + sides) {
            ;(next, 0.0)($push)
            ;set t += 1
        }
        ;set t to 0
        ;while (t < dist($length)) {
            ;const share is dist[t] / sides
            ;var face is 1
            ;while (face <= sides) {
                ;set next[t + face] += share
                ;set face += 1
            }
            ;set t += 1
        }
        ;set dist to next
        ;set n += 1
    }
    dist
}

// The chance that count dice with the given number of sides total target or
// more, from 0.0 to 1.0. It is exactly 1.0 when every roll succeeds and 0.0
// when none does, so percent shows those as 100% and 0%.
;export fn chanceAtLeast(count, sides, target) {
    ;if (target <= count) { ;return 1.0 }
    ;if (target > count * sides) { ;return 0.0 }
    ;const dist is (count, sides)(odds)
    // Summed from the smallest chances up, to lose the least to rounding.
    ;var p is 0.0
    ;var t is dist($length) - 1
    ;while (t >= target) {
        ;set p += dist[t]
        ;set t -= 1
    }
    p
}

// chanceAtLeast for dice notation such as "2d6+1" (see parse). Fails on bad
// notation.
;export fn chanceText(text, target) {
    ;const d is text(parse)
        onfail { ;fail }
    (d.count, d.sides, target - d.bonus)(chanceAtLeast)
}

// A chance from 0.0 to 1.0 as text for players: "42%". It shows "0%" and
// "100%" only for chances that are exactly 0 and 1; a chance that rounds to
// one of those shows as "<1%" or ">99%" instead.
;export fn percent(p) {
    ;if (p <= 0) { ;return "0%" }
    ;if (p >= 1) { ;return "100%" }
    ;const r is (p * 100)($round)
    ;if (r < 1) { ;return "<1%" }
    ;if (r > 99) { ;return ">99%" }
    "{r}%"
}

;end
